{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "app",
  "name": "Gardenio Assistant",
  "id": "gardenio-assistant-app",
  "backend": true,
  "executable": "gpx_gardenio_assistant_app",
  "info": {
    "keywords": ["app", "gardenio", "llm", "assistant", "chat", "observability"],
    "description": "Gardenio-branded chat assistant for Grafana. Streams answers from the in-cluster LiteLLM/Bedrock backend via the Grafana LLM app and grounds them in gardenio dashboards and observability data through curated mcp-grafana tools — read-only by default, with an opt-in config (enableDashboardWrites, default off) that unlocks a bounded dashboard + folder create/update surface and nothing else. All LLM and MCP traffic stays in-cluster — zero off-cluster egress.",
    "author": {
      "name": "Gardenio"
    },
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "screenshots": [],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "includes": [
    {
      "type": "page",
      "name": "Chat",
      "path": "/a/%PLUGIN_ID%/chat",
      "addToNav": true,
      "defaultNav": true
    },
    {
      "type": "page",
      "icon": "cog",
      "name": "Configuration",
      "path": "/plugins/%PLUGIN_ID%",
      "role": "Admin",
      "addToNav": true
    }
  ],
  "dependencies": {
    "grafanaDependency": ">=11.4.0",
    "plugins": [
      {
        "id": "grafana-llm-app",
        "name": "Grafana LLM",
        "type": "app",
        "version": ">=0.22.0"
      }
    ]
  },
  "iam": {
    "permissions": [
      { "action": "datasources:read", "scope": "datasources:*" },
      { "action": "datasources:query", "scope": "datasources:*" },
      { "action": "dashboards:read", "scope": "dashboards:uid:*" },
      { "action": "dashboards:create", "scope": "folders:uid:*" },
      { "action": "folders:read", "scope": "folders:*" },
      { "action": "folders:create", "scope": "folders:uid:*" }
    ]
  }
}
