{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "networkPolicies": {
      "type": "object",
      "properties": {
        "traefik": {
          "type": "object",
          "description": "Traefik ingress controller selectors. namespaceSelector and podSelector must be set together — setting only one silently drops the entire ingress-from-traefik clause in network policies (audit finding F9, ka-0000007870).",
          "properties": {
            "namespaceSelector": {
              "type": "object"
            },
            "podSelector": {
              "type": "object"
            }
          },
          "allOf": [
            {
              "if": {
                "required": ["namespaceSelector"],
                "properties": {
                  "namespaceSelector": {
                    "minProperties": 1
                  }
                }
              },
              "then": {
                "required": ["podSelector"],
                "properties": {
                  "podSelector": {
                    "minProperties": 1
                  }
                }
              }
            },
            {
              "if": {
                "required": ["podSelector"],
                "properties": {
                  "podSelector": {
                    "minProperties": 1
                  }
                }
              },
              "then": {
                "required": ["namespaceSelector"],
                "properties": {
                  "namespaceSelector": {
                    "minProperties": 1
                  }
                }
              }
            }
          ]
        }
      }
    },
    "releases": {
      "type": "object",
      "properties": {
        "box": {
          "type": "object",
          "description": "A gardenio-in-a-box reporting its release to the home daemon on target box-<name> (plan gd-UZKZ9H25UD step 4d). Off while name is empty.",
          "properties": {
            "name": {
              "type": "string",
              "description": "This box's name: a DNS label, so box-<name> and gardenio-box-<name> are valid target and client names.",
              "pattern": "^([a-z0-9]([a-z0-9-]{0,48}[a-z0-9])?)?$"
            },
            "homeAddr": {
              "type": "string"
            },
            "homeProject": {
              "type": "string"
            },
            "homeTokenURL": {
              "type": "string"
            },
            "homeClientID": {
              "type": "string"
            },
            "homeClientSecret": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                }
              }
            },
            "homeCA": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
