            "uid": "victoriametrics"
          },
          "expr": "sum(increase((max by (account, env) (gardenio_account_cost_usd{account!~\"(?i:e2e-.*|probe-acct-.*)\", account=~\"$account\"}))[1d:5m])) / 24",
