    {
      "type": "state-timeline",
      "title": "Throttle state per account (1=rate-limited)",
      "description": "Per-account throttle timeline. Green=allowed, red=THROTTLED (provider 429). This is the primary incident signal: a red band means agents on that account were being rejected. Read it together with the utilization timeseries to its right \u2014 a throttle usually follows the 5h line approaching 1.0.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "no gardenio_account_throttled series for $account in this range \u2014 the probe published nothing, so throttle state is UNKNOWN, not \u201callowed\u201d. Widen the range or clear the $account filter first; if still empty the probe is dark (see \u201c#12 Probe-loop dead-man \u2014 seconds since last tick\u201d on Control-plane Liveness).",
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85,
            "spanNulls": false,
            "insertNulls": false
          },
          "color": {
            "mode": "fixed"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "allowed",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "THROTTLED",
                  "color": "red",
                  "index": 1
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
