FROM public.ecr.aws/lambda/microvms:al2023-minimal@sha256:05cb9b38d841e7ff1b693dc9e894909612f340bf99ec97d426e8000a5bbe96c3

ARG ZITI_VERSION=2.0.0
ARG ZITI_ARM64_SHA256=810cb1207092f93992aa0d09327e87ec40f623a8e16da5582562aba66c0d17fb

RUN dnf install -y \
      awscli-2 \
      bash \
      ca-certificates \
      curl-minimal \
      findutils \
      git \
      grep \
      gzip \
      hostname \
      jq \
      openssh-clients \
      procps-ng \
      python3 \
      sed \
      shadow-utils \
      tar \
      util-linux \
      xz \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# Generated by bin/build-gardenio-microvm-artifacts.sh from a pinned Gardenio
# commit. This includes static linux/arm64 gb and kd binaries, an AL2023-built
# linux/arm64 Coop binary, hooks, and the exact Gardenio runtime version pins.
COPY artifacts/rootfs/ /
COPY artifacts/manifest.json /opt/gardenio/artifact-manifest.json

# Install the same pinned ARM64 Node.js and Claude Code versions as the exact
# Gardenio commit used to build the generated artifacts.
RUN . /opt/gardenio/build/versions.env \
    && . /opt/gardenio/build/checksums.env \
    && curl -fsSL \
      "https://nodejs.org/dist/v${NODE_FULL_VERSION}/node-v${NODE_FULL_VERSION}-linux-arm64.tar.xz" \
      -o /tmp/node.tar.xz \
    && printf '%s  %s\n' "${NODE_SHA256_ARM64}" /tmp/node.tar.xz | sha256sum -c - \
    && tar -xJf /tmp/node.tar.xz --strip-components=1 -C /usr/local \
    && npm install -g --offline \
      /opt/gardenio/build/claude-code-linux-arm64.tgz \
      /opt/gardenio/build/claude-code.tgz \
    && npm cache clean --force \
    && rm -f /tmp/node.tar.xz

RUN curl -fsSL \
      "https://github.com/openziti/ziti/releases/download/v${ZITI_VERSION}/ziti-linux-arm64-${ZITI_VERSION}.tar.gz" \
      -o /tmp/ziti.tar.gz \
    && printf '%s  %s\n' "${ZITI_ARM64_SHA256}" /tmp/ziti.tar.gz | sha256sum -c - \
    && mkdir -p /opt/openziti/bin \
    && tar -xzf /tmp/ziti.tar.gz -C /opt/openziti/bin \
    && chmod 0755 /opt/openziti/bin/ziti \
    && rm -f /tmp/ziti.tar.gz

COPY update-ca-certificates /usr/local/bin/update-ca-certificates
COPY entrypoint.py /opt/ziti-microvm/entrypoint.py

RUN groupadd --gid 1000 agent \
    && useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash agent \
    && mkdir -p \
      /home/agent/.claude \
      /home/agent/.runtime-secrets \
      /home/agent/.ssh \
      /home/agent/bot \
      /home/agent/workspace/.state/claude \
      /home/agent/workspace/.state/coop \
    && chmod 0755 \
      /opt/ziti-microvm/entrypoint.py \
      /usr/local/bin/update-ca-certificates \
    && chmod 0700 /home/agent/.runtime-secrets /home/agent/.ssh \
    && chown -R 1000:1000 /home/agent

ENV HOME=/home/agent \
    PATH=/usr/local/bin:/usr/bin:/bin \
    DISABLE_AUTOUPDATER=1 \
    BOAT_WORKSPACE=/home/agent/workspace \
    COOP_HOST=127.0.0.1 \
    COOP_PORT=8181 \
    COOP_HEALTH_PORT=9090 \
    COOP_METRICS_PORT=9093 \
    ZITI_MODE=proxy \
    ZITI_PROXY_SERVICES=gardenio-prod-beads:18080,gardenio-prod-coopmux:19800,gardenio-prod-nats:14222,gardenio-prod-litellm:14000,gardenio-prod-slackbridge:18090,gardenio-prod-beads-viewer:18095

EXPOSE 8080 8181 9090 9093

USER 1000:1000
WORKDIR /home/agent/workspace

ENTRYPOINT ["python3", "/opt/ziti-microvm/entrypoint.py"]
