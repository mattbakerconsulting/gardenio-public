# Single source of truth for the pinned, checksummed VictoriaLogs datasource
# plugin artifact — the Grafana datasource the Phase-2 EKS-API forensic dashboard
# (ka-0000007948) queries. Plan: IDP intrusion detection ka-0000003550; Phase-2
# epic ka-0000007666 (siblings: vlsingle store ka-0000007261, LogsQL detections
# ka-0000006485).
#
# gardenio/images/grafana-vl-datasource-plugin/Dockerfile `source`s THIS file, so
# the version + checksum are pinned in EXACTLY one place. Bump here to move the pin.
#
# WHY A PRE-BAKED IMAGE (not grafana.plugins.install / GF_INSTALL_PLUGINS): the
# boot-time catalog install fetches the plugin zip from grafana.com at :443, which
# REQUIRES grafana.plugins.allowCatalogEgress:true -> a 0.0.0.0/0:443+:80 allow on
# the grafana-egress NetworkPolicy. PROD runs with allowCatalogEgress:FALSE under
# default-deny-egress, so opening that hole to add a *datasource* plugin would
# defeat the zero-off-cluster-egress NETWORK guarantee the Grafana pod is held to
# (ka-0000007541). Seeding this pinned dist via a copy-only initContainer
# (mirroring the grafana-llm-app-plugin + grafana-assistant-plugin seams) keeps
# allowCatalogEgress:FALSE — the plugin reaches disk with ZERO network access, and
# the seeded on-disk copy is discovered as a normal on-disk plugin at boot.
#
# The datasource ONLY needs to reach the IN-CLUSTER VictoriaLogs (vlsingle)
# Service on :9428 to answer queries — no off-cluster egress at all — so a
# pre-baked seed is strictly the right delivery mechanism here.

# Pinned plugin version.
VL_DATASOURCE_VERSION=0.30.1

# Architecture of the artifact we seed. Our Grafana pod runs amd64 (prod overlay
# nodeSelector kubernetes.io/arch: amd64) and the CI crane-append is
# --platform linux/amd64. The grafana.com package for this plugin is the "any"
# (universal) package — a single zip carrying every backend-binary arch — so OS
# and ARCH are recorded here for documentation but the download URL is not
# arch-qualified (there is only one artifact to fetch + verify).
VL_DATASOURCE_OS=linux
VL_DATASOURCE_ARCH=amd64

# SHA-256 of the grafana.com plugin zip at the pinned version. VERIFIED
# 2026-08-02 against grafana.com's published packages checksum
# (api/plugins/victoriametrics-logs-datasource/versions/0.30.1 -> packages.any.sha256)
# AND by downloading the artifact and hashing it. The build FAILS LOUDLY if the
# downloaded zip does not match, so a tampered/rotated upstream artifact can never
# be baked in silently.
VL_DATASOURCE_SHA256=d5da774cd57e5f21688f3cda3eb5aac159353a32c4edbd8bee3af013e27cb991

# Download URL (grafana.com catalog API, pinned to version). The "any" package is
# a single universal zip, so the URL is not os/arch-qualified. Used at BUILD time
# only (where the image builder has network) — never at runtime.
VL_DATASOURCE_URL="https://grafana.com/api/plugins/victoriametrics-logs-datasource/versions/0.30.1/download"

# The plugin id == the on-disk plugins subdir name. victoriametrics-logs-datasource
# is a COMMERCIAL-signed plugin (the zip carries a signed MANIFEST.txt,
# signatureType: commercial, signedByOrg: victoriametrics) with NO rootUrls
# restriction, so a pre-baked on-disk copy validates as SIGNED and loads with NO
# GF_PLUGINS_ALLOW_LOADING_UNSIGNED_PLUGINS entry — same locked-down posture as
# the Grafana-root-signed grafana-llm-app seed.
VL_DATASOURCE_PLUGIN_ID=victoriametrics-logs-datasource
