# Single source of truth for the pinned, checksummed grafana-llm-app plugin
# artifact (C6/prod prereq ka-0000007541, epic ka-0000002011 — Path C chat box).
#
# gardenio/images/grafana-llm-app-plugin/Dockerfile `source`s THIS file, so the
# version + checksum are pinned in EXACTLY one place. Bump here to move the pin.
#
# WHY A PRE-BAKED IMAGE: grafana-llm-app proxies ALL chat LLM completions + the
# embedded mcp-grafana, and runs INSIDE the Grafana pod. The boot-time catalog
# install (GF_INSTALL_PLUGINS) fetches it from grafana.com at :443, which
# REQUIRES grafana.plugins.allowCatalogEgress:true -> a 0.0.0.0/0:443+:80 allow
# on the grafana-egress NetworkPolicy. With that hole open, nothing at the
# NETWORK layer stops the in-pod plugin from POSTing completions off-cluster —
# the in-cluster-only property would rest solely on the provisioned openaiURL
# (config). Seeding this pinned dist via a copy-only initContainer (mirroring the
# C4 grafana-assistant-plugin seam) lets PROD run with allowCatalogEgress:FALSE
# under default-deny-egress, making "zero off-cluster egress" a NETWORK guarantee
# rather than a config-only promise.
#
# The version MUST match grafana.plugins.install ("grafana-llm-app 1.0.8") and
# the overlays' pin — the C7 toolset allow-list's explicit-deny completeness
# depends on a FIXED upstream family enum (ka-0000007430).

# Pinned plugin version (matches grafana.plugins.install in the overlays).
GRAFANA_LLM_APP_VERSION=1.0.8

# Architecture of the artifact we seed. Our Grafana pod runs amd64 (prod overlay
# nodeSelector kubernetes.io/arch: amd64) and the CI crane-append is
# --platform linux/amd64, so we pin the linux/amd64 build.
GRAFANA_LLM_APP_OS=linux
GRAFANA_LLM_APP_ARCH=amd64

# SHA-256 of the grafana.com plugin zip for ${OS}/${ARCH} at the pinned version.
# VERIFIED 2026-06-28 against grafana.com's published packages checksum
# (api/plugins/grafana-llm-app/versions/1.0.8) AND by downloading the artifact
# and hashing it. The build FAILS LOUDLY if the downloaded zip does not match,
# so a tampered/rotated upstream artifact can never be baked in silently.
GRAFANA_LLM_APP_SHA256=37c684b100998c5832a2f8c11d085b40f5abbc7bcba038dacc9dc3c06f446791

# Download URL (grafana.com catalog API, pinned to version + os + arch). Used at
# BUILD time only (where the image builder has network) — never at runtime.
# QUOTED: the query string contains '&', which an unquoted `source` of this file
# would treat as a background-job operator and split the assignment.
GRAFANA_LLM_APP_URL="https://grafana.com/api/plugins/grafana-llm-app/versions/1.0.8/download?os=linux&arch=amd64"

# The plugin id == the on-disk plugins subdir name. grafana-llm-app is a
# Grafana-ROOT-SIGNED plugin (the zip carries a signed MANIFEST.txt,
# signatureType: grafana), so a pre-baked on-disk copy validates as SIGNED and
# loads with NO GF_PLUGINS_ALLOW_LOADING_UNSIGNED_PLUGINS entry — strictly more
# locked-down than the C4 custom (unsigned) plugin.
GRAFANA_LLM_APP_PLUGIN_ID=grafana-llm-app
