# versions.env — canonical version and package definitions for gardenio agent image.
#
# This file is the SINGLE SOURCE OF TRUTH for all tool versions and package
# lists in the agent image. The agent Dockerfile sources it (and the CI
# workflows source it for some tool pins, e.g. quench).
#
# To add a tool: add it here, then add install logic to the appropriate script
# (clis.sh, go-tools.sh, etc.).
#
# To update a version: change it here and update the matching sha256 in
# checksums.env. See docs/agent-install-checksums.md for the full
# checksum-refresh procedure.

# ── Runtimes ────────────────────────────────────────────────────────
# NODE_MAJOR / GO_VERSION are retained for logging and consistency, but the
# full pinned versions below are authoritative — install scripts must not
# resolve "latest" at build time (supply-chain hardening, ka-0000002782).
export NODE_MAJOR=24
export NODE_FULL_VERSION=24.15.0
export GO_VERSION=1.25
export GO_FULL_VERSION=1.25.14
export PYTHON_VERSION=3.12

# ── Tool versions ──────────────────────────────────────────────────
export DOCKER_VERSION=27.5.1
export DOCKER_COMPOSE_VERSION=2.35.1
export TERRAFORM_VERSION=1.11.3
export TERRAGRUNT_VERSION=0.77.11

# ── Previously resolved at build time; now pinned ────────────────────
# These versions used to be fetched dynamically from upstream "latest"
# endpoints, which breaks reproducibility and exposes builds to whatever
# version stable.txt / the GitHub latest tag happens to advertise at the
# moment. All lookups were replaced with explicit versions pinned here.
export KUBECTL_VERSION=1.35.4
export GH_VERSION=2.90.0
export GLAB_VERSION=1.92.1
export YQ_VERSION=4.53.2
export ACTIONLINT_VERSION=1.7.12
export HADOLINT_VERSION=2.14.0
export HELM_VERSION=3.20.2
export AWSCLI_VERSION=2.34.33
export UV_VERSION=0.11.7
export BUN_VERSION=1.3.13
export QUENCH_VERSION=0.4.3
# rustup-init release (archived, immutable per-release binary — see
# checksums.env RUSTUP_INIT_SHA256_* and ka-0000004123).
export RUSTUP_VERSION=1.29.1

# ── Helm plugins (pinned to release tags — installed via
#    `helm plugin install --version`) ────────────────────────────────
export HELM_UNITTEST_VERSION=1.0.3
export HELM_PUSH_VERSION=0.11.1

# ── Terraform provider versions (pre-cached in agent image) ───────
# These match the providers used by site-deployment's terraform stack.
# Update when site-deployment's .terraform.lock.hcl or module providers change.
export TF_PROVIDER_AWS_VERSION=5.81.0
export TF_PROVIDER_LOCAL_VERSION=2.5.1
export TF_PROVIDER_KEYCLOAK_VERSION=4.3.1
export TF_PROVIDER_RANDOM_VERSION=3.6.3
export TF_PROVIDER_ARCHIVE_VERSION=2.7.0
export TF_PROVIDER_EXTERNAL_VERSION=2.3.4
export TF_PROVIDER_POSTGRESQL_VERSION=1.22.0
export GOLANGCI_LINT_VERSION=2.13.2
# Standalone Go linters/formatters that plan steps run by name (gd-hZl1cKiELM).
# Both are `go install`ed by go-tools.sh with the image's own Go, so each pin
# must be the newest release whose go.mod `go` line is <= GO_FULL_VERSION:
# gofumpt v0.12.0 and staticcheck v0.8.x (2026.2) need go 1.26. STATICCHECK_VERSION
# is the honnef.co/go/tools module version; v0.7.0 is release 2026.1.
export GOFUMPT_VERSION=0.11.0
export STATICCHECK_VERSION=0.7.0
# promtool, for `make test-helm` (the chart tests shell out to it). The same pin
# checks.yml's helm job installs; that job sources this file. Bump with
# PROMETHEUS_SHA256_* in checksums.env.
export PROMTOOL_VERSION=2.55.1
export STERN_VERSION=1.30.0
# tracks npm stable (check-claude-code-currency.sh guards drift against the
# `stable` dist-tag; bump this whenever that guard reports behind).
export CLAUDE_CODE_VERSION=2.1.287
export CLAUDELESS_VERSION=v0.4.0
# OpenAI Codex CLI — the second agent harness (plan gd-8s8FdZu8UA). Release
# tags are `rust-v${CODEX_VERSION}`; the Linux assets are static musl binaries,
# so there is no Node dependency and no glibc floor. Latest non-prerelease as of
# 2026-10-14 (the 0.163.0-alpha.* tags are prereleases — do not pin to those).
# Bump this together with CODEX_SHA256_* in checksums.env.
export CODEX_VERSION=0.162.1
# ripgrep, as a REAL binary. Codex shells out to `rg` for search and reports it
# missing without one (`codex doctor` -> "search command could not be verified").
# The image looked like it already had rg, but that is a bash FUNCTION injected
# by Claude Code's shell profile wrapping its own vendored copy: `env rg` fails
# with ENOENT, and Codex execve's rg directly, so the function is invisible to
# it. Bump with RIPGREP_SHA256_* in checksums.env.
export RIPGREP_VERSION=15.2.0
# Google Gemini CLI — the third agent harness (ADR 0005). Release tags are
# `v${GEMINI_VERSION}`; the asset is a platform-independent JS bundle that needs
# Node >=20, so gemini.sh must run after node.sh. v0.64.0 is the npm `latest`
# and GitHub "Latest" release as of 2026-10-16 (the 0.65.0-preview/nightly tags
# are prereleases — do not pin to those). Bump with GEMINI_SHA256 in
# checksums.env, then re-run the spike fixtures (docs/research/gemini-harness).
export GEMINI_VERSION=0.64.0
export WHISPER_CPP_VERSION=1.8.3
export PLAYWRIGHT_VERSION=1.58.2
export K6_VERSION=1.7.1
# gitleaks is NOT pinned here: clis.sh reads GITLEAKS_VERSION and its sha256s
# from gardenio/locks/security-tools.lock, the pin CI's gitleaks gate installs,
# so a crew's local scan flags what CI flags (gd-H2ZTTWf8s8, gd-Hv60lq5XOX).

# ── PostgreSQL 17 client (pg_dump/pg_restore/psql) ───────────────────
# Vendored into /opt/pg17 at build time (clis.sh) so the P4.4 DB-cutover Jobs
# don't fetch it from apt.postgresql.org INSIDE the frozen irreversible window
# (ka-0000003862 / ka-0000008220). The source Aurora is PostgreSQL 17.x and
# pg_dump refuses to dump a server newer than itself, so a pg17 client is
# mandatory; the agent image otherwise ships only pg16 (postgresql-client
# transitive). PGDG_PG17_DEB_FILEVER is the URL-path version token for the
# apt.postgresql.org pool (the '+' is percent-encoded as %2B in the URL). Bump
# the sha in checksums.env when changing it.
export PGDG_PG17_DEB_FILEVER=17.10-1.pgdg24.04%2B1

# ── Base apt packages (minimal agent: git, Node.js, Claude Code) ──
# NOTE: python3.12-minimal, libpython3.12-minimal, and libpython3.12-stdlib are
# listed explicitly because the RWX-era CI image build extracted files via
# dpkg -L per package: the python3/python3-minimal metapackages only contain
# symlinks, and the versioned packages could be pre-installed on its runner and
# so invisible to its before/after diff. The Dockerfile's apt-get install does
# not need them listed; they are kept so the package set does not change.
export BASE_PACKAGES="curl git git-crypt git-lfs jq xz-utils ca-certificates screen tmux openssh-client python3 python3-minimal python3.12 python3.12-minimal libpython3.12-minimal libpython3.12-stdlib python3-pip python3-venv"

# ── Agent apt packages (full agent: compilers, dev libs, tools) ───
# NOTE: both versioned packages (gcc-13, g++-13, cpp-13) AND their
# architecture-specific provider packages (gcc-13-x86-64-linux-gnu, etc.)
# must be listed explicitly. The versioned packages contain only symlinks
# (e.g. gcc-13 -> x86_64-linux-gnu-gcc-13) while the arch-specific packages
# contain the actual compiler binaries. The RWX-era CI image build extracted
# files per-package via dpkg -L, so a package pre-installed on its runner went
# missing from the assembled image; the list is kept explicit so the package
# set does not change.
export AGENT_PACKAGES="make unzip xz-utils gcc gcc-13 gcc-13-x86-64-linux-gnu g++ g++-13 g++-13-x86-64-linux-gnu cpp-13 cpp-13-x86-64-linux-gnu libc6-dev linux-libc-dev binutils binutils-x86-64-linux-gnu pkg-config libssl-dev libcurl3t64-gnutls libicu74 libicu-dev postgresql-client libreadline8t64 shellcheck ffmpeg cmake libsdl2-dev protobuf-compiler"

# ── Postgres 16 server + pgvector (pg-scratch, gd-ELlwvze8G3) ──────
# A throwaway local server for `make test-lands-conformance` and other tests
# that need pgvector (ci.yml runs pgvector/pgvector:pg16). Installed after
# postgresql-common with create_main_cluster = false, so the build neither
# creates nor starts a cluster; `pg-scratch start` runs one on demand. noble's
# pgvector (0.6.x) covers kbeads' vector + ivfflat.
export PG_SERVER_PACKAGES="postgresql-16 postgresql-16-pgvector"

# ── Playwright system deps (browser rendering libraries) ──────────
export PLAYWRIGHT_SYSTEM_DEPS="libasound2t64 libatk-bridge2.0-0t64 libatk1.0-0t64 libatspi2.0-0t64 libcairo2 libcups2t64 libdbus-1-3 libdrm2 libgbm1 libglib2.0-0t64 libnspr4 libnss3 libpango-1.0-0 libx11-6 libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 libxkbcommon0 libxrandr2 fonts-noto-color-emoji fonts-noto-core libfontconfig1 libfreetype6 libsqlite3-0 libavahi-client3"
