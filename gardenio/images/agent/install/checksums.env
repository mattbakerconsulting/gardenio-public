# ── OpenAI Codex CLI (static musl release tarballs) ──────────────────
# Upstream publishes a .sigstore bundle per asset but no SHA256SUMS file, and
# cosign is not available in any build stage here, so these digests come from
# the GitHub release asset `digest` field and were each re-hashed locally from
# a fresh download on 2026-10-14 (both matched). Pairs with CODEX_VERSION.
export CODEX_SHA256_X86_64=86f268d81b898f3e144c5ecff2ad2fda2c5802e042d6195b72538fe0fa125057
export CODEX_SHA256_AARCH64=bf3ca2719f1143b1440fbd85c149379e696c782c50ad7991f8bfcec60b2600c1

# ── Google Gemini CLI (platform-independent JS bundle) ───────────────
# One asset for both arches. Upstream publishes no checksum file and no
# attestation (`gh attestation verify` -> 404), so this is the GitHub release
# asset `digest`, re-hashed locally from a fresh download on 2026-10-16 (matched)
# and cross-checked against the npm tarball's bundle/ (identical but for five
# examples/*/.gitignore files). Pairs with GEMINI_VERSION.
export GEMINI_SHA256=9d4ad33d15dcf35098919c69eb9d98b6dc640567f141d6fc4f8f053c8cbd8dae

# ── ripgrep (static musl release tarballs; a Codex dependency) ───────
