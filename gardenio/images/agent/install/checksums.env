# ── Google Chrome Linux signing key (apt repo) ───────────────────────
# The GPG key used to sign the google-chrome-stable apt repo. Pinning its
# sha means a compromised dl.google.com cannot rotate in an attacker key
# without rebuilding the agent image.
export CHROME_SIGNING_KEY_SHA256=0acccf28849439e3b2f7c60f899da45186a3a9b2fd02cc88cd44b25200016c56 # gitleaks:allow: sha256 of Google's public apt signing key

# ── PostgreSQL 17 client .deb (apt.postgresql.org PGDG pool) ─────────
# postgresql-client-17_${PGDG_PG17_DEB_FILEVER}_<arch>.deb. Vendored into
# /opt/pg17 at build time (clis.sh) so the P4.4 cutover Jobs use a baked pg17
# client instead of curling it inside the frozen window (ka-0000003862). PGDG
# publishes no SHASUMS file next to the pool .debs, so these were hashed from
# the exact pinned URLs (refresh procedure: re-download both arch .debs and
# sha256sum). amd64 + arm64 to match the agent image's dual-arch build.
export PGDG_PG17_CLIENT_DEB_SHA256_AMD64=e8806cd10a1c9ce453ef5feec242c6f9ba1229ce31ea862a6335277eae027987
export PGDG_PG17_CLIENT_DEB_SHA256_ARM64=3dd033465ecd4ef10144669f482faa195a34f756d3d059e42086b4b3a7c9843d

