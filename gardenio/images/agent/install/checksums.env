# ── Poetry installer script (install.python-poetry.org) ──────────────
# Poetry's official install path is a Python script; pin its sha so a
# compromised install.python-poetry.org cannot swap in arbitrary code.
# The script itself then downloads the Poetry wheel, which is verified
# via PyPI's own cryptographic chain (pip --require-hashes is not wired
# through install-poetry.py).
export POETRY_INSTALL_SHA256=75745ca71373a7b22fa150953543f03d826a52f8e4bc4350328a33bddd668026

# ── rustup-init installer (archived per-release binary) ──────────────
# Pin the archived, per-release rustup-init binary from
# static.rust-lang.org (version RUSTUP_VERSION in versions.env), NOT the
# rolling sh.rustup.rs wrapper script whose sha drifts on every upstream
# rustup push and periodically reds every MR (ka-0000004123). Per
# (version, target) the artifact is immutable, so these shas never drift.
# rustup-init is GPG-verified internally against static.rust-lang.org
# manifests. Per-arch (rust-tools.sh selects via pick_sha_alt / $ARCH).
export RUSTUP_INIT_SHA256_X86_64=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71
export RUSTUP_INIT_SHA256_AARCH64=15f6e4ce9f583b929c996c91562bad6d4454f3281de858b02cdfdef615fac433

