export RIPGREP_SHA256_AARCH64=800b1e7206afe799dfb5a6901f23147cfaabe0e52210538100f61e86e1740915

# ── Claude Code npm tarballs (sha512, npm's native digest algorithm) ─
# The meta package (@anthropic-ai/claude-code) is a small (~20KB) WRAPPER whose
# postinstall copies the platform-native binary over a stub — a meta-only
# offline install yields a NON-WORKING `claude` ("native binary not installed").
# The real ELF lives in the per-arch package (@anthropic-ai/claude-code-linux-<arch>):
# its top-level `package/claude` is a self-contained glibc binary that runs with
# no node/npm. So the microvm image (offline `npm install -g` of meta+native)
# needs the ARCH-matched native digest, not just the meta one.
#   • meta  (CLAUDE_CODE_SHA512)        — microvm offline npm install
#   • arm64 (CLAUDE_CODE_ARM64_SHA512)  — microvm (Lambda MicroVM is arm64)
# (An x64 digest fed the RWX e2e `install-claude` task; it went with RWX.)
# Pairs with CLAUDE_CODE_VERSION in versions.env — refresh BOTH together:
#   curl -fsSL https://registry.npmjs.org/@anthropic-ai/claude-code/-/claude-code-<ver>.tgz | sha512sum
#   curl -fsSL https://registry.npmjs.org/@anthropic-ai/claude-code-linux-arm64/-/claude-code-linux-arm64-<ver>.tgz | sha512sum
export CLAUDE_CODE_SHA512=579591a40fa9e35b224a57ff523c639bffd1b58bf24b11ffa7dfeb87acd1c4da07781cea4e0483c379cff0f82d00233f29c571fe0e5315435d564ab9d5d7e0d2
export CLAUDE_CODE_ARM64_SHA512=314dd178ad648ecb439a310ece11596a9861d805542a73da8a4ea5395d162ecdff98e33b984fe6aa475c43f4afd0ac071f93273a14a4223084974ffcb6bfaf46

