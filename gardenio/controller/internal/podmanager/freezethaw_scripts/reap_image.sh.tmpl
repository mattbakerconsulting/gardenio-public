set -uo pipefail
IMG='{{.ImagePath}}'
HMNT() { nsenter -t 1 -m -- "$@"; }
log() { echo "    $*" >&2; }
if HMNT rm -rf "$IMG" 2>/dev/null; then
  echo "FT_IMAGE_REAPED=yes"
  log "reaped checkpoint image $IMG after verified thaw"
else
  echo "FT_IMAGE_REAPED=no"
  log "WARN failed to reap checkpoint image $IMG (best-effort; restore already succeeded)"
fi
