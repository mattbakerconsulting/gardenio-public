set -uo pipefail
ROOT=/run/containerd/runsc/k8s.io
T=/run/containerd/io.containerd.runtime.v2.task/k8s.io
BNAME='{{.PlaceholderPod}}'
BPODUID='{{.BPodUID}}'
ASB='{{.ASandboxCID}}'
AAG='{{.AAgentCID}}'
APOD='{{.APodUID}}'
IMG='{{.ImagePath}}'
BUNDLE='{{.BundlePath}}'
CCOUNT={{.ContainerCount}}
RUNSC_TIMEOUT={{.RunscTimeout}}
# OVERLAY_FLAG (ka-0000007239, overlay-dir-medium): the --overlay2=<medium> the
# checkpoint was taken under, replayed to EVERY runsc restore so the restored sentry
# rebuilds its rootfs-overlay upper from the SAME medium (a root:dir checkpoint can
# ONLY restore under root:dir). The snapshot self-describes the medium (freeze probe
# FT_OVERLAY_MEDIUM); the Go side renders the full flag here, or LEAVES IT EMPTY for
# self/default-medium snapshots — empty ⇒ the restore lines are byte-identical to the
# pre-fix script, so non-dir nodes carry zero blast radius (substrate revalidation
# ka-0000007329 proved the upper rides inside checkpoint.img, so there is nothing else
# for thaw to materialize — only the flag must match).
OVERLAY_FLAG='{{.RestoreOverlayFlag}}'
# THAWDIR (fix, bug ka-0000000673 / ka-0000001104): the NEW agent's per-agent
# thaw-state hostPath on the node (thawStateHostDir(req.AgentName)) — the dir the
# controller's NodeRehydrationTrigger writes the epoch marker into and polls acks
# from. The [3] mount-rewrite FORCES the agent bundle's MountThawState mount SOURCE
# to this dir, overriding the bsrc[d] live-Pod-B source (which on the warm-B path is
# a pool placeholder minted from a DIFFERENT agent's template, so it resolves the
# WRONG, stale thaw-state dir -> both-consumer ack fail-close). EMPTY (legacy
# snapshot / older controller) leaves the rewrite at its pre-fix bsrc[d] behavior.
THAWDIR='{{.ThawStateDir}}'
THAWDEST='{{.ThawStateDest}}'
# EGRESS_* (fix B, ka-0000008207): the in-sentry egress targets the [6c] assertion
# TCP-dials FROM INSIDE the restored sandbox — the SAME endpoints the two rehydrate
# consumers reach (coop -> NATS, gb -> beads daemon). Empty (older controller / unset
# config) makes [6c] skip the end-to-end dial but still assert the sentry's own
# default route. Rendered by buildThawScript from the manager's NatsURL/BeadsHTTPAddr.
EGRESS_NATS_HOST='{{.NatsHost}}'
EGRESS_NATS_PORT='{{.NatsPort}}'
EGRESS_BEADS_HOST='{{.BeadsHost}}'
EGRESS_BEADS_PORT='{{.BeadsPort}}'
# EGRESS_*_ADDR (bug ka-0000002907): the resolved ClusterIP LITERALS the [6c-2] dial
# CONNECTS to. The bare DNS names above are kept only for the human-readable log line;
# a LINK-ONLY restored sentry cannot reach kube-dns, so dialing a name gaierrors ->
# "inconclusive" -> flake-OPEN (the #11 miss). A ClusterIP is a cluster-global VIP the
# netstack routes at L3 with no DNS, so a link-only sentry no-routes it EHOSTUNREACH ->
# link-only -> fail-closed. Empty (controller could not resolve / already-an-IP that
# failed) SKIPS the dial for that target; the [6c-1] default-route check is the floor.
EGRESS_NATS_ADDR='{{.NatsDialAddr}}'
EGRESS_BEADS_ADDR='{{.BeadsDialAddr}}'
RUNSC() { nsenter -t 1 -m -p -n -- timeout "${RUNSC_TIMEOUT}" runsc --root=$ROOT "$@"; }
HMNT() { nsenter -t 1 -m -- "$@"; }
# HMNTT: KILL-signal-bounded host-ns helper (mirrors the freeze template's HMNTT).
# The thaw script defines RUNSC/HMNT but historically NOT HMNTT; the fix-C
# restore-peak measurement (ka-0000003398) needs a bounded host-ns find over
# /sys/fs/cgroup so a pathological cgroup tree cannot wedge the read. Same nsenter
# host mount-ns as HMNT, wrapped in the RUNSC_TIMEOUT + SIGKILL discipline. Used
# only by the best-effort measurement block at the script tail.
HMNTT() { nsenter -t 1 -m -- timeout -s KILL -k 5s "${RUNSC_TIMEOUT}" "$@"; }
log() { echo "    $*" >&2; }
OVER=/var/tmp/gb-thaw-over

# SUBNAMES is the ordered roster of sub-containers to restore on top of the
# sandbox root (ka-0000003561): the agent first, then any always-on DinD/Postgres
# sidecars. The bundle subdir for each is its CRI container-name. A bare agent pod
# has just "agent"; a Docker/Postgres agent adds "dind"/"postgres". A legacy
# snapshot with no roster falls back to the agent alone (the proven 2-container
# shape). DSTNS is sandbox + every sub-container — the per-container loops use it.
SUBNAMES="$(printf '%s\n' {{range .SubContainers}}'{{.Name}}' {{end}})"
[ -z "$(printf '%s' "$SUBNAMES" | tr -d '[:space:]')" ] && SUBNAMES="agent"
DSTNS="$(printf 'sandbox\n%s\n' "$SUBNAMES")"

# [0] RE-MATERIALIZE the OCI bundle spec files from the snapshot (fix B,
# ka-0000000301). The host bundle dir $BUNDLE may have been GC'd by Pod A's
# post-freeze teardown (containerd 'runsc delete' reaps the per-container bundle
# dir) — only the standalone checkpoint image survives, so without this thaw
# FetchSpec-ENOENTs (rc=128) on config.json. Re-create the dir tree (incl. the
# rootfs mountpoint the [2] overlay targets, one per sandbox + sub-container) and
# rewrite the captured config.json/.overlay-opts in the HOST ns (HMNT), so all
# subsequent $BUNDLE reads — [2] overlay, [3] config rewrite, [5] runsc restore
# --bundle — see a complete bundle regardless of whether the dir survived teardown.
for dstn in $DSTNS; do HMNT mkdir -p "$BUNDLE/$dstn/rootfs"; done
write_spec() { # $1=bundle-relative path, $2=base64 bytes
  printf '%s' "$2" | base64 -d | HMNT tee "$BUNDLE/$1" >/dev/null \
    && log "rematerialized $1" \
    || { log "FATAL: rematerialize $1 failed"; echo "FT_ROOT_RC=126"; exit 1; }
}
{{range .SpecFiles}}write_spec '{{.Path}}' '{{.Base64}}'
{{end}}
# [0b] PRE-RESTORE checkpoint-IMAGE assertion (ka-0000003702), parallel to the
# freeze [3d/8] FT_IMAGE_OK guard. The 3.0G image is NOT snapshot-carried (too
# large), so thaw reads it from $IMG (/var/lib/gardenio/ckpt/<agent>, the
# controller-owned safe path). If it is absent or empty here, runsc restore would
# ENOENT on checkpoint.img with an opaque rc=128 ("opening state file … failed").
# Probe it FIRST, in the HOST NS (HMNT test -s — same mount ns runsc reads), and
# fail LOUD with an image-DELETION diagnosis so the failure mode is unmistakable
# (a reaped image at the safe path, not a restore-internal error). Emit FT_IMAGE_OK
# so the Go post-state check can assert it before driving any restore.
if HMNT test -s "$IMG/checkpoint.img"; then
  echo "FT_IMAGE_OK=yes"
else
  log "FATAL: checkpoint IMAGE $IMG/checkpoint.img absent or empty at thaw — the 3.0G runsc image was DELETED between freeze and thaw (Pod-A-teardown reap of the checkpoint dir). Relocation to the controller-owned safe path /var/lib/gardenio/ckpt should prevent this; if you see this, the safe path is itself being GC'd or freeze never wrote it. NOT a restore-internal failure."
  echo "FT_IMAGE_OK=no"
  echo "FT_ROOT_RC=128"
  exit 1
fi

# [1] resolve Pod B's fresh kubelet-owned cids: the sandbox + EVERY sub-container,
# paired to the snapshot's roster BY container-name (gVisor matches a checkpointed
# sub-container to a restore call via the container-name annotation, not the cid).
# bann reads one annotation from a B-container state JSON on stdin.
bann() { python3 -c 'import sys,json;print(json.load(sys.stdin).get("annotations",{}).get(sys.argv[1],""))' "$1" 2>/dev/null; }
BALL=$(ctr -n k8s.io containers ls 2>/dev/null | awk 'NR>1{print $1}')
# B_NAME_CID accumulates "<container-name> <cid>" lines for $BNAME's sub-containers.
B_NAME_CID=""
BAG=""
for c in $BALL; do
  s=$(RUNSC state "$c" 2>/dev/null) || continue
  sn=$(printf '%s' "$s" | bann io.kubernetes.cri.sandbox-name)
  ct=$(printf '%s' "$s" | bann io.kubernetes.cri.container-type)
  cn=$(printf '%s' "$s" | bann io.kubernetes.cri.container-name)
  [ "$sn" = "$BNAME" ] && [ "$ct" = "container" ] || continue
  [ -z "$cn" ] && cn=agent   # legacy image whose CRI container-name is unset
  B_NAME_CID="$B_NAME_CID$cn $c
"
  [ "$cn" = "agent" ] && BAG="$c"
done
# fall back: if no container was explicitly named "agent", take the first sub.
if [ -z "$BAG" ]; then
  BAG=$(printf '%s' "$B_NAME_CID" | awk 'NR==1{print $2}')
fi
[ -z "$BAG" ] && { log "FATAL: no agent sub-container for placeholder $BNAME"; echo "FT_ROOT_RC=127"; exit 1; }
BAGS=$(RUNSC state "$BAG")
BSB=$(printf '%s' "$BAGS" | bann io.kubernetes.cri.sandbox-id)
[ -z "$BPODUID" ] && BPODUID=$(printf '%s' "$BAGS" | bann io.kubernetes.cri.sandbox-uid)
# bcid_for maps a snapshot roster container-name to Pod B's fresh cid.
bcid_for() { printf '%s' "$B_NAME_CID" | awk -v n="$1" '$1==n{print $2; exit}'; }
# assert every roster sub-container has a matching B cid BEFORE driving any restore
# — a missing sidecar slot on Pod B means buildPlaceholderPodB did not carry the
# sidecar (or it is not Ready), so the barrier could never satisfy; fail loud.
for cn in $SUBNAMES; do
  [ -n "$(bcid_for "$cn")" ] || { log "FATAL: placeholder $BNAME has no sub-container named '$cn' (roster/PodB shape mismatch) — the N-container barrier cannot satisfy. NOT proceeding."; echo "FT_ROOT_RC=127"; exit 1; }
done

# NETNS REPOINT (fix-a, ka-0000004146). The original thaw rc=128 root failure was
# 'error opening "/var/run/netns/cni-<A>": no such file or directory' — the restore
# was still wired to Pod A's CNI netns, which the kubelet/CNI tore down when Pod A
# was deleted at freeze. The repoint to Pod B's fresh netns must resolve a NON-EMPTY
# path and FAIL CLOSED if it cannot: the prior code resolved BNETNS best-effort from
# a single ($T/$BSB/config.json) location and, on an empty result, SILENTLY skipped
# the repoint in PYSANDBOX (the old "if ... and bnetns" guard), leaving Pod A's dead
# netns path in the spec -> the exact rc=128. Resolve from BOTH the v2 task dir AND
# the runsc-state bundle dir, in the HOST ns (HMNT) where runsc reads the spec, bail loud
# if neither yields a network-namespace path.
read_netns_path() { # $1 = candidate config.json (host-ns path)
  HMNT test -f "$1" || return 1
  HMNT python3 -c 'import json,sys
ns=json.load(open(sys.argv[1])).get("linux",{}).get("namespaces",[])
print(next((n.get("path","") for n in ns if n.get("type")=="network" and n.get("path")),""))' "$1" 2>/dev/null
}
BSB_BUNDLE=$(RUNSC state "$BSB" 2>/dev/null | python3 -c 'import sys,json;print(json.load(sys.stdin).get("bundle",""))' 2>/dev/null)
BNETNS_PATH=""
for cand in "$T/$BSB/config.json" "$BSB_BUNDLE/config.json"; do
  BNETNS_PATH=$(read_netns_path "$cand"); [ -n "$BNETNS_PATH" ] && break
done
if [ -z "$BNETNS_PATH" ]; then
  log "FATAL: could not resolve Pod B's network namespace path (tried $T/$BSB/config.json and bundle $BSB_BUNDLE). Restore would re-open Pod A's torn-down CNI netns -> rc=128. NOT proceeding with a dead-netns restore."
  echo "FT_ROOT_RC=128"
  exit 1
fi
# CNI-ADD COMPLETION GATE (fix C, ka-0000001156 — RESEQUENCE, decision ka-0000002646).
# Re-sequence the graft so the placeholder Pod B sandbox delete ([4] runsc delete
# --force, below) and the netns pin (immediately below) never capture a netns whose
# AWS VPC CNI ADD is still IN FLIGHT. On canary xq3 the pin (Fix B) DID preserve Pod
# B's eth0 veth across the graft delete — but the pinned netns had NO IPv4 addr and
# an EMPTY route table: the CNI ADD's LINK step had run (veth created + moved in +
# UP, host eni* peer wired) while its IPAM/route-install step had NOT yet completed.
# The force-delete of Pod B's sandbox aborted the in-flight ADD before IPAM assigned
# an IP + installed the default route, so Fix B pinned a half-configured (link-only)
# netns and Fix A's restore-time netns-content assertion correctly fail-closed LOUD
# (non-lo ifaces=1, default-route=no).
#
# FIX: before pinning (and long before the [4] force-delete), POLL Pod B's LIVE CNI
# netns until the ADD is CONFIRMED COMPLETE — i.e. a global-scope IPv4 addr exists on
# a non-loopback iface (IPAM finished) AND a default route is present in
# /proc/net/route (the route step ran) — or, equivalently, the CNI result is already
# committed to /var/lib/cni/results/. Only then pin, so the bind-mount captures a
# FULLY-configured, routable netns inode, and the subsequent force-delete + kubelet
# CNI DEL can race all they like — the pinned copy already holds eth0 + IP + route.
# All checks run in the HOST mount ns (HMNT) so they see the same /var/run/netns,
# /var/lib/cni, and node iproute2 binary runsc/the kubelet use.
#
# Bounded, best-effort: a placeholder that became Ready has normally finished CNI ADD
# already, so the poll usually returns on the first iteration; the loop only covers
# the tail of a fresh placeholder still mid-ADD. If the ADD never completes within
# the deadline we log LOUD and pin anyway (same best-effort posture as the pin
# itself) — Fix A's netns-content assertion still fails-closed LOUD at restore time
# if the graft lands a link-only netns, so a missed confirmation degrades to a loud
# restore failure + clean cold-start fallback, never a silent 60s-later ack timeout.
cni_add_complete() { # rc 0 == Pod B's CNI ADD has fully completed (IPv4 + default route)
  # global-scope IPv4 on a non-loopback iface => CNI IPAM assigned an address
  # (scope global already excludes 127.0.0.1/::1; the awk guard is belt-and-suspenders).
  HMNT nsenter --net="$BNETNS_PATH" -- ip -4 -o addr show scope global 2>/dev/null \
    | awk '$2!="lo"{f=1} END{exit !f}' || return 1
  # default route (00000000 destination, /proc/net/route) => the CNI route step ran.
  HMNT nsenter --net="$BNETNS_PATH" -- awk 'NR>1 && $2=="00000000"{f=1} END{exit !f}' /proc/net/route 2>/dev/null || return 1
  return 0
}
# read_cni_pod_ip echoes the IPv4 (CIDR form, e.g. 10.30.136.3/32) the AWS VPC CNI
# assigned Pod B, read from the AUTHORITATIVE committed CNI result file (fix C,
# ka-0000001099). THIS is the layer that fixes the two-inode split: the prior Fix-C
# gate confirmed via cni_result_cached keyed on $BSB (the SANDBOX cid) and/or polled
# $BNETNS_PATH (the SANDBOX netns), but in the runsc placeholder the AWS VPC CNI
# installs the pod IP into a DIFFERENT inode — the PAUSE container's netns — so the
# sandbox netns the pin/restore targets carries the eth0 veth but NO IP/route, and the
# $BSB-keyed result probe matched a file that does not describe the restore-target
# netns. Instead, glob /var/lib/cni/results and select Pod B's entry by its
# K8S_POD_UID cniArg (falling back to K8S_POD_NAME) — NOT by a cid — so we get the IP
# the kubelet/CNI committed regardless of which netns inode holds it. The IP is then
# self-applied into the restore-target inode post-restore (self_ipam), decoupling the
# fix from netns-inode resolution entirely (the failure mode that recurred 3x:
# ka-0000001790 -> ka-0000001156 -> ka-0000001099).
read_cni_pod_ip() {
  HMNT python3 - "$BPODUID" "$BNAME" <<'PYCNI' 2>/dev/null
import json,glob,sys
uid,name=(sys.argv[1] if len(sys.argv)>1 else ""),(sys.argv[2] if len(sys.argv)>2 else "")
for fp in sorted(glob.glob("/var/lib/cni/results/*")):
    try: d=json.load(open(fp))
    except Exception: continue
    args=dict((kv[0],kv[1]) for kv in d.get("cniArgs",[]) if isinstance(kv,(list,tuple)) and len(kv)==2)
    if uid and args.get("K8S_POD_UID")==uid: pass
    elif name and args.get("K8S_POD_NAME")==name: pass
    else: continue
    for ip in d.get("result",{}).get("ips",[]):
        a=ip.get("address","")
        if a and ":" not in a:  # IPv4 only
            print(a); sys.exit(0)
PYCNI
}
# AWS VPC CNI synthesizes a link-scope gateway at 169.254.1.1 for every pod (the pod
# eth0 has only a /32, no on-link subnet), and installs the default route via it. We
# reconstruct exactly that in self_ipam below from the committed pod IP.
CNI_GW=169.254.1.1
# poll up to ~30s (60 * 0.5s) for the ADD to confirm; matches the seq+sleep idiom
# used by the [5] post-restore sandbox-state wait below. CONFIRMATION SOURCE OF
# TRUTH = the committed CNI result IP (read_cni_pod_ip), decoupled from inode; the
# $BNETNS_PATH netns poll is kept only as a secondary signal for non-split topologies
# that DO populate the sandbox netns.
CNI_POD_IP=$(read_cni_pod_ip)
CNI_CONFIRMED=no
CNI_VIA=
for _i in $(seq 1 60); do
  [ -z "$CNI_POD_IP" ] && CNI_POD_IP=$(read_cni_pod_ip)
  if [ -n "$CNI_POD_IP" ]; then CNI_CONFIRMED=yes; CNI_VIA=cni-result; break; fi
  if cni_add_complete; then CNI_CONFIRMED=yes; CNI_VIA=netns; break; fi
  sleep 0.5
done
echo "FT_CNI_CONFIRMED=$CNI_CONFIRMED"
echo "FT_CNI_POD_IP=$CNI_POD_IP"
if [ "$CNI_CONFIRMED" = yes ]; then
  log "Pod B CNI ADD confirmed (via $CNI_VIA): committed CNI result assigns pod IP '$CNI_POD_IP' (matched by K8S_POD_UID=$BPODUID / name=$BNAME) — fix C will self-apply it onto eth0 in the RESTORE-TARGET netns (the restored sentry's OWN netns, /proc/<RPID>/ns/net) post-restore + synthesize link-scope gw $CNI_GW. This decouples from the sandbox-vs-pause netns inode split; the restore-target L3 is then confirmed by Fix A's [6a] content assertion ON THAT SAME inode."
else
  log "WARN Pod B CNI ADD NOT confirmed within ~30s (no committed CNI result IP for uid=$BPODUID/name=$BNAME under /var/lib/cni/results, no global IPv4 + default route in $BNETNS_PATH) — the placeholder's CNI ADD likely never finished provisioning. Fix C self-IPAM will no-op; Fix A's netns-content assertion still fails-closed LOUD at restore if the graft lands a link-only netns (clean cold-start fallback)."
fi

# L3 CAPTURE for post-delete re-assert (fix B, ka-0000001790). The Fix-C gate above
# proved (necessary) that Pod B's CNI ADD COMPLETED — a global IPv4 + default route
# exist in $BNETNS_PATH right now — but b4a's on-node forensics (06-12) proved it
# INSUFFICIENT: the [4] force-delete below fires the AWS VPC CNI DEL, which STRIPS the
# IPv4 ADDRESS + ROUTE TABLE from the netns even though the inode-pin preserves the
# eth0 veth LINK. (Leaked failed-restore sandbox PID 9528: /proc/.../net/dev = lo+eth0,
# /proc/.../net/route EMPTY, fib_trie NO global IPv4.) So the gate sees IP+route, then
# the force-delete removes them anyway — exactly ka-0000001156's link-only signature.
#
# FIX B: snapshot the CONFIRMED L3 state HERE (while the CNI ADD output is still live),
# then statically RE-ASSERT it onto the (surviving, inode-pinned) eth0 veth AFTER the
# force-delete — so the restore lands a fully-routable netns regardless of the CNI DEL.
# A veth pair is one object: the forensics proving the POD-side veth survived the DEL
# imply the HOST-side peer survived too (you cannot delete half a veth), so L2 host<->pod
# is intact and only the pod-side L3 needs re-applying. We capture ALL global-scope IPv4
# addrs (IPAM result) AND the full IPv4 route table (the link-scope CNI gateway route +
# the default via it), so the replay reconstructs the CNI-configured netns faithfully,
# not just a single addr. Captured into shell vars (one bash process spans gate->restore),
# replayable verbatim by 'ip addr add' / 'ip route add'. Empty when CNI was NOT confirmed
# (nothing trustworthy to replay) — reassert_l3 then no-ops and Fix A still fails closed.
# All HMNT nsenter so we read/write the SAME host-ns netns runsc/the kubelet operate on.
CAP_ADDRS=
CAP_ROUTES=
if [ "$CNI_CONFIRMED" = yes ]; then
  CAP_ADDRS=$(HMNT nsenter --net="$BNETNS_PATH" -- ip -4 -o addr show scope global 2>/dev/null \
    | awk '$2!="lo"{print $4" dev "$2}')
  CAP_ROUTES=$(HMNT nsenter --net="$BNETNS_PATH" -- ip -4 route show 2>/dev/null)
  log "captured Pod B L3 for fix-B re-assert: addrs=[$(printf '%s' "$CAP_ADDRS" | tr '\n' ';')] routes=[$(printf '%s' "$CAP_ROUTES" | tr '\n' ';')]"
fi
# reassert_l3 statically re-applies the captured CNI L3 (addrs + routes) into a netns
# (fix B, ka-0000001790). $1 is the netns reference to operate in — the pinned bind-mount
# path PRE-restore (so runsc restore inherits a routable netns), or the restored sentry's
# /proc/<pid>/ns/net POST-restore (the SAME inode; last-write-wins against a late async
# kubelet CNI DEL). No-op when nothing was captured (CNI unconfirmed). Order matters:
# bring the veth UP, add addrs, then NON-default routes (the link-scope CNI gateway, e.g.
# 169.254.1.1 dev eth0) BEFORE the default route that resolves via it — else an
# 'ip route add default via <gw>' fails with "Nexthop has invalid gateway". Every op is best-effort
# (|| true): an already-present addr/route returns EEXIST (the pre-restore apply may still
# be in place at the post-restore re-apply), which is success for our purposes. The caller
# emits FT_NETNS_L3_REASSERTED so the controller can see the fix engaged even when [6a]
# later still fails (e.g. a DEL that also tore the host-side route — the next-layer cause).
reassert_l3() { # $1 = netns reference (pinned path or /proc/<pid>/ns/net)
  local ref="$1"
  [ -n "$CAP_ADDRS$CAP_ROUTES" ] || return 0
  HMNT nsenter --net="$ref" -- ip link set eth0 up 2>/dev/null || true
  printf '%s\n' "$CAP_ADDRS" | while IFS= read -r a; do
    [ -n "$a" ] || continue
    HMNT nsenter --net="$ref" -- ip addr add $a 2>/dev/null || true
  done
  # non-default (link-scope gateway etc.) first, then default, so the gateway route
  # exists before any 'default via <gw>' that depends on it.
  printf '%s\n' "$CAP_ROUTES" | grep -v '^default' | while IFS= read -r r; do
    [ -n "$r" ] || continue
    HMNT nsenter --net="$ref" -- ip route add $r 2>/dev/null || true
  done
  printf '%s\n' "$CAP_ROUTES" | grep '^default' | while IFS= read -r r; do
    [ -n "$r" ] || continue
    HMNT nsenter --net="$ref" -- ip route add $r 2>/dev/null || true
  done
}
# self_ipam statically installs the COMMITTED CNI pod IP into a netns from the
# authoritative /var/lib/cni/results record — independent of which netns inode the
# AWS VPC CNI populated (fix C, ka-0000001099). This is the layer that closes the
# two-inode split: Fix B's reassert_l3 captures L3 FROM a netns ($BNETNS_PATH, the
# sandbox netns) and re-applies it — but in the runsc placeholder topology the CNI
# installed the IP into the PAUSE netns, a different inode, so the sandbox-netns
# capture found nothing (CAP_ADDRS empty, l3-reasserted=no). self_ipam does not
# capture from any source netns at all: it takes the IP straight from the committed
# CNI result ($CNI_POD_IP) and writes it into whatever inode $1 names — which the
# caller sets to the restored sentry's OWN netns (/proc/<RPID>/ns/net), i.e. the
# exact inode the restore lands in. AWS VPC CNI gives the pod eth0 only a /32 with
# no on-link subnet and routes everything via a synthetic link-scope gateway
# (169.254.1.1), so we mirror that: force the addr to /32, add an on-link host route
# to the gateway (scope link, dev eth0), then the default via it. Order matters — the
# gateway route must exist before 'default via <gw>' or it fails "Nexthop has invalid
# gateway". Idempotent + guarded: no-op if $CNI_POD_IP is empty (CNI unconfirmed) or
# the netns has no eth0; every op is best-effort (|| true) so an already-present addr/
# route (EEXIST, e.g. a non-split topology that DID populate this netns) is success.
self_ipam() { # $1 = netns reference (typically /proc/<RPID>/ns/net, the restore target)
  local ref="$1" ip32
  [ -n "$CNI_POD_IP" ] || return 0
  HMNT nsenter --net="$ref" -- test -d /sys/class/net/eth0 2>/dev/null || \
    HMNT nsenter --net="$ref" -- ip link show eth0 >/dev/null 2>&1 || return 0
  # normalize to a /32 host address (AWS VPC CNI pod eth0 carries no subnet).
  ip32="${CNI_POD_IP%/*}/32"
  HMNT nsenter --net="$ref" -- ip link set eth0 up 2>/dev/null || true
  HMNT nsenter --net="$ref" -- ip addr add "$ip32" dev eth0 2>/dev/null || true
  # on-link host route to the synthetic link-scope gateway, then the default via it.
  HMNT nsenter --net="$ref" -- ip route add "$CNI_GW" dev eth0 scope link 2>/dev/null || true
  HMNT nsenter --net="$ref" -- ip route add default via "$CNI_GW" dev eth0 2>/dev/null || true
}
# netns_routable returns rc 0 iff netns $1 currently carries a routable L3: a
# global-scope IPv4 on a non-loopback iface AND a default route. Used by fix A
# (ka-0000008207) to RE-VERIFY the restore-target inode is routable in the few
# hundred ms after the final pre-restore reassert_l3/self_ipam and BEFORE the
# backgrounded 'runsc restore' detaches and its setupNetwork() scrapes the netns
# into the sentry netstack. If a late async kubelet CNI DEL re-stripped the addr/
# route in that window, this returns non-zero and the caller re-applies once more,
# closing the race the post-restore [6a] L3 apply cannot (it lands after the
# scrape). Same probes as cni_add_complete but parameterized on an arbitrary ref
# (the pinned path), all HMNT so we read the same host-ns netns runsc setns-es into.
netns_routable() { # $1 = netns reference (pinned path or /proc/<pid>/ns/net)
  local ref="$1"
  HMNT nsenter --net="$ref" -- ip -4 -o addr show scope global 2>/dev/null \
    | awk '$2!="lo"{f=1} END{exit !f}' || return 1
  HMNT nsenter --net="$ref" -- awk 'NR>1 && $2=="00000000"{f=1} END{exit !f}' /proc/net/route 2>/dev/null || return 1
  return 0
}
# STALE-MOUNT REAP (ka-0000007807, MR !5044 review). A hard-killed prior thaw of
# this SAME BSB can leave a stale bind-mount at either controller-owned pin path
# (the fix-B pin below and the [4-pre] hold); mounting over one would STACK a
# second bind-mount that a single later umount won't fully release. Best-effort
# umount+rm of both candidates before any pin — BSB is unique per placeholder
# pod, so only our own prior leftovers can match; no verdict logic changes.
for _stale in "/var/run/netns/gb-thaw-$BSB" "/var/run/netns/gb-thaw-hold-$BSB"; do
  HMNT umount "$_stale" 2>/dev/null || true; HMNT rm -f "$_stale" 2>/dev/null || true
done
# NETNS PIN (fix B, ka-0000007713). Pod B's CNI netns ($BNETNS_PATH) is owned by
# the kubelet/CNI, NOT by us. The [4] teardown below force-deletes Pod B's
# pause/sandbox container (runsc delete --force) to free the cid for the restore —
# and the kubelet, seeing the pod sandbox die, races a CNI DEL that UNMOUNTS
# /var/run/netns/cni-<B>. On the credentialed canary fr84 that netns was GONE by
# restore time, so runsc restore could not setns into it and silently fell back
# ANONYMOUS netns with ONLY lo (no eth0, empty route table) -> the rehydrate-ack
# gate fail-closed network-unreachable on BOTH coop AND gb 60s later. PIN the
# netns by bind-mounting it to a controller-owned, kubelet-invisible path BEFORE
# any teardown: a bind-mount holds the netns inode alive even if the kubelet
# unmounts its own cni-<B> reference, so the restore can still setns into the SAME
# (eth0-carrying) namespace instead of falling back to an anonymous lo-only one.
# Repoint the restore spec at the PINNED path (the [3]/[3-sandbox] netns repoint
# below uses $BNETNS_PATH, reassigned here). HMNT (host mount ns) so the mount
# lands where runsc reads it (ka-0000002536). The shared bind-mount keeps the SAME
# inode, so the netns PROOF below still matches; the inode is stat-ed AFTER the pin
# so FT_B_NETNS/FT_B_NETNS_PATH describe the path the restore actually targets.
# Best-effort: if the pin fails we fall back to the original CNI path (pre-fix
# behavior) — Fix A's netns-content assertion still fails-closed LOUD if the
# restore lands network-less, so a missed pin degrades to a loud restore failure,
# never a silent 60s-later ack timeout.
PINNED_NETNS="/var/run/netns/gb-thaw-$BSB"
if HMNT mkdir -p /var/run/netns 2>/dev/null \
   && HMNT test -e "$BNETNS_PATH" \
   && HMNT touch "$PINNED_NETNS" 2>/dev/null \
   && HMNT mount --bind "$BNETNS_PATH" "$PINNED_NETNS" 2>/dev/null; then
  log "pinned Pod B CNI netns $BNETNS_PATH -> $PINNED_NETNS (survives the placeholder-graft sandbox delete + kubelet CNI DEL)"
  BNETNS_PATH="$PINNED_NETNS"
  echo "FT_NETNS_PINNED=$PINNED_NETNS"
else
  log "WARN could not pin Pod B CNI netns $BNETNS_PATH (proceeding with the original kubelet-owned path; Fix A's netns-content assertion fails-closed loud if the restore lands lo-only)"
  echo "FT_NETNS_PINNED="
fi
# the restore proof compares INODES (FT_RESTORED_NETNS is the sentry's
# readlink /proc/<pid>/ns/net = net:[inode]); express B's netns as the same
# net:[inode] form by stat-ing the (now-pinned) bind-mounted netns file in the
# host ns.
BNETNS_INODE=$(HMNT stat -L -c 'net:[%i]' "$BNETNS_PATH" 2>/dev/null)
echo "FT_B_SANDBOX_CID=$BSB"
echo "FT_B_AGENT_CID=$BAG"
echo "FT_B_POD_UID=$BPODUID"
echo "FT_B_NETNS_PATH=$BNETNS_PATH"
echo "FT_B_NETNS=$BNETNS_INODE"

# [2] reconstruct each container's rootfs overlay in host-init's ns from the
# opts captured at freeze. Collapse original {lower+upper} into a fresh RO
# lowerdir (old upper first so written files win), give a fresh upper/work, and
# whiteout any leftover .gvisor.filestore.* so runsc's overlay guard is happy.
#
# MOUNT-NAMESPACE INVARIANT (ka-0000002536): freeze now writes the OCI bundle in
# the HOST mount ns (nsenter -t 1 -m), the same ns runsc restore reads it from. So
# EVERY $BUNDLE/$OVER op on thaw must also run in the host ns — a plain rm/mkdir/
# cat/python in the probe ns (chroot /host) would prep upper/work dirs and read
# overlay-opts/config.json on a DIFFERENT filesystem than the one the HMNT overlay
# mount and runsc restore consume, reintroducing the rc=128 FetchSpec defect.
HMNT rm -rf "$OVER"
build_lowers() { local opts="$1" upper lower
  upper=$(echo "$opts" | tr ',' '\n' | sed -n 's/^upperdir=//p')
  lower=$(echo "$opts" | tr ',' '\n' | sed -n 's/^lowerdir=//p')
  if [ -n "$upper" ]; then echo "${upper}:${lower}"; else echo "$lower"; fi
}
# remount_rootfs reconstructs one container's rootfs overlay. It returns non-zero
# (and the caller fails LOUD) when a lowerdir source is missing or the mount
# itself errors — DO NOT swallow either, or the rootfs is left unmounted and
# runsc restore surfaces the OPAQUE "reading mounts file: unexpected end of JSON
# input" sub rc=128 instead of the real cause (ka-0000000655, fix C).
remount_rootfs() { local dstn="$1" opts="$2" lowers up wk d
  [ -z "$opts" ] && { log "FATAL: no overlay opts for $dstn — bundle is un-thawable"; return 1; }
  lowers=$(build_lowers "$opts"); up="$OVER/$dstn/upper"; wk="$OVER/$dstn/work"
  # PRE-MOUNT lowerdir existence assertion (fix C). build_lowers may concat
  # upper:lower with ':'-separated lowerdir segments; assert EACH exists in the
  # HOST ns (HMNT) where the mount runs. A GC'd source is the "special device
  # overlay does not exist" cause — diagnose it HERE, by name, not 3 steps later
  # as an empty-mounts JSON error. (Freeze fix B rewrites opts to a preserved,
  # GC-safe $BUNDLE/$dstn/lower, so post-fix this should always pass; it stays as
  # the fail-closed guard for any future regression of the source-preservation.)
  local IFS=':'
  for d in $lowers; do
    HMNT test -d "$d" || { log "FATAL: $dstn overlay lowerdir missing at thaw: $d (GC'd with Pod A teardown?). mount -t overlay would ENOENT 'special device overlay does not exist' and leave rootfs unmounted -> runsc restore reads an empty mounts file -> sub rc=128. NOT a restore-internal failure."; return 1; }
  done
  unset IFS
  HMNT mkdir -p "$up" "$wk"
  HMNT umount "$BUNDLE/$dstn/rootfs" 2>/dev/null || true
  # capture the mount rc directly (the prior pipe to sed masked it with sed's rc);
  # surface the error AND fail loud so the un-mountable rootfs never reaches runsc.
  if ! HMNT mount -t overlay overlay "$BUNDLE/$dstn/rootfs" -o "lowerdir=$lowers,upperdir=$up,workdir=$wk,index=off" 2> "$OVER/$dstn.mnterr"; then
    HMNT sed "s|^|    $dstn overlay: |" "$OVER/$dstn.mnterr" >&2 2>/dev/null || true
    log "FATAL: $dstn rootfs overlay mount failed (lowerdir=$lowers) — rootfs left unmounted; runsc restore would surface the opaque empty-mounts JSON error. NOT a restore-internal failure."
    return 1
  fi
  # POST-MOUNT CWD-DENTRY assertion (ka-0000008217) — SELF-MEDIUM ONLY, gated on
  # the overlay medium (ka-0000000357, the dir-medium thaw rc=128 REGRESSION fix).
  #
  # WHAT THIS ASSERTS. The container's checkpointed process.cwd (cwd=/home/agent/
  # workspace on a real agent — an image WORKDIR served by THIS rootfs gofer, not a
  # kubelet EmptyDir, so the data-driven [3] gofer-preserve sweep structurally
  # cannot cover it) is the exact path the restored sentry's vfs.CompleteRestore()
  # 9p-walks against mount "$dstn:/" the instant it resumes.
  #
  # WHY IT MUST BE MEDIUM-GATED. This test inspects the freshly-reconstructed,
  # LOWER-ONLY rootfs overlay BEFORE any runsc restore. That is only sound under the
  # SELF/default medium, where on-node inspection (ka-0000006205) PROVED the
  # preserved freeze lower carries home/agent/workspace — so a missing dentry there
  # localizes a genuine thaw-side overlay-reconstruction loss.
  #
  # Under the DIR medium (--overlay2=root:dir, OVERLAY_FLAG non-empty) the original
  # pre-restore *fail-close* on this test was a structural FALSE-NEGATIVE (the prod
  # 2026.174.3 regression, crew pk8 canary ka-0000005316): gVisor stores the rootfs-
  # overlay UPPER in a filestore that runsc createGoferFilestoreInDir()s then
  # IMMEDIATELY unlinks (open fd only; the dir is EMPTY on disk — verified on-node
  # ka-0000007329). The runtime writes under /home/agent/workspace therefore live as
  # guest MemoryFile pages serialized by 'runsc checkpoint' into the checkpoint page
  # files (pages.img/pages_meta.img) and rebuilt by 'runsc restore', NOT carried in
  # the host IMAGE LOWER the freeze [3] 'cp -a' reads — so fail-closing because the
  # lower lacks that *content* was wrong, and the prior fix (ka-0000000357) correctly
  # REMOVED the fail-close on dir medium.
  #
  # BUT removing the guard was NECESSARY-NOT-SUFFICIENT, and the canary still rc=128'd
  # (ka-0000004935). Adversarial review of the deployed runsc (release-20260525.0)
  # source corrected the load-bearing premise: 'runsc restore' does NOT merely rebuild
  # the upper and ignore the lower. gofer.(*filesystem).CompleteRestore ->
  # restoreDescendantsRecursive -> (*dentry).restoreFile re-walks EVERY non-synthetic
  # dentry that was cached at checkpoint against the LIVE gofer LOWER, top-down. The
  # agent's process.cwd (/home/agent/workspace, an image WORKDIR served by THIS rootfs
  # gofer — mount "agent:/") is one such cached dentry, so restore re-walks it on the
  # lower; the relocated lower is MISSING /home entirely (prod forensics: proc/run/usr
  # present but bin/etc/lib/home/opt ABSENT, markers in pages.img) -> ENOENT ->
  # 'failed to walk "home/agent/workspace" of type 040000 in mount "agent:/"' ->
  # sub rc=128. This is the gofer LOWER re-walk of the dentry's existence, distinct
  # from the upper CONTENT — which is exactly why "the upper rides checkpoint.img"
  # reasoning could not make it disappear.
  #
  # So under dir medium we MATERIALIZE the empty CWD dir into the merged rootfs view
  # (below) so the re-walk resolves; the content overlays from the rebuilt upper. NB the
  # mkdir targets the mounted host-overlay mountpoint $BUNDLE/$dstn/rootfs, so the new dir
  # physically lands in the host-overlay UPPER ($OVER/$dstn/upper), NOT $BUNDLE/$dstn/lower
  # — but it is visible at the merged mountpoint the restore gofer serves as root.path,
  # which is the gofer-lower the sentry re-walk resolves against. The gardener-floated
  # "freeze-sync the dir filestore before the cp" still cannot help (the upper is an
  # unlinked fd + guest memory, and 'cp -a' reads the gofer image-lower regardless),
  # and we do NOT touch freeze step-3. Read cwd for diagnostics on either medium (it
  # is the spec runsc restore itself consumes).
  local cwd
  cwd=$(HMNT python3 -c 'import json,sys
try: print(json.load(open(sys.argv[1])).get("process",{}).get("cwd",""))
except Exception: print("")' "$BUNDLE/$dstn/config.json" 2>/dev/null)
  if [ -n "$OVERLAY_FLAG" ]; then
    # DIR MEDIUM: re-materialize the EMPTY checkpointed CWD *directory chain* into the
    # merged rootfs view so 'runsc restore' vfs.CompleteRestore can re-walk it
    # (ka-0000004935 — the REAL rc=128 fix). The mkdir below targets the mounted overlay
    # mountpoint $BUNDLE/$dstn/rootfs, so the write lands in the host-overlay UPPER
    # ($OVER/$dstn/upper), NOT $BUNDLE/$dstn/lower; it surfaces at the merged mountpoint
    # the restore gofer serves (root.path) — the gofer-lower the sentry walks against —
    # so the walk resolves regardless of which host-overlay layer physically holds it.
    # The restore re-walk needs the dentry to
    # EXIST and stat as a directory; gVisor (release-20260525.0, verified) does NOT
    # preserve/revalidate inoKey/QID across C/R (restoreFile adopts the fresh inode)
    # and applies NO size/mtime/type validation to a directory, so a same-name same-
    # TYPE mkdir is sufficient for the walk. The real content overlays from the rebuilt
    # upper (checkpoint pages); a plain mkdir carries no opaque xattr / whiteout, so it
    # cannot mask the upper. mkdir -p creates the FULL ancestor chain (restore walks
    # top-down and fails at the shallowest missing component, so /home and /home/agent
    # must exist too). Best-effort chown to the checkpointed CWD owner (default 1000 —
    # the agent image WORKDIR owner) so the resumed agent can write its workspace;
    # restore itself does not check uid. Idempotent: only mkdir when the path is
    # genuinely MISSING (a lower that already carries it is left untouched).
    #
    # rc DISCIPLINE: this is the last statement in remount_rootfs and the caller
    # fail-closes on its rc, so the block MUST end with rc 0 for the sandbox/pause
    # container (cwd=/) and any empty cwd. The outer cwd-non-empty/non-"/" if guards
    # those, and the trailing ':' pins rc 0 on every path. We do NOT fail-close here
    # on a mkdir failure (best-effort): the restore rc + the [6b] post-restore
    # NON-EMPTY liveness guard are the real backstops.
    if [ -n "$cwd" ] && [ "$cwd" != "/" ]; then
      if HMNT test -e "$BUNDLE/$dstn/rootfs/${cwd#/}"; then
        log "note: $dstn CWD '$cwd' already present in the merged rootfs view (overlay upper) under dir medium ($OVERLAY_FLAG); runsc restore re-walks it cleanly (ka-0000004935)."
      else
        cwduid=$(HMNT python3 -c 'import json,sys
try:
    u=json.load(open(sys.argv[1])).get("process",{}).get("user",{})
    print("%d:%d"%(int(u.get("uid",1000)),int(u.get("gid",1000))))
except Exception: print("1000:1000")' "$BUNDLE/$dstn/config.json" 2>/dev/null)
        [ -z "$cwduid" ] && cwduid="1000:1000"
        if HMNT mkdir -p "$BUNDLE/$dstn/rootfs/${cwd#/}" 2>/dev/null; then
          HMNT chown "$cwduid" "$BUNDLE/$dstn/rootfs/${cwd#/}" 2>/dev/null || true
          log "MATERIALIZED $dstn CWD dir '$cwd' (owner $cwduid) in the merged rootfs view (overlay upper) under dir medium ($OVERLAY_FLAG): the checkpointed process.cwd is an image WORKDIR served by the rootfs gofer, but the relocated lower lacked it, so 'runsc restore' vfs.CompleteRestore would 9p-walk '$cwd' in mount '$dstn:/' and ENOENT -> sub rc=128. Re-created the EMPTY dir chain so the gofer re-walk resolves; the workspace CONTENT overlays from the rebuilt upper (checkpoint pages). Real round-trip of that content is asserted post-restore by the [6b] non-empty liveness guard (ka-0000004935, ka-0000000357)."
        else
          log "WARN $dstn could not mkdir CWD dir '$cwd' in the merged rootfs view (overlay upper) under dir medium ($OVERLAY_FLAG) — runsc restore may 9p-walk ENOENT it (sub rc=128). NOT fail-closing here (best-effort); the restore rc + [6b] liveness guard remain the backstop."
        fi
      fi
    fi
    :
  elif [ -n "$cwd" ] && [ "$cwd" != "/" ]; then
    # SELF/DEFAULT MEDIUM: the preserved lower DOES carry the CWD (ka-0000006205).
    # The fix-C guard above only asserts the lowerdir DIRECTORY exists; this asserts
    # the CWD subpath survived the collapse-and-remount, in the HOST ns (HMNT) where
    # runsc reads the rootfs. Without it a lower that mounts clean but lacks the CWD
    # dentry rc=128's OPAQUELY as a vfs.CompleteRestore 9p-walk ENOENT. Fail LOUD, by
    # name, so the next driven-thaw canary bisects overlay-reconstruction vs Pod-B
    # rootfs-wiring instead of the opaque empty-mounts/9p-walk rc=128.
    if ! HMNT test -e "$BUNDLE/$dstn/rootfs/${cwd#/}"; then
      log "FATAL: $dstn reconstructed rootfs overlay is MISSING the container CWD dentry '$cwd' (lowerdir=$lowers) under the SELF/default overlay medium. The restored sentry's vfs.CompleteRestore() will 9p-walk '$cwd' in mount '$dstn:/' and ENOENT -> sub rc=128. Under self medium the preserved freeze lower carries this path (ka-0000006205), so its absence here localizes the loss to thaw-side overlay RECONSTRUCTION (the collapse-to-lower or this remount), NOT freeze-preserve. (Correctly SKIPPED under the dir medium, where the upper rides checkpoint.img and is rebuilt by runsc restore — ka-0000000357.) NOT a restore-internal failure."
      return 1
    fi
  fi
}
for dstn in $DSTNS; do
  # read .overlay-opts in the HOST ns (HMNT cat) — that is where freeze wrote it.
  if ! remount_rootfs "$dstn" "$(HMNT cat "$BUNDLE/$dstn/.overlay-opts" 2>/dev/null)"; then
    echo "FT_ROOT_RC=128"
    exit 1
  fi
  HMNT bash -c "rm -f $BUNDLE/$dstn/rootfs/.gvisor.filestore.* 2>/dev/null" || true
done

# [2c] PRE-CREATE the NEW agent's thaw-state hostPath (fix, bug ka-0000000673 /
# ka-0000001104). The [3] rewrite below FORCES the agent bundle's MountThawState
# mount SOURCE to $THAWDIR (the new agent's per-agent dir the controller's
# NodeRehydrationTrigger writes the marker into + polls acks from). That forced
# source must EXIST in the host ns before the [3a] dangling-source guard runs (an
# absent source is exactly what makes the sub gofer's ResolveMounts die -> empty
# --mounts-fd pipe -> the opaque sub rc=128) AND be agent-UID-writable so the
# restored coop/gb watchers can write their .done acks beside the controller's
# marker. The controller's writeMarker (freezethaw_rehydrate.go) also mkdir+chowns
# this dir, but it runs AFTER the restore — so create it HERE too, idempotently, so
# the restore-time mount has a real, writable source. HostPath DirectoryOrCreate
# semantics: a dir the kubelet/controller may have already provisioned is untouched
# (mkdir -p / chown are no-ops). SKIPPED when $THAWDIR is empty (legacy snapshot /
# older controller) so the pre-fix path carries zero blast radius.
if [ -n "$THAWDIR" ]; then
  HMNT mkdir -p "$THAWDIR" 2>/dev/null || log "WARN could not pre-create thaw-state dir $THAWDIR (the [3a] guard will fail-close if the forced source is absent)"
  # chown/chmod make the forced source agent-UID-owned + group-writable so the
  # restored coop/gb watchers (running as UID/GID 1000) can write their .done acks
  # beside the controller's marker. A SILENT failure here (read-only fs, an
  # immutable bit, or a kubelet-pre-provisioned root-owned DirectoryOrCreate dir)
  # used to be swallowed with '|| true' — leaving the dir root-owned/non-group-
  # writable so the agent's ack EACCESes through the mount and re-trips the very
  # both-consumer rehydrate fail-close ka-0000000673/ka-0000001104 targets. WARN
  # loudly on each failure instead, and PROVE writability in [2c-assert] below.
  HMNT chown 1000:1000 "$THAWDIR" 2>/dev/null || log "WARN chown 1000:1000 $THAWDIR failed — thaw-state dir may stay root-owned; the [2c-assert] agent-writability guard below fail-closes if so"
  HMNT chmod 0775 "$THAWDIR" 2>/dev/null || log "WARN chmod 0775 $THAWDIR failed — thaw-state dir may not be group-writable; the [2c-assert] agent-writability guard below fail-closes if so"
  # [2c-assert] FAIL-CLOSED agent-writability assertion (ka-0000004248). The
  # restored coop/gb watchers run as UID/GID 1000 and MUST create their .done ack
  # in $THAWDIR (the forced MountThawState source). Stat it in the HOST ns and
  # prove the agent can write: owner-writable+searchable as UID 1000, OR group-
  # writable+searchable as GID 1000, OR world-writable+searchable. If none hold,
  # the chown/chmod above silently did not take — driving the restore anyway would
  # EACCES the ack and fail-close the both-consumer rehydrate gate ~60s later as
  # an OPAQUE timeout. Diagnose it HERE, by owner/group/mode, with FT_ROOT_RC=128
  # — the same fail-loud contract the [3a] dangling-source guard uses — instead of
  # swallowing it. Runs before [3a] so a non-writable forced source fails by name,
  # not as a downstream gate timeout.
  twperm=$(HMNT python3 - "$THAWDIR" <<'PYTWPERM'
import os,stat,sys
d=sys.argv[1]
try:
    st=os.stat(d)
except OSError as e:
    print("MISSING %s"%e); sys.exit(0)
m=st.st_mode
# UID/GID 1000 can create a file in d iff it has BOTH write and execute (search)
# on d via whichever class applies: owner (uid==1000), group (gid==1000), or other.
owner_ok=st.st_uid==1000 and (m&stat.S_IWUSR) and (m&stat.S_IXUSR)
group_ok=st.st_gid==1000 and (m&stat.S_IWGRP) and (m&stat.S_IXGRP)
other_ok=(m&stat.S_IWOTH) and (m&stat.S_IXOTH)
print("OK" if (owner_ok or group_ok or other_ok)
      else "DENY uid=%d gid=%d mode=%04o"%(st.st_uid,st.st_gid,stat.S_IMODE(m)))
PYTWPERM
)
  case "$twperm" in
    OK*) log "fix ka-0000000673: pre-created + verified agent-writable thaw-state dir $THAWDIR for the MountThawState source re-point" ;;
    *)   log "FATAL: thaw-state dir $THAWDIR is NOT writable by the restored agent (UID/GID 1000) after the [2c] pre-create ($twperm). The chown 1000:1000 / chmod 0775 silently failed (read-only fs, an immutable bit, or a kubelet-pre-provisioned root-owned dir), so the restored coop/gb watchers cannot write their .done ack into the forced MountThawState source -> the ack EACCESes through the mount -> the both-consumer rehydrate gate fail-closes ~60s later as an OPAQUE timeout (ka-0000000673/ka-0000001104 regression). Diagnosed HERE by owner/group/mode, NOT as that downstream timeout. NOT a restore-internal failure."
         echo "FT_ROOT_RC=128"; exit 1 ;;
  esac
fi

# [3] normalize EACH sub-container bundle's mount DESTINATIONS /var/run/* -> /run/*
# so RestoreValidateSpec's destination set matches the symlink-resolved checkpoint,
# and repoint the GC'able sources to the preserved node-local copies + B ids.
# HMNT python3: the config.json read+rewrite must happen in the HOST ns bundle.
#
# SANDBOX-ID ANNOTATION REPOINT (fix-b, ka-0000004146). The original thaw rc=128
# SUB failure was 'cannot load sandbox: open
# /run/containerd/runsc/k8s.io/<A-sandboxCID>_sandbox:<A-sandboxCID>.state: no such
# file or directory' — the sub-container's spec still carried Pod A's
# io.kubernetes.cri.sandbox-id annotation, so runsc restore of the sub tried to
# JOIN sandbox A and load A's sandbox .state file. That .state was destroyed when
# Pod A was torn down at freeze (containerd GC'd the runsc sandbox dir). The sub
# must join Pod B's sandbox (BSB) — whose .state the [5] root restore freshly wrote
# under the controller-owned $ROOT — so rewrite EVERY annotation value that names
# the A sandbox-cid / A pod-uid over to B. (Mirrors the source rewrite below.)
# The same annotation rewrite is correct for the agent AND every sidecar (each
# carries the same A sandbox-id / A pod-uid). Mount SOURCES are repointed by
# DESTINATION to Pod B's live source (see the ka-0000004815 block below), which
# subsumes the old A->B uid substring repoint for kubelet bind sources (incl. the
# sidecars' fresh dind-storage/postgres-data emptyDirs); /work alone rides the
# preserved warm copy.
# BIND-SOURCE REPOINT BY DESTINATION (fix, ka-0000004815). The empty-mounts sub
# rc=128 ("reading mounts file: unexpected end of JSON input") is runsc's INTERNAL
# --mounts-fd os.Pipe closing EMPTY: the sub-container's gofer dies during
# ResolveMounts — walking the bind-mount SOURCES — BEFORE WriteMounts, so runsc
# ReadMounts() the empty pipe. The pause sandbox has no bind sources to walk (root
# restores fine, ROOT_RC=0); the agent sub does (sub=128) — exactly the asymmetry.
# At the real lifecycle Pod A is kubectl-deleted at freeze, so the kubelet GC's the
# whole /var/lib/kubelet/pods/<A-uid>/ tree; Pod B has a fresh uid. Repointing those
# GC'd sources A-uid->B-uid by SUBSTRING (the prior code) silently fails for any
# source path with a PER-POD-RANDOM component beyond the uid — /dev/termination-log
# (.../containers/<name>/<hex>) and the projected SA token (kube-api-access-<rand>) —
# leaving a dangling A-side source on Pod B -> the gofer dies -> empty mounts pipe.
# Pod B is the SOURCE OF TRUTH for the fresh kubelet bindings (it is still live here;
# [4] deletes it AFTER this rewrite) and was minted from the SAME pod template
# (shapePlaceholderSpec), so its mount DESTINATION set matches A's while its SOURCES
# are the correct fresh kubelet paths. So repoint each sub mount SOURCE to Pod B's
# live source for the SAME destination; keep /work -> the preserved warm copy
# ($BUNDLE/.work, which carries A's warm data B's fresh emptyDir lacks); fall back to
# the A->B substring rewrite for any destination Pod B lacks. The [3a] guard then
# fails loud on any source that still does not resolve.
for dstn in $SUBNAMES; do
# resolve Pod B's LIVE bundle config.json for this sub (runsc-state bundle field,
# then the v2 task dir) so we can read its fresh per-destination sources.
bc=$(bcid_for "$dstn")
BDIR=$(RUNSC state "$bc" 2>/dev/null | python3 -c 'import sys,json;print(json.load(sys.stdin).get("bundle",""))' 2>/dev/null)
BCFG=""
for cand in "$BDIR/config.json" "$T/$bc/config.json"; do
  HMNT test -f "$cand" && { BCFG="$cand"; break; }
done
[ -z "$BCFG" ] && log "WARN no live Pod B bundle config for sub '$dstn' (cid=$bc) — falling back to A->B substring source repoint; [3a] guard will catch any dangling source"
HMNT python3 - "$BUNDLE/$dstn/config.json" "$ASB" "$BSB" "$APOD" "$BPODUID" "$BUNDLE" "$BCFG" "$THAWDIR" "$THAWDEST" <<'PYAGENT'
import json,sys
p,asb,bsb,apod,bpod,bundle,bcfg,thawdir,thawdest=sys.argv[1:10]
c=json.load(open(p))
# build a destination->source map from Pod B's LIVE bundle. Normalize B's mount
# destinations the same way (/var/run -> /run) so the keys line up with the
# checkpoint-resolved destinations we rewrite the A bundle to.
bsrc={}
if bcfg:
    try:
        b=json.load(open(bcfg))
        for m in b.get("mounts",[]):
            d=m.get("destination","")
            if d.startswith("/var/run/"): d="/run/"+d[len("/var/run/"):]
            if d: bsrc[d]=m.get("source","")
    except Exception:
        bsrc={}
