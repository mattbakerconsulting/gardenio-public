            # whose kubernetes.io.pod.uid is Pod A's; coop's freshness_gate HARD-rejects a
            # mismatched pod_uid with FreshnessError::PodAIdentity at Sequence stage A.
            # KEEP the warm DIR as the source (so the restore 9p walk finds the runtime
            # subtree -> no rc=128) but OVERLAY Pod B's LIVE token bytes onto the file coop
            # re-reads, so the gate takes the honest pod_uid==want_uid arm. Pod B is alive
            # until [4], so bsrc[d]/token is a FRESH Pod-B token; realpath resolves it
            # through the kubelet atomic-writer ..data/token layout, and we overlay BOTH
            # token AND ..data/token (same backing file via the preserved symlink).
            # Best-effort/idempotent: a copy miss must NOT fail thaw (the warm dir still
            # resolves; [3a] asserts it). NOT a gate-loosen: we serve the ACTUAL fresh
            # Pod-B token, so a genuine foreign/stale token still fails closed.
            #
            # RESTORE-SAFETY ASSUMPTION PIN (ka-0000005326 nit 3). Overwriting a
            # regular-file token in the warm copy is invisible to 'runsc restore' ONLY
            # because the deployed runsc release-20260525.0 constructs an EMPTY
            # &vfs.CompleteRestoreOptions{} -> ValidateFileSizes / ValidateFileModifi-
            # cationTimestamps default false -> the gofer restore re-walk validates a
            # dentry's EXISTENCE + TYPE, never re-stats size/mtime against the checkpoint.
            # Pod-A and Pod-B JWTs differ in length, so a size-validating restore WOULD
            # rc=128 on this overlay. If a future runsc bump flips ValidateFileSizes on,
            # RE-REVIEW this byte-overlay (the [3a-tok]/rehydrate gates would surface it as
            # a fresh rc=128 / coop fail-close, but pin the assumption here so the bump
            # triggers the review rather than a canary burn).
            if d in bsrc and bsrc[d]:
                try:
                    _live=_os.path.realpath(_os.path.join(bsrc[d],"token"))
                    if _os.path.isfile(_live):
                        _tok=open(_live,"rb").read()
                        # EMPTY-TOKEN GUARD (ka-0000005326 nit 2). _tok is whatever
                        # realpath(bsrc[d]/token) yields at read time; if the kubelet
                        # atomic-writer is mid ..data-swap and the resolved file is
                        # momentarily zero-length, an unconditional write would TRUNCATE
                        # a previously-valid warm token to b"" (coop then rejects the
                        # empty token as FreshnessError::Malformed -> a wasted operator-
                        # gated canary cycle). Skip the overlay on an empty read and let
                        # the warm copy stand; the [3a-tok] read-probe still guards it.
                        if _tok:
                            # ATOMIC TOKEN WRITE (ka-0000005326 nit 1). Write to a temp
                            # file on the SAME dir (fs) then os.rename over the target, so
                            # a write interrupted mid-flush (ENOSPC/EIO) never leaves a
                            # TRUNCATED JWT the restored coop would reject as Malformed —
                            # the overlay is all-or-nothing. _atomic_overlay follows the
                            # realpath first so the rename lands on the actual backing file
                            # (through the atomic-writer token -> ..data/token symlink
                            # chain), matching the chown/chmod below.
                            _atomic_overlay(_os.path.join(_warm,"token"),_tok)
                        _dd=_os.path.join(_warm,"..data","token")
                        if _tok and _os.path.isfile(_dd): _atomic_overlay(_dd,_tok)
                        # TOKEN-OWNERSHIP RESTORE (fix, bug ka-0000000189). The freeze
                        # warm-copy (shutil.copytree as ROOT; copy2/copystat preserve MODE
                        # but NEVER uid/gid) RESET the projected token's GROUP from agent
                        # (GID 1000) to root, and the cred-overlay open().write() above keeps
                        # that root:root ownership (it rewrites BYTES, not owner). The
                        # restored UID/GID-1000 coop then EACCESes the bound token read (mode
                        # 0640: agent is neither owner=root nor group=root, falls to OTHER=---)
                        # -> FreshnessError::Malformed -> NodeRehydrationTrigger.waitForAcks
                        # fail-closes 'failed consumers: coop' (node-confirmed prod 181.5; the
                        # NEW coop-only signature first reachable once the forced-source +
                        # overlay makes coop's token READ actually execute). The maintainers'
                        # own [2c] block already chowns the ack dir the agent WRITES through
                        # the gofer 1000:1000 for exactly this FSGroup-1000 hazard; this is the
                        # missing READ-side mirror. chown the REAL backing file: os.path.realpath
                        # follows the atomic-writer chain token -> ..data/token -> ..<ts>/token,
                        # so the ..<ts>/token the empirical evidence shows root:root is the one
                        # re-owned (chown over the realpath FOLLOWS the symlink, so the backing
                        # file gains the new group, not the link itself). 1000:1000 is the kubelet
                        # root:agent grant's simplest sufficient superset (agent then reads as
                        # OWNER). Defensively re-assert the 0640 read bits (the copy already
                        # preserved them, but a belt-and-suspenders OR-in guarantees owner+group
                        # read survive any mode drift). SCOPE: ONLY the two _SA_TOKEN_DIRS warm
                        # copies reach here; the ka-0000006427 ~/.claude warm trees take the
                        # generic gofer warm-copy branch further below and stay agent-owned-as-
                        # copied, untouched. Relative ..data/..<ts> symlinks keep realpath INSIDE
                        # _warm, so the chown never escapes the token warm copy. Best-effort/
                        # idempotent: a chown miss must NOT fail thaw -- the [3a-tok] UID-1000
                        # read-probe below is the durable fail-loud guard.
                        for _wt in (_os.path.join(_warm,"token"), _dd):
                            try:
                                _rp=_os.path.realpath(_wt)
                                if _os.path.isfile(_rp):
                                    _os.chown(_rp,1000,1000)
                                    _os.chmod(_rp,_os.stat(_rp).st_mode|0o640)
                            except OSError:
                                pass
                except Exception:
                    pass
        # NO else-bind: when the token dir is NOT in the gofer manifest there is NO stable
        # controller-owned source to point at. Leave m["source"] as the frozen Pod-A value
        # (GC'd at freeze) so the [3a] dangling-source guard fails LOUD by name (rc=128)
        # rather than silently binding to bsrc[d] (the ephemeral Pod-B dir [4] removes ->
        # the opaque restored-sandbox ENOENT) or the A->B substring rewrite (dangling).
    elif d=="/work":
        # the warm /work copy — B's fresh emptyDir would wake the agent into empty data.
        m["source"]=bundle+"/.work"
    elif d=="/tmp":
        # the preserved /tmp gofer tree (ka-0000001085). B's fresh /tmp EmptyDir is
        # empty, so the restored sentry's vfs.CompleteRestore 9p walk for the
        # runtime-created /tmp/claude-1000 would ENOENT -> sub rc=128. Repoint to
        # the freeze-time copy that carries claude-1000, mirroring /work.
        m["source"]=bundle+"/.tmp"
    elif d in gofer:
        # the data-driven warm copy (ka-0000006427): a runtime-populated 9p gofer
        # EmptyDir/subPath (e.g. /home/agent/.claude). B's fresh empty dir would
        # ENOENT the vfs.CompleteRestore 9p walk for the runtime subtree -> sub
        # rc=128. Repoint to the freeze-time copy, generalizing the /work + /tmp
        # cases above to the whole mount class. (The two SA/IRSA token dirs are
        # handled by the dedicated _SA_TOKEN_DIRS forced branch ABOVE — including
        # their warm-copy bind + cred-overlay — so they never reach here.)
        _warm=bundle+"/.gofer/"+gofer[d]
        m["source"]=_warm
    elif d in bsrc and bsrc[d]:
