    # path resolves to, all-or-nothing. Follow the atomic-writer symlink chain to
    # the REAL backing file first (so the rename lands on it, not on a link), write a
    # temp file in the SAME dir (same fs -> rename is atomic), fsync it durable, then
    # os.rename over the target. A write interrupted mid-flush (ENOSPC/EIO) leaves the
    # temp file, never a truncated backing token — the restored coop reads either the
    # old or the full new token, never a half JWT (which it would reject as Malformed).
    import tempfile
    rp=_os.path.realpath(path)
    d=_os.path.dirname(rp)
    fd,tmp=tempfile.mkstemp(dir=d,prefix=".tok.")
    try:
        _os.write(fd,data)
        _os.fsync(fd)
    finally:
        _os.close(fd)
    _os.rename(tmp,rp)
gofer={}
try:
    _raw=json.load(open(_os.path.join(bundle,".gofer","manifest.json")))
    # NORMALIZE the manifest keys the same /var/run -> /run way the mount
    # destinations are normalized below, and KEY BOTH FORMS, so the 'd in gofer'
    # lookup hits regardless of which form the freeze-side manifest recorded
    # (ka-0000007745). THE GAP this closes: the freeze sweep (PYGOFER) keys the
    # warm-copy manifest by the RAW OCI destination — e.g. the EKS projected SA
    # token at /var/run/secrets/eks.amazonaws.com/serviceaccount — but the loop
    # below normalizes 'd' to /run/secrets/... BEFORE the 'd in gofer' test, so a
    # raw /var/run key NEVER matched. The warm copy was silently skipped and the
    # loop fell through to bsrc[d] (Pod B's FRESH EMPTY projected-token dir). The
    # restored sentry's vfs.CompleteRestore 9p walk for the runtime subtree under
    # that mount then ENOENTs -> the agent sub gofer dies in ResolveMounts BEFORE
    # WriteMounts -> runsc's internal --mounts-fd os.Pipe closes EMPTY -> the
    # opaque "reading mounts file: unexpected end of JSON input" agent sub rc=128
    # (root restores clean / ROOT_RC=0 — the pause sandbox has no such 9p tree).
    # [3a]'s os.path.exists guard could not catch it: Pod B's fresh dir EXISTS, so
    # the source root resolves; only the DEEP 9p walk of the checkpoint subtree
    # fails. Keying both forms HERE (not only at freeze) also lets a snapshot
    # frozen by an older controller thaw correctly.
    for _k,_v in _raw.items():
        gofer[_k]=_v
        if _k.startswith("/var/run/"): gofer["/run/"+_k[len("/var/run/"):]]=_v
        elif _k.startswith("/run/"):   gofer["/var/run/"+_k[len("/run/"):]]=_v
except Exception:
    gofer={}
# repoint the CRI annotations that name the sandbox the sub joins, so the restored
# sub loads Pod B's sandbox .state (BSB) and not Pod A's GC'd one.
ann=c.get("annotations",{})
for k,v in list(ann.items()):
    if asb and asb in v: ann[k]=v.replace(asb,bsb).replace(apod,bpod) if apod else v.replace(asb,bsb)
    elif apod and apod in v: ann[k]=v.replace(apod,bpod)
# SA/IRSA TOKEN MOUNT ALLOWLIST (ka-0000004956 overlay + ka-0000008074 forced source).
# The TWO projected serviceaccount token mount destinations (normalized /run/... form,
# since 'd' is normalized below before the lookups). These get their OWN forced-source
# branch below (highest precedence after the thaw-state force): they bind ONLY to the
# stable controller-owned warm copy, never the ephemeral live-Pod-B source — and their
# warm copy is byte-overlaid with Pod B's live token. The set is also the overlay
# allowlist: a blanket overlay would clobber the /home/agent/.claude etc. warm trees
# and reintroduce ka-0000006427.
_SA_TOKEN_DIRS={"/run/secrets/eks.amazonaws.com/serviceaccount","/run/secrets/kubernetes.io/serviceaccount"}
for m in c.get("mounts",[]):
    d=m.get("destination","")
    if d.startswith("/var/run/"):
        m["destination"]="/run/"+d[len("/var/run/"):]
        d=m["destination"]
    s=m.get("source","")
    if thawdir and d==thawdest:
        # THAW-STATE SOURCE RE-POINT (fix, bug ka-0000000673 / ka-0000001104). HIGHEST
        # precedence — overrides the bsrc[d] live-Pod-B branch below. The thaw-state
        # hostPath (MountThawState=/run/gardenio-thaw) is the C5 rehydrate rendezvous:
        # the controller's NodeRehydrationTrigger writes the epoch marker into + polls
        # the consumer .done acks from thawStateHostDir(<NEW agent>) on the node, and
        # the restored coop/gb watchers read the marker + write their acks through this
        # mount. On the warm-B graft path Pod B is a pool placeholder minted from a
        # DIFFERENT agent's snapshot template (shapePlaceholderSpec), so bsrc[d] (Pod
        # B's LIVE source) is thawStateHostDir(<placeholder-template-agent>) — and the
        # checkpointed agent bundle carries thawStateHostDir(<frozen agent>). BOTH are
        # the WRONG dir: the restored watchers ack into a stale thaw-state the
        # controller never polls -> guaranteed both-consumer fail-close every cycle
        # (instrumented canary #7, prod 2026.180.27). Only the controller knows the new
        # agent's identity, so it threads thawStateHostDir(req.AgentName) in as $THAWDIR
        # and we FORCE the source here, overriding every live/warm/substring branch.
        # The node pre-created + chowned $THAWDIR at [2c], so the forced source resolves
        # (the [3a] guard passes) and is agent-writable for the ack. Unlike the
        # ka-0000006427 EmptyDir mounts, the thaw-state dir holds only poll-loop marker/
        # ack/armed files (no deep runtime subtree the checkpoint cached a dentry for),
        # and canary #7 restored rc=0 with this mount pointed at the placeholder's
        # different-content dir — proving vfs.CompleteRestore re-walks only the
        # mountpoint, not the contents — so re-pointing to the new agent's fresh dir is
        # restore-safe. EMPTY $thawdir (legacy snapshot / older controller) SKIPS this
        # branch and the rewrite falls through to the pre-fix bsrc[d] behavior.
        m["source"]=thawdir
    elif d in _SA_TOKEN_DIRS:
