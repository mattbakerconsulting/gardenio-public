        # per-pod-random path components the substring rewrite cannot fix.
        m["source"]=bsrc[d]
    elif asb and asb in s: m["source"]=s.replace(asb,bsb).replace(apod,bpod)
    elif apod and apod in s: m["source"]=s.replace(apod,bpod)
json.dump(c,open(p,"w"))
PYAGENT
done

# [3a] FAIL-CLOSED bind-source existence assertion (ka-0000004815). Every sub
# mount SOURCE must resolve in the HOST ns BEFORE any runsc restore — a dangling
# source is precisely what makes the sub gofer's ResolveMounts die before
# WriteMounts, closing runsc's internal --mounts-fd pipe EMPTY and surfacing the
# opaque "reading mounts file: unexpected end of JSON input" sub rc=128. Diagnose
# it HERE, by destination<-source, instead of letting it manifest as the opaque
# empty-mounts error one step later. Only absolute-path sources are bind mounts;
# pseudo-fs sources (proc/tmpfs/sysfs/mqueue/devpts/cgroup) are bare names, skipped.
# Run in the HOST ns (HMNT) where runsc reads the spec and the gofer walks.
for dstn in $SUBNAMES; do
  miss=$(HMNT python3 - "$BUNDLE/$dstn/config.json" <<'PYCHK'
import json,os,sys
c=json.load(open(sys.argv[1]))
for m in c.get("mounts",[]):
    s=m.get("source","")
    if s.startswith("/") and not os.path.exists(s):
        print(m.get("destination","?")+" <- "+s)
PYCHK
)
  if [ -n "$miss" ]; then
    log "FATAL: sub '$dstn' has dangling bind-mount source(s) after the A->B repoint (Pod B live source not found and the uid+random substring repoint could not resolve them). The sub gofer's ResolveMounts would die on these -> runsc's internal --mounts-fd pipe closes EMPTY -> the opaque 'reading mounts file: unexpected end of JSON input' sub rc=128. NOT a restore-internal failure. Dangling destination<-source:"
    printf '%s\n' "$miss" | while IFS= read -r ln; do log "  $ln"; done
    echo "FT_ROOT_RC=128"
    exit 1
  fi
done

# [3a-tok] FAIL-CLOSED SA/IRSA token READABILITY assertion (fix, bug ka-0000000189).
# The READ-side mirror of the [2c-assert] guard that proves the agent can WRITE its
# .done ack dir. The freeze warm-copy (shutil.copytree as ROOT; copy2/copystat preserve
# MODE but NEVER uid/gid) RESET the projected token's GROUP from agent (GID 1000) to
# root, and the cred-overlay open().write() rewrites BYTES not owner — so without the
# overlay chown above the backing token stays root:root 0640. The restored UID/GID-1000
# coop then EACCESes the bound token read (agent is neither owner=root nor group=root ->
# falls to OTHER=--- ) -> FreshnessError::Malformed -> NodeRehydrationTrigger.waitForAcks
# fail-closes 'failed consumers: coop' ~60s later as an OPAQUE timeout (the prod-181.5
# canary-#8 signature; budget is DefaultRehydrateDeadline=60s, NOT 180s, ka-0000005354).
# The overlay chown restores the agent's read grant; THIS probe is the durable guard that
# the chown actually took. Stat each _SA_TOKEN_DIRS mount's REAL backing token in the
# HOST ns (realpath follows the atomic-writer token -> ..data/token -> ..<ts>/token chain
# to the file coop actually reads) and prove UID/GID-1000 can read it: owner-read as uid
# 1000, OR group-read as gid 1000, OR other-read. If none hold (the chown silently did not
# take: cross-fs, an immutable bit, a realpath that escaped the warm copy), emit
# FT_ROOT_RC=128 + a named line and FAIL LOUD HERE, by owner/group/mode -- exactly the
# fail-loud contract [3a] and [2c-assert] use -- instead of letting it manifest as the
# downstream coop-only rehydrate timeout, closing the read/write asymmetry. SCOPE: fires
# ONLY on the two _SA_TOKEN_DIRS destinations (the only mounts the kubelet projects
# root:agent and the copytree's group-drop breaks); every other mount -- incl. the
# ka-0000006427 ~/.claude warm trees -- is skipped. Runs AFTER [3a] (so the token mount
# source dir already resolves) and BEFORE the restore (so the agent never reads an
# unreadable token).
#
# It ALSO asserts DIRECTORY TRAVERSAL (fix, bug ka-0000000537). Reading the backing token
# requires SEARCH (x) permission on every intermediate directory the restored UID/GID-1000
# agent walks: the mount-source dir itself AND the kubelet atomic-writer ..<ts>/ dir the
# realpath chain passes through. PART 1 chowns only the backing FILE, not these dirs; and
# this probe runs as ROOT in the host ns, where root traverses ANY dir regardless of x-bit
# -- so a file-mode-only verdict would see the token as readable while the restored uid-1000
# agent EACCESes the dir walk. coop's gate_token (rehydrate.rs) maps a directory-traversal
# PermissionDenied to FreshnessError::Malformed IDENTICALLY to a file-read EACCES, so a dir-x
# gap would be INVISIBLE here and present as the SAME opaque coop-only 60s timeout. Today the
# warm ..<ts>/ dir is 0755 (kubelet newTimestampDir + copytree copystat preserve it), so the
# other-x bit keeps uid-1000 traversal alive; this probe makes that invariant an explicit,
# diagnosed fail-close rather than a silent dependency on a kubelet/copytree detail.
for dstn in $SUBNAMES; do
  tokbad=$(HMNT python3 - "$BUNDLE/$dstn/config.json" <<'PYTOKRD'
import json,os,stat,sys
_SA={"/run/secrets/eks.amazonaws.com/serviceaccount","/run/secrets/kubernetes.io/serviceaccount"}
# xtrav1000: can UID/GID 1000 SEARCH (traverse) dir st, by the FIRST matching POSIX class?
# Owner is checked iff uid==1000; else group iff gid==1000; else other. The classes are
# first-match, NOT a union: an owner-without-x dir denies traversal even when other-x is set
# (POSIX-verified) -- so this must short-circuit on the owning class, unlike the file-read
# verdict's owner-OR-group-OR-other form below.
def xtrav1000(st):
    md=st.st_mode
    if st.st_uid==1000: return bool(md&stat.S_IXUSR)
    if st.st_gid==1000: return bool(md&stat.S_IXGRP)
    return bool(md&stat.S_IXOTH)
c=json.load(open(sys.argv[1]))
for m in c.get("mounts",[]):
    d=m.get("destination","")
    if d not in _SA: continue
    src=m.get("source","")
    if not src.startswith("/"): continue
    # realpath follows the kubelet atomic-writer symlink chain to the backing file
    # the restored coop actually reads -- the file the empirical evidence shows root:root.
    tok=os.path.realpath(os.path.join(src,"token"))
    try:
        st=os.stat(tok)
    except OSError as e:
        print("%s token MISSING (%s)"%(d,e)); continue
    md=st.st_mode
    # UID/GID 1000 can READ tok iff it has the read bit via whichever class applies:
    # owner (uid==1000), group (gid==1000), or other. Mirrors [2c-assert]'s classifier.
    owner_ok=st.st_uid==1000 and (md&stat.S_IRUSR)
    group_ok=st.st_gid==1000 and (md&stat.S_IRGRP)
    other_ok=md&stat.S_IROTH
    if not (owner_ok or group_ok or other_ok):
        print("%s token UNREADABLE by uid/gid 1000 uid=%d gid=%d mode=%04o (%s)"%(
            d,st.st_uid,st.st_gid,stat.S_IMODE(md),tok))
        continue
    # DIR TRAVERSAL (bug ka-0000000537): reading tok also needs SEARCH (x) on every dir
    # between the resolved mount-source root and the backing file -- chiefly the kubelet
    # atomic-writer ..<ts>/ dir the realpath chain passes through, which PART 1 does NOT
    # chown. We run as ROOT (traverses any dir), so a file-only verdict would MISS a dir-x
    # gap that EACCESes the restored uid-1000 agent's walk -> the SAME coop Malformed timeout.
    # Walk realpath(src) (already symlink-free) down to tok's parent, asserting x by class.
    srcroot=os.path.realpath(src)
    rel=os.path.relpath(os.path.dirname(tok),srcroot)
    chain=[srcroot]
    if rel not in (".",""):
        acc=srcroot
        for part in rel.split(os.sep):
            if part=="..":  # realpath kept us inside the warm copy; a .. is unexpected -> stop
                break
            acc=os.path.join(acc,part); chain.append(acc)
    for dpth in chain:
        try:
            dst=os.stat(dpth)
        except OSError as e:
            print("%s token-dir MISSING (%s)"%(d,e)); break
        if not stat.S_ISDIR(dst.st_mode): continue
        if not xtrav1000(dst):
            print("%s token-dir UN-TRAVERSABLE by uid/gid 1000 uid=%d gid=%d mode=%04o (%s) -> the restored agent EACCESes the dir walk to the backing token (coop FreshnessError::Malformed, same opaque timeout as an unreadable file)"%(
                d,dst.st_uid,dst.st_gid,stat.S_IMODE(dst.st_mode),dpth))
            break
PYTOKRD
)
  if [ -n "$tokbad" ]; then
    log "FATAL: sub '$dstn' SA/IRSA token NOT readable/traversable by the restored agent (UID/GID 1000) after the cred-overlay chown (bug ka-0000000189 / ka-0000000537). The freeze copytree reset the projected token GROUP agent->root and the overlay chown to 1000:1000 silently did not take, OR an intermediate ..<ts>/ token dir lacks the search (x) bit for uid/gid 1000, so coop EACCESes the bound token read or its dir walk -> FreshnessError::Malformed -> the rehydrate gate fail-closes 'failed consumers: coop' ~60s later as an OPAQUE timeout. Diagnosed HERE, by owner/group/mode, NOT as that downstream coop-only timeout. NOT a restore-internal failure. Unreadable/un-traversable/missing token path(s):"
    printf '%s\n' "$tokbad" | while IFS= read -r ln; do log "  $ln"; done
    echo "FT_ROOT_RC=128"
    exit 1
  fi
done

# repoint the sandbox bundle: A-sandbox-cid->B / A-pod-uid->B in every mount
# source + CRI annotation, and the network namespace path -> Pod B's fresh CNI
# netns ($BNETNS_PATH, fail-closed-resolved at [1]). HMNT python3 again so the
# rewrite lands on the host-ns bundle runsc restore reads. The netns repoint is
# now UNCONDITIONAL on a resolved path (the script already bailed at [1] if it was
# empty) and ASSERTS a network namespace entry exists to repoint — a sandbox spec
# with no netns to point at B is a torn-down-netns restore waiting to rc=128, so
# fail loud rather than silently restoring against Pod A's dead path.
HMNT python3 - "$BUNDLE/sandbox/config.json" "$ASB" "$BSB" "$APOD" "$BPODUID" "$BNETNS_PATH" <<'PYSANDBOX'
import json,sys
p,asb,bsb,apod,bpod,bnetns=sys.argv[1:7]
c=json.load(open(p))
repointed=False
for n in c.get("linux",{}).get("namespaces",[]):
    if n.get("type")=="network":
        n["path"]=bnetns; repointed=True
if not repointed:
    sys.stderr.write("FATAL: sandbox spec has no network namespace to repoint to Pod B\n")
    sys.exit(3)
ann=c.get("annotations",{})
for k,v in list(ann.items()):
    if asb and asb in v: ann[k]=v.replace(asb,bsb).replace(apod,bpod) if apod else v.replace(asb,bsb)
    elif apod and apod in v: ann[k]=v.replace(apod,bpod)
for m in c.get("mounts",[]):
    s=m.get("source","")
    if asb and asb in s: m["source"]=s.replace(asb,bsb).replace(apod,bpod)
    elif apod and apod in s: m["source"]=s.replace(apod,bpod)
json.dump(c,open(p,"w"))
PYSANDBOX
if [ "$?" -ne 0 ]; then
  log "FATAL: sandbox config.json netns repoint failed (no network namespace in spec) — refusing a dead-netns restore"
  echo "FT_ROOT_RC=128"
  exit 1
fi

# [4-pre] EXTRA netns bind-mount ref (bug ka-0000002907). Hold a SECOND, independent
# bind-mount of the restore-target netns inode on a distinct controller-owned path
# BEFORE the [4] force-delete below fires the kubelet's induced CNI DEL. On canary
# fr84 the kubelet's 'ip netns delete cni-<B>' (umount + unlink of ITS OWN path)
# raced the graft and the netns was GONE by restore time, so runsc restore could
# not setns into it and fell back to an ANONYMOUS lo-only netns. PINNED_NETNS ([1])
# already holds one ref; a SECOND ref makes it strictly harder for any single umount
# to release the inode, so the restore still setns-es into the SAME eth0-carrying
# namespace. This is INODE-SURVIVAL hardening only — a bind-mount keeps the namespace
# alive but does NOT freeze its L3 config, so it does not by itself stop a CNI DEL
# from re-stripping addr/route; the LOAD-BEARING pre-restore routability verdict at
# [4b] is what fails-closed if L3 is missing at scrape time. Best-effort (|| true):
# a failed extra pin leaves PINNED_NETNS as the sole ref (pre-fix behavior).
# HELD_NETNS is set to the pin path ONLY on a successful bind-mount, so the cleanup
# guard ([ -n "$HELD_NETNS" ]) is exact — a failed pin leaves it empty and reaps any
# stray touched file here so nothing leaks.
HELD_NETNS=""
_held_cand="/var/run/netns/gb-thaw-hold-$BSB"
if HMNT test -e "$BNETNS_PATH" \
   && HMNT touch "$_held_cand" 2>/dev/null \
   && HMNT mount --bind "$BNETNS_PATH" "$_held_cand" 2>/dev/null; then
  HELD_NETNS="$_held_cand"
  log "held EXTRA netns ref $BNETNS_PATH -> $HELD_NETNS (survives the kubelet's induced CNI DEL of its own cni-<B> path)"
  echo "FT_NETNS_HELD=$HELD_NETNS"
else
  HMNT rm -f "$_held_cand" 2>/dev/null || true
  log "WARN could not hold extra netns ref $_held_cand (proceeding with PINNED_NETNS as sole ref; the [4b] load-bearing routability verdict still fails-closed if the restore lands link-only)"
  echo "FT_NETNS_HELD="
fi

# [4] tear down B's live original containers so the cids+sentry are free for the
# restore (we restore into B's bundle ids in place). Delete every sub-container
# first, then the sandbox root. This is what triggers the kubelet's async CNI DEL;
# the [4-pre] extra ref keeps the netns inode alive and the [4b] verdict below is
# load-bearing against any L3 re-strip the DEL lands before the restore scrape.
for cn in $SUBNAMES; do RUNSC delete --force "$(bcid_for "$cn")" >/dev/null 2>&1 || true; done
RUNSC delete --force "$BSB" >/dev/null 2>&1 || true
sleep 1

# L3 RE-ASSERT, pre-restore (fix B, ka-0000001790). The force-deletes above fired the
# AWS VPC CNI DEL, which strips the IPv4 addr + routes from the (inode-pinned, eth0-
# carrying) netns — proven by b4a on-node forensics. Re-apply the L3 we captured at the
# Fix-C gate so 'runsc restore' below inherits a FULLY-routable netns instead of the
# link-only one Fix A would otherwise reject. The CNI DEL is the kubelet's reaction to
# the sandbox death and may still be in flight asynchronously, so we re-assert AGAIN
# post-restore in [6a]; this pre-restore apply is what the restored sentry sees at boot.
reassert_l3 "$BNETNS_PATH"
log "fix-B pre-restore L3 re-assert into pinned netns $BNETNS_PATH complete"

# SELF-IPAM, pre-restore (fix D, ka-0000004088). The MISSING half of fix C. gVisor's
# 'runsc restore' does NOT reload the sentry netstack from the checkpoint image: per
# runsc/sandbox/sandbox.go the restore path runs setupNetwork() — which SCRAPES the
# LIVE netns (addrs + routes) into a FRESH netstack and strips them off the NIC,
# exactly like StartRoot — BEFORE the ContMgrRestore RPC, and runsc/boot/restore.go's
# createNetworkStackForRestore() then KEEPS that freshly-scraped live stack and
# discards the checkpoint's ("slap [it] on top of the one that was restored"). So the
# netns MUST already carry eth0 + IP + default route AT RESTORE TIME, or the sentry
# netstack comes up link-only and every in-sandbox egress is network-unreachable.
#
# Fix C's self_ipam runs only POST-restore ([6a], /proc/<RPID>/ns/net) — it repopulates
# the HOST-KERNEL netns view (why the [6a] content assertion goes green) but lands AFTER
# gVisor already scraped the link-only netns into the sentry, so it never reaches the
# already-built sentry netstack. That is the hny rehydrate-ack frontier: host L3 proven
# perfect on-node, yet BOTH coop (NATS) and gb (DNS) fail "network is unreachable" inside
# the restored sentry for the full 60s deadline. The pre-restore reassert_l3 above does
# NOT close it either: it replays only CAP_ADDRS/CAP_ROUTES captured from $BNETNS_PATH
# (the sandbox netns), which is EMPTY under the two-inode split (the AWS VPC CNI put the
# IP in the PAUSE netns). self_ipam is the inode-decoupled populator (committed CNI result
# IP, no source netns) — so drive it HERE, into the SAME pinned restore-target netns the
# spec's network-namespace path points at and gVisor setns-es into, so gVisor's own
# setupNetwork scrapes a fully-routable netns into the sentry netstack. Idempotent + best-
# effort (EEXIST swallowed) so the post-restore self_ipam at [6a] remains a harmless
# last-write-wins re-apply against any late async CNI DEL. No-op when CNI was unconfirmed.
self_ipam "$BNETNS_PATH"
log "fix-D pre-restore self-IPAM into pinned netns $BNETNS_PATH complete (pod IP '$CNI_POD_IP' via gw $CNI_GW) — gVisor setupNetwork will scrape this into the restored sentry netstack"

# [4b] FINAL pre-restore routability RE-VERIFY + RE-APPLY (fix A, ka-0000008207).
# The reassert_l3 + self_ipam above run RIGHT AFTER the [4] force-delete, but the
# kubelet's CNI DEL (its async reaction to the sandbox death) can still be IN FLIGHT
# and land a SECOND strip in the window between those applies and the moment the
# backgrounded 'runsc restore' below detaches and its setupNetwork() SCRAPES the
# netns into the sentry netstack (the two-inode pause-vs-sandbox split, lines ~1690-
# 1700 below: the AWS VPC CNI/DEL operates the PAUSE inode, our pin targets the
# SANDBOX inode). On prod .13 (bug ka-0000000514) the restore "verified" rc=0 but the
# sentry came up LINK-ONLY and BOTH rehydrate consumers failed network-unreachable
# for the full 60s — because nothing re-asserted routability in this last-few-hundred-
# ms window, and the post-restore [6a] apply lands AFTER the scrape (too late to reach
# the already-built sentry netstack). So: probe the SAME pinned restore-target inode
# the spec's network-namespace path points at, the instant before launching restore,
# and if it is NOT routable (a late DEL re-stripped it) re-apply L3 + self_ipam ONE
# more time, then probe again. Best-effort + idempotent (EEXIST swallowed): a netns
# already routable is a single cheap probe + no-op. FT_NETNS_PRERESTORE_ROUTABLE
# records the outcome (yes => the sentry will scrape a routable netns; no => a deeper
# strip the [6a]/[6c] guards will fail-close on). This does NOT replace [6a]/[6c] —
# it makes the routable-at-scrape-time outcome the COMMON case instead of a race.
PRERESTORE_ROUTABLE=no
if netns_routable "$BNETNS_PATH"; then
  PRERESTORE_ROUTABLE=yes
else
  log "fix-A: restore-target netns $BNETNS_PATH NOT routable just before restore (a late kubelet CNI DEL re-stripped the addr/route after the pre-restore apply) — re-applying L3 + self-IPAM once more into the SAME pinned inode gVisor setupNetwork will scrape"
  reassert_l3 "$BNETNS_PATH"
  self_ipam "$BNETNS_PATH"
  netns_routable "$BNETNS_PATH" && PRERESTORE_ROUTABLE=yes
fi
echo "FT_NETNS_PRERESTORE_ROUTABLE=$PRERESTORE_ROUTABLE"
if [ "$PRERESTORE_ROUTABLE" = yes ]; then
  log "fix-A: restore-target netns $BNETNS_PATH is ROUTABLE at restore time (global IPv4 + default route) — gVisor setupNetwork will scrape a routable netns into the sentry netstack"
else
  # LOAD-BEARING verdict (bug ka-0000002907). This branch used to WARN-and-PROCEED,
  # letting runsc restore scrape a link-only netns into the sentry and rely on the
  # downstream [6c] guards — which flaked OPEN on canary #11, so a routeless sentry
  # was mis-declared "restore verified" and died 60s later on the rehydrate ack gate.
  # A netns that is NOT routable at scrape time can ONLY yield a link-only sentry (the
  # post-restore self_ipam repairs only the host-kernel view, never the already-built
  # sentry netstack). So FAIL-CLOSED HERE, before the scrape: a clean cold-start is
  # strictly better than resurrecting a sentry that cannot egress for its whole life.
  # Do NOT add another L3 re-apply here — the re-apply-vs-DEL race lost 4x running
  # (fr84 -> hmsMrE3zR6 -> #10 -> #11); the fix is to REFUSE the link-only scrape.
  log "FATAL fix-A: restore-target netns $BNETNS_PATH is NOT routable after the final re-apply (a late kubelet CNI DEL re-stripped the addr/route in the window before the restore scrape) — gVisor setupNetwork would scrape a LINK-ONLY netns into the sentry and every off-link egress would fail network-unreachable for the full 60s ack deadline. Refusing to scrape a link-only netns; failing the restore LOUD here for a clean cold-start instead of a verified-but-network-less resume. NOT declaring restore verified."
  # Release the [4-pre] extra netns ref before the fail-close cold-start (no restore
  # will run, so nothing needs the inode held any longer) — avoid a per-fail mount leak.
  if [ -n "${HELD_NETNS:-}" ]; then HMNT umount "$HELD_NETNS" 2>/dev/null && HMNT rm -f "$HELD_NETNS" 2>/dev/null || true; fi
  echo "FT_ROOT_RC=128"
  exit 1
fi

# [5] COUNT-GATED BARRIER restore (N-container, ka-0000003561). Background the ROOT
# sandbox restore: with --detach it does NOT return until ALL N containers join (it
# parks at restoringUnstarted reading ContainerCount=$CCOUNT). Then fire one SUB
# restore PER sub-container (agent + each sidecar) to satisfy the count and unblock
# the whole pod. Mirrors the shim's concurrent ContMgrRestore +
# ContMgrRestoreSubcontainer RPCs — the proven gvisor-poc spike sequence, now
# scaled from the fixed pause+agent pair to sandbox + every captured sub-container.
# Each sub restore pairs the captured bundle subdir ($BUNDLE/<name>) to Pod B's
# fresh cid for that name (bcid_for); gVisor matches the checkpointed sub-container
# by its container-name annotation, so name-keyed pairing is what makes a sidecar's
# checkpointed state land on the right B slot.
( RUNSC $OVERLAY_FLAG restore --image-path="$IMG" --bundle "$BUNDLE/sandbox" --detach "$BSB" >/var/tmp/gb-thaw-root.out 2>&1; echo "ROOT_RC=$?" >>/var/tmp/gb-thaw-root.out ) &
ROOT_BG=$!
for i in $(seq 1 20); do RUNSC state "$BSB" >/dev/null 2>&1 && break; sleep 0.5; done
# Fire every sub-container restore. Collect the worst (max) rc as FT_SUB_RC so the
# Go post-state check still sees a single sub rc, and name each failure in the log.
SUBRC=0
for cn in $SUBNAMES; do
  bc=$(bcid_for "$cn")
  RUNSC $OVERLAY_FLAG restore --image-path="$IMG" --bundle "$BUNDLE/$cn" --detach "$bc" >"/var/tmp/gb-thaw-sub-$cn.out" 2>&1; r=$?
  log "sub restore '$cn' (cid=$bc) rc=$r"
  if [ "$r" -ne 0 ]; then
    [ "$r" -gt "$SUBRC" ] && SUBRC=$r
    log "sub '$cn': $(tail -3 "/var/tmp/gb-thaw-sub-$cn.out" 2>/dev/null)"
    # On failure, dump the sub gofer/boot log.json tail (mirrors the PoC). An empty
    # --mounts-fd pipe ("reading mounts file: unexpected end of JSON input") means the
    # gofer died in ResolveMounts before WriteMounts — these lines name the dying
    # mount walk; "not being restored" means ordering; "already restored"/"CID already
    # belongs" means a cid/name collision. Without this the empty-mounts cause is
    # opaque (ka-0000004815); with it a single redrive reveals the real failure.
    for lf in "$BUNDLE/$cn/log.json" "$T/$bc/log.json"; do
      HMNT test -f "$lf" || continue
      HMNT python3 -c 'import sys,json
sub=sys.argv[2]
for l in open(sys.argv[1]):
  l=l.strip()
  if not l: continue
  try: m=json.loads(l).get("msg","")
  except Exception: m=l[:200]
  if m: print("      ["+sub+" gofer/boot] "+m[:200])' "$lf" "$cn" 2>/dev/null | tail -15 >&2
    done
  fi
done
echo "FT_SUB_RC=$SUBRC"
wait "$ROOT_BG" 2>/dev/null
ROOTRC=$(sed -n 's/^ROOT_RC=//p' /var/tmp/gb-thaw-root.out | tail -1); [ -z "$ROOTRC" ] && ROOTRC=1
echo "FT_ROOT_RC=$ROOTRC"
# Release the [4-pre] EXTRA netns ref (bug ka-0000002907). Its ONLY job was to keep the
# inode alive across the kubelet's induced CNI DEL until 'runsc restore' scraped the
# netns into the sentry netstack — which is complete once the barrier restore has
# returned (setupNetwork() runs during the restore RPC). The restored sentry uses
# PINNED_NETNS, not HELD_NETNS, so tearing this extra bind-mount down now is safe and
# prevents a per-thaw mount leak. Best-effort; runs on both the success and the
# restore-failed early-exit paths below.
if [ -n "${HELD_NETNS:-}" ]; then HMNT umount "$HELD_NETNS" 2>/dev/null && HMNT rm -f "$HELD_NETNS" 2>/dev/null || true; fi
if [ "$SUBRC" -ne 0 ] || [ "$ROOTRC" -ne 0 ]; then
  log "restore failed: root=$ROOTRC sub=$SUBRC"; log "root: $(tail -3 /var/tmp/gb-thaw-root.out 2>/dev/null)"
  exit 0
fi

# [6] PROOF: all containers re-scheduled; restored sentry shares B's netns inode.
sleep 3
RPID=$(RUNSC state "$BSB" 2>/dev/null | python3 -c 'import sys,json;print(json.load(sys.stdin)["pid"])' 2>/dev/null)
echo "FT_RESTORED_PID=$RPID"
echo "FT_RESTORED_NETNS=$(readlink /proc/$RPID/ns/net 2>/dev/null)"

# [6a] NETNS-CONTENT ASSERTION (fix A, ka-0000007713). The inode proof below
# (FT_RESTORED_NETNS == FT_B_NETNS) only proves the restored sentry landed in the
# netns we REPOINTED to — it does NOT prove that netns actually carries a network.
# On canary fr84 the restore "verified" (inode matched) but the netns held ONLY lo
# (no eth0, empty route table): the CNI veth had been torn down with Pod B's
# sandbox delete (the defect Fix B's pin closes). BOTH coop and gb then failed
# 'network is unreachable', and the rehydrate-ack gate fail-closed 60s LATER on
# the consumer acks — long after this node script returned a "verified" restore.
# Assert HERE, in the restored sentry's OWN netns (entered via the host-ns PID
# /proc/$RPID/ns/net — the sentry runs as a host process, so its netns is visible
# from the host mount/pid ns), that the restored network is real:
#   (1) >= 1 non-loopback interface in /proc/net/dev (eth0), AND
#   (2) a default route in /proc/net/route (a 00000000 destination).
# Read both via 'nsenter --net=/proc/$RPID/ns/net' so we inspect EXACTLY the netns
# the restored sentry uses. On failure emit a distinct FT_ROOT_RC=128 with a loud
# lo-only diagnosis so the controller fails-closed to cold-start AT RESTORE TIME,
# not 60s later on a network-unreachable ack timeout. Emit FT_NETNS_IFACES /
# FT_NETNS_DEFROUTE either way so the Go side (and a redrive) can see the contents.
# L3 RE-ASSERT, post-restore (fix B, ka-0000001790). The CNI DEL the [4] force-delete
# triggered is the kubelet's async reaction to the sandbox death and may have landed
# AFTER our pre-restore re-assert (or after runsc restore re-created the netns view), so
# re-apply the captured L3 ONE more time into the restored sentry's OWN netns — the same
# inode the pre-restore apply targeted via the pinned bind-mount, reached here via the
# host-ns PID. Last-write-wins: whichever of {CNI DEL, our re-assert} ran last decides,
# and we make ours last, immediately before the content assertion reads the table. EEXIST
# on an addr/route the pre-restore apply still holds is success (reassert_l3 swallows it).
# Then FT_NETNS_L3_REASSERTED records whether the fix engaged, so a thaw that STILL lands
# lo-only (e.g. the host-side veth peer was also torn down — a deeper failure than L3
# strip) is distinguishable controller-side from one where the fix never ran.
if [ -n "$RPID" ] && [ -r "/proc/$RPID/ns/net" ]; then
  reassert_l3 "/proc/$RPID/ns/net"
fi
if [ -n "$CAP_ADDRS$CAP_ROUTES" ]; then echo "FT_NETNS_L3_REASSERTED=yes"; else echo "FT_NETNS_L3_REASSERTED=no"; fi
# SELF-IPAM, post-restore (fix C, ka-0000001099; now the SECONDARY apply — fix D
# ka-0000004088 moved the load-bearing self_ipam PRE-restore, above [5]). reassert_l3
# above only re-applies what it CAPTURED from $BNETNS_PATH (the sandbox netns) — which
# is empty under the two-inode split because the AWS VPC CNI populated the PAUSE netns
# instead, a different inode. So drive self_ipam INTO the restored sentry's OWN netns —
# the exact inode the restore landed in, reached via the host-ns PID /proc/<RPID>/ns/net
# — using the committed CNI result IP read at the gate (decoupled from any source-netns
# inode). NOTE this post-restore apply ALONE does NOT make the sentry netstack routable:
# gVisor scraped the netns into the sentry DURING the [5] restore RPC (setupNetwork runs
# before ContMgrRestore — runsc/sandbox/sandbox.go), so an L3 apply that lands AFTER the
# restore only fixes the HOST-KERNEL netns view, not the already-built sentry netstack —
# the exact gap fix D closes by applying self_ipam pre-restore. This call is kept as a
# last-write-wins re-apply that (a) repels any late async kubelet CNI DEL racing the
# sandbox death, and (b) keeps the [6a] content assertion below confirming eth0 + default
# route on the restore-target inode. Idempotent vs. the pre-restore apply + reassert_l3
# (EEXIST swallowed), so a netns already populated pre-restore is a no-op here.
if [ -n "$RPID" ] && [ -r "/proc/$RPID/ns/net" ]; then
  self_ipam "/proc/$RPID/ns/net"
  log "fix-C self-IPAM into restored sentry OWN netns /proc/$RPID/ns/net complete (pod IP '$CNI_POD_IP' via gw $CNI_GW; secondary to fix-D pre-restore apply)"
fi
if [ -n "$CNI_POD_IP" ]; then echo "FT_NETNS_SELF_IPAM=yes"; else echo "FT_NETNS_SELF_IPAM=no"; fi

NETNS_IFACES=0
NETNS_DEFROUTE=no
if [ -n "$RPID" ] && [ -r "/proc/$RPID/ns/net" ]; then
  # non-loopback interface count: /proc/net/dev lines past the 2 header rows,
  # excluding the "lo:" entry. nsenter into the restored sentry's netns.
  NETNS_IFACES=$(nsenter --net="/proc/$RPID/ns/net" -- cat /proc/net/dev 2>/dev/null \
    | awk 'NR>2{n=$1; sub(/:.*/,"",n); gsub(/[[:space:]]/,"",n); if(n!="" && n!="lo") c++} END{print c+0}')
  # default route: /proc/net/route has a row whose Destination (col 2) is 00000000.
  if nsenter --net="/proc/$RPID/ns/net" -- awk 'NR>1 && $2=="00000000"{found=1} END{exit !found}' /proc/net/route 2>/dev/null; then
    NETNS_DEFROUTE=yes
  fi
fi
echo "FT_NETNS_IFACES=$NETNS_IFACES"
echo "FT_NETNS_DEFROUTE=$NETNS_DEFROUTE"
if [ "${NETNS_IFACES:-0}" -lt 1 ] || [ "$NETNS_DEFROUTE" != "yes" ]; then
  log "FATAL: restored sandbox netns has no non-loopback interface / default route (non-lo ifaces=$NETNS_IFACES, default-route=$NETNS_DEFROUTE) — this is a lo-only netns: the CNI eth0 is NOT present in the restore target (Pod B's CNI netns was torn down with the placeholder-graft sandbox delete, or the netns pin failed). The rehydrate-ack gate WOULD fail-closed network-unreachable 60s later on both coop and gb; failing the restore LOUD here instead. NOT declaring restore verified."
  echo "FT_ROOT_RC=128"
  exit 1
fi

# [6c] SENTRY-SIDE EGRESS assertion (fix B, ka-0000008207 / bug ka-0000000514). THE
# no-regret floor. The [6a] check above reads the HOST-KERNEL netns (nsenter --net=
# /proc/$RPID/ns/net inspects the host's view of that inode), so it goes GREEN even
# when the restored gVisor SENTRY netstack is LINK-ONLY: runsc restore's setupNetwork()
# SCRAPES the netns into a FRESH sentry netstack DURING the [5] restore RPC and discards
# the checkpoint's, so if the netns was link-only at scrape-time the SENTRY comes up with
# no default route REGARDLESS of what the host netns carries afterward. That is exactly the
# prod .13 fail (rehydrate "not released; failed consumers: coop, gb" — both consumers got
# "network is unreachable" for the full 60s on a restore that [6a] called verified). So
# assert egress from INSIDE the sentry, where the consumers actually run, via 'runsc exec':
#   [6c-1] (always) read the SENTRY's OWN /proc/net/{route,dev} — the gVisor netstack's own
#          view, NOT the host kernel's — and require a default route + a non-lo iface. This
#          is the DIRECT link-only detector, DNS- and service-independent: it catches the
#          exact gap [6a] is blind to. A definitive "no default route in the sentry netstack"
#          is the bug signature -> fail-closed FT_ROOT_RC=128 (clean cold-start fallback).
#   [6c-2] (when egress targets are configured) TCP-dial NATS + the beads daemon — the SAME
#          endpoints coop + gb reach — from inside the sentry and fail-closed ONLY on the
#          unambiguous network-unreachable / no-route errno (ENETUNREACH/EHOSTUNREACH/
#          ENETDOWN), the precise "network is unreachable" the consumers reported. A
#          connection-refused / timeout / DNS-resolution failure is NOT fail-closed (the
#          netstack routed the SYN; a service-down or DNS blip must never cold-start an
#          otherwise-good resume) — so this never false-positives, it only catches a
#          provably link-only sentry that [6c-1] somehow passed (e.g. a default route present
#          but the host-side veth peer severed). Both emit sentinels either way so the Go side
#          + a redrive can see the contents; an exec that FLAKES (sentry not joinable / no
#          output) is INCONCLUSIVE (unknown) and never fail-closes — the [6a] host-view +
#          the 60s ack gate remain the backstops, mirroring [6b]'s LIVE=unknown posture.
ABC=$(bcid_for agent)
SENTRY_DEFROUTE=unknown
SENTRY_NONLO=-1
if [ -n "$ABC" ]; then
  # BOUNDED READINESS+RETRY (bug ka-0000002907). The pre-fix code did a SINGLE runsc
  # exec at t+3s with no retry — so a sentry not yet joinable (its gofer/exec path
  # still coming up ~3s post-restore) yielded FT_SENTRY_DEFROUTE=unknown, which the Go
  # acceptance then flaked OPEN on (the canary #11 miss). Retry the in-sentry read
  # until it returns a DEFINITIVE verdict (defroute in yes|no AND a non-negative iface
  # count) or the budget (~10 * 1s) is exhausted. With the retry in place, an "unknown"
  # reaching the Go side means the sentry was genuinely un-joinable across the WHOLE
  # window — a real fault the positive-proof rule fail-closes on — not a t+3s timing
  # flake. The classifier condition below is UNCHANGED (still tolerant of unknown/-1);
  # the positive-proof enforcement lives Go-side. Best-effort: keeps the last read.
  for _sretry in $(seq 1 10); do
    # Read the restored sentry's OWN netstack view via runsc exec. python3 (in the
    # agent image) parses /proc/net/route (a 00000000 destination row == a default
    # route) and /proc/net/dev (non-lo iface count). Emits one sentinel line; a flaked
    # exec (sentry not yet joinable) emits nothing and leaves the defaults (unknown/-1).
    SENTRY_NET=$(RUNSC exec "$ABC" python3 -c '
import sys
defroute="no"; nonlo=0
try:
    for i,l in enumerate(open("/proc/net/route")):
        if i==0: continue
        f=l.split()
        if len(f)>1 and f[1]=="00000000": defroute="yes"
except Exception:
    defroute="unknown"
try:
    for i,l in enumerate(open("/proc/net/dev")):
        if i<2: continue
        n=l.split(":")[0].strip()
        if n and n!="lo": nonlo+=1
except Exception:
    nonlo=-1
print("SENTRY_DEFROUTE=%s SENTRY_NONLO=%d" % (defroute,nonlo))
' 2>/dev/null)
    _dr=$(printf '%s' "$SENTRY_NET" | sed -n 's/.*SENTRY_DEFROUTE=\([a-z]*\).*/\1/p')
    _nl=$(printf '%s' "$SENTRY_NET" | sed -n 's/.*SENTRY_NONLO=\(-\{0,1\}[0-9]*\).*/\1/p')
    [ -n "$_dr" ] && SENTRY_DEFROUTE="$_dr"
    [ -n "$_nl" ] && SENTRY_NONLO="$_nl"
    # DEFINITIVE read (real yes|no route verdict + non-negative iface count) -> stop
    # retrying; otherwise the sentry is not yet joinable, wait and re-read.
    case "$SENTRY_DEFROUTE" in
      yes|no) if [ "${SENTRY_NONLO:--1}" -ge 0 ] 2>/dev/null; then break; fi ;;
    esac
    sleep 1
  done
fi
echo "FT_SENTRY_DEFROUTE=$SENTRY_DEFROUTE"
echo "FT_SENTRY_NONLO=$SENTRY_NONLO"
if [ "$SENTRY_DEFROUTE" = no ] || [ "${SENTRY_NONLO:-0}" = 0 ]; then
  log "FATAL: restored SENTRY netstack is LINK-ONLY (sentry default-route=$SENTRY_DEFROUTE, sentry non-lo ifaces=$SENTRY_NONLO) — read from INSIDE the restored sandbox via runsc exec, i.e. the gVisor netstack's OWN view, not the host kernel's. runsc restore's setupNetwork() scraped a link-only netns into the sentry; the host-side [6a] check passed but the SENTRY cannot egress. Both rehydrate consumers (coop NATS, gb beads) WOULD fail 'network is unreachable' for the full 60s ack deadline; failing the restore LOUD here instead (clean cold-start fallback). NOT declaring restore verified."
  echo "FT_ROOT_RC=128"
  exit 1
fi

# [6c-2] in-sentry end-to-end TCP egress dial to the rehydrate consumers' endpoints.
# Fail-closed ONLY on the network-unreachable signature; refused/timeout/DNS-fail is a
# routable netstack (do NOT cold-start a good resume over a service blip). Skipped when
# no targets are configured (older controller) — [6c-1] above is the load-bearing floor.
SENTRY_EGRESS=skipped
sentry_dial() { # $1=host $2=port $3=label -> echoes ok|link-only|other|skip
  [ -z "$1" ] && { echo skip; return 0; }
  RUNSC exec "$ABC" python3 -c '
import socket,sys,errno
host,port,label=sys.argv[1],int(sys.argv[2]),sys.argv[3]
try:
    s=socket.create_connection((host,port),timeout=4); s.close()
    print("ok"); sys.exit(0)
except OSError as e:
    en=getattr(e,"errno",None)
    if en in (errno.ENETUNREACH, errno.EHOSTUNREACH, errno.ENETDOWN):
        sys.stderr.write("%s network-unreachable errno=%s\n"%(label,en)); print("link-only"); sys.exit(0)
    sys.stderr.write("%s reachable-or-ambiguous errno=%s msg=%s\n"%(label,en,e)); print("other"); sys.exit(0)
' "$1" "$2" "$3" 2>>/var/tmp/gb-thaw-egress.err
}
# Dial the ClusterIP LITERALS (bug ka-0000002907), NOT the bare DNS names: a link-only
# sentry cannot reach kube-dns, so a name-dial gaierrors -> "inconclusive" -> flake-open
# (the #11 miss), whereas a ClusterIP is routed purely at L3 so it no-routes EHOSTUNREACH
# -> link-only -> fail-closed. Guarded on the resolved LITERALS (EGRESS_*_ADDR): if the
# controller could not resolve a ClusterIP the dial SKIPS and [6c-1] is the floor.
if [ -n "$EGRESS_NATS_ADDR$EGRESS_BEADS_ADDR" ]; then
  : >/var/tmp/gb-thaw-egress.err 2>/dev/null || true
  EG_NATS=$(sentry_dial "$EGRESS_NATS_ADDR" "$EGRESS_NATS_PORT" nats)
  EG_BEADS=$(sentry_dial "$EGRESS_BEADS_ADDR" "$EGRESS_BEADS_PORT" beads)
  log "fix-B in-sentry egress dial (ClusterIP literals): nats($EGRESS_NATS_HOST->$EGRESS_NATS_ADDR:$EGRESS_NATS_PORT)=$EG_NATS beads($EGRESS_BEADS_HOST->$EGRESS_BEADS_ADDR:$EGRESS_BEADS_PORT)=$EG_BEADS"
  [ -s /var/tmp/gb-thaw-egress.err ] && HMNT sed 's/^/    in-sentry egress: /' /var/tmp/gb-thaw-egress.err >&2 2>/dev/null || true
  if [ "$EG_NATS" = link-only ] || [ "$EG_BEADS" = link-only ]; then
    SENTRY_EGRESS=link-only
  elif [ "$EG_NATS" = ok ] || [ "$EG_BEADS" = ok ]; then
    SENTRY_EGRESS=ok
  else
    SENTRY_EGRESS=inconclusive
  fi
fi
echo "FT_SENTRY_EGRESS=$SENTRY_EGRESS"
if [ "$SENTRY_EGRESS" = link-only ]; then
  log "FATAL: restored SENTRY cannot egress to the rehydrate consumers' endpoints — an in-sentry TCP dial to NATS/beads returned 'network is unreachable' (the exact errno coop+gb hit for 60s on prod .13). The sentry netstack passed the [6c-1] route check but a dial still no-routes (host-side veth peer severed, or a default route to an unreachable gateway). Failing the restore LOUD here (clean cold-start fallback) instead of 60s later on the ack gate. NOT declaring restore verified."
  echo "FT_ROOT_RC=128"
  exit 1
fi

# [6b] DIR-MEDIUM WORKSPACE-LIVENESS assertion (ka-0000000357, gardener steer yd0g
# req-2; HARDENED to NON-EMPTINESS by ka-0000004935). The pre-restore CWD-dentry
# fail-close ([2]/remount_rootfs) is SKIPPED under the dir medium; [2] now also
# MATERIALIZES an empty CWD dir on the lower so 'runsc restore' can re-walk it. That
# makes the workspace path ALWAYS EXIST post-restore (the lower carries the empty dir
# even if the upper content was lost), so a mere existence test ('test -e') here would
# be DEFEATED by the [2] fix and silently mask genuine data loss — resuming an agent
# into an empty /home/agent/workspace. So this guard asserts the CWD is present AND
# NON-EMPTY inside the restored sentry: the directory existence is provided by the
# lower (the [2] mkdir), but its CONTENT can ONLY come from the rebuilt upper
# (checkpoint pages). A populated CWD => the upper round-tripped; an EMPTY CWD => real
# loss, fail-closed FT_ROOT_RC=128 by name (last-wins over the FT_ROOT_RC=0 above) so
# the controller cold-starts rather than resume a workspace-less agent. (Mirrors the
# zero-canary discriminating-restore-check.sh entries>0 verdict.) SELF medium already
# proved the path pre-restore on the host lower, so this runs ONLY under dir medium
# (OVERLAY_FLAG non-empty); empty OVERLAY_FLAG leaves this section a no-op (zero blast
# radius on self nodes). Best-effort cwd read: a missing/'/'/unreadable cwd has
# nothing to prove (skip).
if [ -n "$OVERLAY_FLAG" ]; then
  ACWD=$(HMNT python3 -c 'import json,sys
try: print(json.load(open(sys.argv[1])).get("process",{}).get("cwd",""))
except Exception: print("")' "$BUNDLE/agent/config.json" 2>/dev/null)
  ABC=$(bcid_for agent)
  if [ -n "$ACWD" ] && [ "$ACWD" != "/" ] && [ -n "$ABC" ]; then
    # Count the entries under the checkpointed CWD INSIDE the restored sentry. We use
    # an entry COUNT (not 'test -e') because the [2] dir-medium fix guarantees the dir
    # EXISTS on the lower regardless of upper content — only non-emptiness proves the
    # upper round-tripped. The exec emits an integer on success and nothing on an
    # infra failure, which we disambiguate from a real empty-dir:
    #   integer >0  => populated workspace: the upper round-tripped (LIVE=yes).
    #   integer ==0 => present but EMPTY: real workspace loss (LIVE=no, fail-closed).
    #   non-integer/empty => exec INFRASTRUCTURE failed (sentry not joinable, 'sh'/'ls'
    #     missing, runsc timeout) — a flaky exec that must NOT nuke an otherwise-good
    #     restore (LIVE=unknown, let it stand; the rehydrate-ack gate remains the
    #     backstop). So a transient exec hiccup never converts a good thaw into a
    #     cold-start, while a genuinely empty workspace DOES fail closed.
    ACNT=$(RUNSC exec "$ABC" sh -c 'ls -A1 "$1" 2>/dev/null | wc -l' ls-cwd "$ACWD" 2>/dev/null | tr -dc '0-9')
    if [ -z "$ACNT" ]; then
      echo "FT_DIRMEDIUM_CWD_LIVE=unknown"
      log "WARN dir-medium workspace-liveness exec INCONCLUSIVE for CWD '$ACWD' (RUNSC exec produced no count: sentry not joinable / 'sh'/'ls' missing / timeout). Letting the restore stand rather than fail-close on a flaky exec; the rehydrate-ack gate remains the backstop."
    elif [ "$ACNT" -gt 0 ]; then
      echo "FT_DIRMEDIUM_CWD_LIVE=yes"
      log "dir-medium workspace-liveness OK: restored agent CWD '$ACWD' is present and NON-EMPTY ($ACNT entries) inside the restored sentry — the rootfs-overlay upper round-tripped through the checkpoint pages."
    else
      echo "FT_DIRMEDIUM_CWD_LIVE=no"
      log "FATAL: dir-medium restored agent CWD '$ACWD' is present but EMPTY (0 entries) inside the restored sentry — the rootfs-overlay upper did NOT round-trip under $OVERLAY_FLAG. This is REAL workspace data loss: the [2] lower-side mkdir provides the empty dir so restore can re-walk it (ka-0000004935), but the CONTENT must come from the rebuilt upper (checkpoint pages) and did not. The agent would resume into an empty /home/agent/workspace. Failing the restore LOUD here so the controller cold-starts. NOT declaring restore verified. NOT a restore-internal failure."
      echo "FT_ROOT_RC=128"
      exit 1
    fi
  fi
fi

# [6d] THAW-STATE SOURCE-PROVENANCE assertion (ka-0000001208). DEFENSE-IN-DEPTH
# only — the [3a] PRE-restore dangling-source guard + the rehydrate ack remain the
# functional gate. Confirms POST-restore that the /run/gardenio-thaw ($THAWDEST) mount
# the restored sentry actually carries resolves to the LIVE per-agent host source
# $THAWDIR (thawStateHostDir(req.AgentName)) — NOT a checkpointed 9p gofer /
# placeholder dir the restore might have re-walked to a stale/wrong source.
#
# WHY A CONTENT-MARKER PROBE, NOT A mountinfo SCRAPE (the bead's literal ask). gVisor
# serves every host-backed bind mount through the gofer, so neither the guest
# mountinfo nor /proc/$RPID/mountinfo (RPID = host-side sentry pid, runsc-internal
# mounts) carries the host bind SOURCE path — there is nothing there to compare
# against $THAWDIR (root-cause ka-0000000673). The discriminator canary #7 ACTUALLY
# used was mount CONTENTS, so assert on contents: write a fresh unique marker into
# $THAWDIR on the HOST, then read it back from INSIDE the restored sentry at
# $THAWDEST via runsc exec. If the sentry's mount is bound to the live $THAWDIR the
# marker is visible (PRESENT -> ok); if it resolves to a different (stale/placeholder/
# checkpointed) dir the host-written marker is absent (ABSENT -> mismatch), which is
# exactly canary #7's "rc=0 against a different-content dir" — now a fail-closed gate
# (FT_ROOT_RC=128) instead of an empirical claim, caught one step before the ack gate.
#
# POSTURE mirrors [6c]/FT_DIRMEDIUM_CWD_LIVE: a DEFINITIVE ABSENT (the in-sentry read
# ran and reported the marker missing) fail-closes; an exec that FLAKES (sentry not
# joinable, no output) is INCONCLUSIVE (unknown) and never fail-closes — the [3a]
# guard + ack gate remain the backstops. SKIPPED (unknown) when $THAWDIR/$THAWDEST is
# empty (legacy snapshot) or the agent sub-container is unresolvable. The marker uses
# a unique name never looked up before, so a correctly-bound gofer mount has no cached
# negative dentry for it and WILL see it — a false-positive cold-start is not a fresh
# concern; a single retry absorbs any propagation delay before declaring mismatch.
FT_THAW_SRC_PROVENANCE=unknown
if [ -n "$THAWDIR" ] && [ -n "$THAWDEST" ]; then
  APBC=$(bcid_for agent)
  if [ -n "$APBC" ]; then
    # Unique marker name (host-generated uuid; falls back to pid so a uuid-less node
    # still gets a name). Written into $THAWDIR on the HOST, removed on every path.
    PMARK=".ft-srcprov-$(HMNT cat /proc/sys/kernel/random/uuid 2>/dev/null | tr -dc 'a-f0-9' | cut -c1-32)"
    [ "$PMARK" = ".ft-srcprov-" ] && PMARK=".ft-srcprov-$$"
    if HMNT touch "$THAWDIR/$PMARK" 2>/dev/null; then
      PVERD=""
      for _pretry in 1 2; do
        # Read from INSIDE the restored sentry: emit PRESENT/ABSENT on a definitive
        # read, nothing on a flaked exec (sentry not joinable). $THAWDEST is the guest
        # mount point (/run/gardenio-thaw); test -e resolves it through the gofer.
        PREAD=$(RUNSC exec "$APBC" sh -c 'if [ -e "$1" ]; then echo PRESENT; else echo ABSENT; fi' _ "$THAWDEST/$PMARK" 2>/dev/null | tr -dc 'A-Z')
        case "$PREAD" in
          PRESENT) PVERD=ok; break ;;
          ABSENT)  PVERD=mismatch ;;   # keep reading: a second PRESENT wins (propagation)
        esac
        [ "$_pretry" = 2 ] && break
        sleep 1
      done
      [ -n "$PVERD" ] && FT_THAW_SRC_PROVENANCE="$PVERD"
    else
      log "WARN [6d] could not write thaw-state provenance marker into host source $THAWDIR — source-provenance assertion INCONCLUSIVE (unknown); the [3a] guard + rehydrate ack remain the gate."
    fi
    HMNT rm -f "$THAWDIR/$PMARK" 2>/dev/null || true
  fi
fi
echo "FT_THAW_SRC_PROVENANCE=$FT_THAW_SRC_PROVENANCE"
if [ "$FT_THAW_SRC_PROVENANCE" = mismatch ]; then
  log "FATAL: [6d] restored /run/gardenio-thaw ($THAWDEST) mount does NOT resolve to the live per-agent host source $THAWDIR (thawStateHostDir(req.AgentName)) — a fresh marker written into $THAWDIR on the host was NOT visible inside the restored sentry, so the restore re-walked the thaw-state mount to a DIFFERENT (stale/placeholder/checkpointed 9p-gofer) source. The rehydrate consumers would write their .done ack into a dir the controller never reads -> the both-consumer ack gate fail-closes ~60s later as an OPAQUE timeout (canary #7 signature). Failing the restore LOUD here instead. NOT declaring restore verified."
  echo "FT_ROOT_RC=128"
  exit 1
fi

SBUP=$(RUNSC state "$BSB" 2>/dev/null | python3 -c 'import sys,json;print(json.load(sys.stdin).get("status",""))' 2>/dev/null)
# every sub-container must report running; collect the first non-running one.
ALLUP=yes; BADC=""
for cn in $SUBNAMES; do
  st=$(RUNSC state "$(bcid_for "$cn")" 2>/dev/null | python3 -c 'import sys,json;print(json.load(sys.stdin).get("status",""))' 2>/dev/null)
  [ "$st" = "running" ] || { ALLUP=no; BADC="$cn=$st"; break; }
done
if [ "$SBUP" = "running" ] && [ "$ALLUP" = "yes" ]; then echo "FT_CONTAINERS_RUNNING=yes"; else echo "FT_CONTAINERS_RUNNING=no(sandbox=$SBUP,$BADC)"; fi
log "thaw complete: restored sentry pid=$RPID netns=$(readlink /proc/$RPID/ns/net 2>/dev/null) subcontainers=[$SUBNAMES]"

# [7] RESTORE-PEAK MEASUREMENT (ka-0000003398 fix C — best-effort, POST-verify,
# NEVER gates). The runsc restore ran inside Pod B's per-container scope cgroup
# (cgroup-v2 memory.max); memory.peak is the high-water RSS that cgroup reached
# reconstructing the eager pages.img — the EXACT quantity canary #15's OOM fired
# against (bug ka-0000000413). Emitting it lets the controller calibrate the
# restore-peak multiplier (modeledRestorePeakLimit) against real peaks per medium
# and sandbox role, instead of the single-data-point 3.0x we ship. This runs
# AFTER the restore is already verified above, so it cannot perturb it, and
# tolerates every failure (cgroup-v1 node, unresolvable scope, missing file): the
# sentinel is then FT_RESTORE_PEAK_BYTES=0 and the Go side leaves RestorePeakBytes
# unset. Resolve each restored container's host cgroup scope by cid and emit the
# MAX peak across the sandbox root + every sub (the root sandbox is the one that
# OOMed in #15). HMNTT bounds the find so a pathological cgroup tree cannot wedge.
# TODO(ka-0000003398 fix C): aggregate FT_RESTORE_PEAK_BYTES across canaries and
# replace the flat 3.0x multiplier with a per-medium / per-role calibrated term.
PEAK=0
peak_for_cid() {
  _cid="$1"; [ -n "$_cid" ] || return 0
  for mp in $(HMNTT find /sys/fs/cgroup -type f -name memory.peak -path "*$_cid*.scope/memory.peak" 2>/dev/null); do
    v=$(HMNT cat "$mp" 2>/dev/null | tr -dc '0-9'); [ -n "$v" ] || continue
    [ "$v" -gt "$PEAK" ] && PEAK="$v"
  done
}
peak_for_cid "$BSB"
for cn in $SUBNAMES; do peak_for_cid "$(bcid_for "$cn")"; done
echo "FT_RESTORE_PEAK_BYTES=$PEAK"
[ "$PEAK" -gt 0 ] && log "restore-peak measurement: cgroup memory.peak=$PEAK bytes across restored scopes (fix C — for multiplier calibration)"
