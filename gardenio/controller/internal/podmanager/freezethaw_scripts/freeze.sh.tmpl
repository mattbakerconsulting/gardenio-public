set -uo pipefail
ROOT=/run/containerd/runsc/k8s.io
T=/run/containerd/io.containerd.runtime.v2.task/k8s.io
SBNAME='{{.PodName}}'
IMG='{{.ImagePath}}'
BUNDLE='{{.BundlePath}}'
RUNSC_TIMEOUT={{.RunscTimeout}}
RUNSC() { nsenter -t 1 -m -p -n -- timeout "${RUNSC_TIMEOUT}" runsc --root=$ROOT "$@"; }
HMNT() { nsenter -t 1 -m -- "$@"; }
# HMNTT: a KILL-signal-BOUNDED host-ns helper (bug ka-0000004931). It mirrors
# HMNT (same nsenter -t 1 -m host mount-ns) but wraps the op in the SAME
# ${RUNSC_TIMEOUT} discipline RUNSC() already applies to runsc, so a host-ns FS op
# that WEDGES on the ~3.0G checkpoint image / rootfs cannot hang the freeze exec
# until the caller (or the canary harness) kills it and TRUNCATES the sentinel
# stream. A wedged, unbounded probe was the freeze-side snapshot_persisted
# failure: FT_IMAGE_PRESENT never emitted (empty, not "=no") / FT_CHECKPOINT_RC
# absent, so the truncated stream looked like image-absent when it was really a
# hang. timeout -s KILL sends SIGKILL (not the default SIGTERM) because a D-state
# FS syscall on a wedged mount ignores catchable signals; -k adds a hard backstop
# if the KILL itself is briefly deferred. On timeout, timeout(1) exits 137
# (128+SIGKILL) so the probe FAILS FAST into the EXISTING fail-closed markers
# (FT_IMAGE_PRESENT=no / FT_IMAGE_OK=no) and the script RUNS TO COMPLETION,
# emitting a COMPLETE, classifiable stream instead of truncating. Zero blast
# radius on healthy nodes: a probe that finishes in <${RUNSC_TIMEOUT}s behaves
# byte-identically to HMNT. CRITICAL SCOPE: HMNTT is applied ONLY to the
# READ-ONLY checkpoint-image probes below (test -f/-s, du, stat, strings). The
# MUTATING relocation cp/rm ops stay on plain HMNT — bounding a mutating copy
# risks a partial-copy un-thawable snapshot, which is worse than fail-closed.
HMNTT() { nsenter -t 1 -m -- timeout -s KILL -k 5s "${RUNSC_TIMEOUT}" "$@"; }
log() { echo "    $*" >&2; }
# NOW_MS: wall-clock milliseconds for in-script step attribution (task
# ka-0000005147). The Go side parses the FT_*_MS sentinels emitted below to split
# the one node exec into runsc-checkpoint vs. Step-3 relocation copy — the two are
# fused into a single Exec() call, so only a node-side stopwatch can attribute them
# independently (the ~3.0G image write is the suspect, but the relocation copy MUST
# be measured separately per fast-interruptible-freeze.md §C1). date +%s%3N is the
# same millisecond clock bench-thaw-node.sh uses for THAW_MS.
NOW_MS() { date +%s%3N; }

# ftClassifyCopyRC: DE-NOISE the /work + /tmp warm-copy rc (ka-0000006933).
# cp -aL --reflink=auto SRC DST DEREFERENCES symlinks, so a real /work repo
# checkout (stale node_modules/.bin, a deleted-target link) routinely carries a
# BENIGN dangling symlink that makes cp exit non-zero while copying every other
# byte completely. The pre-fix Go side flagged payloadComplete=false + WARN on
# ANY non-zero cp rc, so that benign noise fired on a large fraction of
# byte-complete freezes fleet-wide and drowned the real ENOSPC/EIO signal. This
# function is invoked ONLY on a non-zero cp rc (rc==0 short-circuits to "clean",
# so a healthy freeze pays ZERO pause-window cost) and classifies the rc into:
#   clean    — (never returned by this fn; rc==0 is handled by the caller)
#   symlink  — the copy is COMPLETE: every source entry cp -aL would have
#              materialized is present in DST at the right size, and the ONLY
#              thing that tripped the rc was >=1 benign DANGLING symlink cp
#              skipped. Payload is usable; this is the noise we are de-noising.
#   copyfail — a GENUINE truncating failure (ENOSPC/EIO/…): a source entry cp
#              -aL should have materialized is MISSING from DST, or present but
#              SHORT (torn write), OR the probe itself could not positively
#              prove completeness. The affected mount cold-starts at thaw.
# The "symlink" (=complete) verdict is emitted ONLY with POSITIVE evidence
# (every non-dangling entry present at matching size AND >=1 dangling symlink
# observed). Everything uncertain — a missing/short entry, a walk error, a
# timeout, an over-budget tree, empty probe output — defaults to "copyfail".
# So this can only ever REDUCE false alarms, NEVER introduce a false-clean.
#
# The probe is a metadata-only Python walk of the SOURCE tree (os.lstat/os.stat
# + st_size compare — NO content reads, so invariant I2 "bytes copied unchanged"
# and the read-only-probe discipline hold). It is HMNTT-bounded AND carries its
# own 'timeout -s KILL 15s' so a wedged/degenerate source fails fast to copyfail
# rather than eating the FreezeHardDeadline (ka-0000004931 discipline). Prints
# exactly one token (clean|symlink|copyfail) on stdout; the caller whitelists it.
#
# WHY dst-relpath dedup + size compare (design review wf_45801032-25b, M1/M2):
#   - cp -aL dereferences a dir-symlink into an INDEPENDENT dst subtree while
#     ALSO copying the real target dir, so a source-inode (st_dev,st_ino) visited
#     set would collapse link+target to one key and SKIP a whole dst subtree —
#     a false-clean on exactly the projected-SA-token "..data" chain this freeze
#     path preserves. Keying the visited set on the DST-relative path instead
#     visits every materialized copy. A hard node budget bounds cycles/degenerate
#     trees (cp -aL itself aborts on a symlink loop, so a bounded walk suffices).
#   - os.path.exists(dst) is True for a torn/0-byte ENOSPC write (the dominant
#     failure shape), so a bare presence check would read a truncated file as
#     "present". Compare st_size for regular files to catch the short write.
ftClassifyCopyRC() {
  # $1=src $2=dst. metadata-only; own SIGKILL timeout on top of HMNTT.
  local reason
  reason=$(HMNTT timeout -s KILL 15s python3 - "$1" "$2" <<'PYCLASSIFY'
import os,stat as _stat,sys
src,dst=sys.argv[1],sys.argv[2]
BUDGET=500000  # hard node cap: over-budget => copyfail (cycle/degenerate guard)
saw_dangling=False
bad=False
n=0
# Walk the SOURCE tree; for each entry decide what cp -aL would have produced in
# DST and verify it. Iterative explicit stack of (src_path, rel) where rel is the
# path RELATIVE to the copy root — the dst location and the dedup key (M1).
stack=[(src,"")]
seen=set()
try:
    while stack:
        s,rel=stack.pop()
        if rel in seen:            # dst-relpath dedup (M1): visit every copy once
            continue
        seen.add(rel)
        n+=1
        if n>BUDGET:               # bounded walk => conservative copyfail (M7)
            bad=True; break
        d=os.path.join(dst,rel) if rel else dst
        is_link=os.path.islink(s)
        if is_link and not os.path.exists(s):
            # DANGLING symlink: cp -aL skips it (this is what trips the benign
            # rc). Its absence from dst is expected. Record and move on.
            saw_dangling=True
            continue
        # Non-dangling: cp -aL materializes real content here (a resolvable
        # symlink is dereferenced into a file/dir). It MUST exist in dst.
        try:
            st=os.stat(s)          # follow_symlinks=True, mirroring cp -aL
        except OSError:
            # src entry vanished mid-probe (host gofer churn under pause): can't
            # prove completeness => conservative copyfail.
            bad=True; break
        if not os.path.exists(d):  # missing materialized entry => truncation (M2)
            bad=True; break
        if _stat.S_ISREG(st.st_mode):
            try:
                if os.stat(d).st_size!=st.st_size:  # torn/short write (M2)
                    bad=True; break
            except OSError:
                bad=True; break
        if _stat.S_ISDIR(st.st_mode):
            try:
                for e in os.listdir(s):
                    stack.append((os.path.join(s,e), os.path.join(rel,e) if rel else e))
            except OSError:
                bad=True; break
    if bad:
        print("copyfail")
    elif saw_dangling:
        print("symlink")           # POSITIVE evidence: complete + a benign skip
    else:
        # rc!=0 but everything present at size and NO dangling link found — we
        # cannot attribute the rc to benign noise, so stay conservative.
        print("copyfail")
except Exception:
    print("copyfail")
PYCLASSIFY
)
  # Whitelist (M6): a SIGKILL(137) truncation can leave stdout empty or a partial
  # token — anything not exactly symlink|copyfail collapses to copyfail so a lost
  # freeze is never downgraded to complete. echo the sole classification. (The
  # classifier itself only ever prints symlink|copyfail; "clean" is assigned by the
  # rc==0 caller and never routed here, so it is intentionally NOT in this list.)
  case "$reason" in
    symlink|copyfail) echo "$reason" ;;
    *) echo "copyfail" ;;
  esac
}

# [1/8] resolve the sandbox + EVERY running sub-container of the pod.
#
# A bare agent pod is sandbox(pause) + agent; a Docker/Postgres agent ALSO runs
# always-on native sidecars (dind/postgres), each a runsc sub-container of the
# same sandbox and all baked into the one checkpoint image (container_count=N).
# We must capture every sub-container here so the thaw barrier restore can fire
# one runsc-restore per container (N-container barrier, ka-0000003561). Resolve
# the AGENT first (by CRI container-name=agent), derive the sandbox from it, then
# enumerate the rest. ann_field reads one annotation from a state JSON on stdin.
ann_field() { python3 -c 'import sys,json;print(json.load(sys.stdin).get("annotations",{}).get(sys.argv[1],""))' "$1" 2>/dev/null; }
ALLC=$(ctr -n k8s.io containers ls 2>/dev/null | awk 'NR>1{print $1}')
AG=""
for c in $ALLC; do
  s=$(RUNSC state "$c" 2>/dev/null) || continue
  sn=$(printf '%s' "$s" | ann_field io.kubernetes.cri.sandbox-name)
  ct=$(printf '%s' "$s" | ann_field io.kubernetes.cri.container-type)
  cn=$(printf '%s' "$s" | ann_field io.kubernetes.cri.container-name)
  [ "$sn" = "$SBNAME" ] && [ "$ct" = "container" ] && [ "$cn" = "agent" ] && { AG="$c"; break; }
done
if [ -z "$AG" ]; then
  # legacy fallback: the first sub-container of $SBNAME (older agent images whose
  # CRI container-name is not the canonical "agent"); still pause+agent shape.
  for c in $ALLC; do
    s=$(RUNSC state "$c" 2>/dev/null) || continue
    sn=$(printf '%s' "$s" | ann_field io.kubernetes.cri.sandbox-name)
    ct=$(printf '%s' "$s" | ann_field io.kubernetes.cri.container-type)
    [ "$sn" = "$SBNAME" ] && [ "$ct" = "container" ] && { AG="$c"; break; }
  done
fi
[ -z "$AG" ] && { log "FATAL: no agent sub-container for pod $SBNAME"; echo "{{printf "%s" "FT_CHECKPOINT_RC"}}=127"; exit 1; }
AGS=$(RUNSC state "$AG")
SB=$(printf '%s' "$AGS" | ann_field io.kubernetes.cri.sandbox-id)
PODUID=$(printf '%s' "$AGS" | ann_field io.kubernetes.cri.sandbox-uid)
echo "FT_AGENT_CID=$AG"
echo "FT_SANDBOX_CID=$SB"
echo "FT_POD_UID=$PODUID"

# OVERLAY-MEDIUM PROBE (ka-0000007239, overlay-dir-medium). Read the rootfs-overlay
# medium runsc is ACTUALLY running with off the live sandbox boot process args
# (--overlay2=root:dir=/var/lib/gardenio/overlay on the dir-medium pool; absent ⇒
# the default root:self). The medium is a NODE property set by the containerd runsc
# runtimeArg (shim [runsc_config] overlay2), NOT a controller knob — so the snapshot
# SELF-DESCRIBES it (plan Step 4-A) and thaw replays the SAME medium to runsc restore.
# A checkpoint taken under root:dir can only be restored under root:dir, and the upper
# rides INSIDE checkpoint.img (the dir filestore is created-then-unlinked, so there is
# nothing to copy — substrate revalidation ka-0000007329). Empty ⇒ self/default ⇒ thaw
# adds no --overlay2 flag, leaving non-dir nodes byte-identical to today (zero blast
# radius). HOST-ns (nsenter -t 1 -m -p) so we see the real sandbox boot args. Resolve
# the boot pid from the sandbox cid; best-effort, diagnostic — a miss just means the
# default medium, never a freeze gate.
OVERLAY_MEDIUM=$(nsenter -t 1 -m -p -- sh -c '
  sb="$1"
  for p in $(pgrep -f "runsc-sandbox" 2>/dev/null); do
    args=$(tr "\0" " " < /proc/$p/cmdline 2>/dev/null)
    # scope to THIS pod: the sandbox boot args end with our sandbox cid, and other
    # agents on the node have their own. Match both the cid and the overlay2 flag.
    case "$args" in
      *"$sb"*"--overlay2="*|*"--overlay2="*"$sb"*)
        echo "$args" | tr " " "\n" | sed -n "s/^--overlay2=//p" | head -1
        exit 0;;
    esac
  done
' probe-overlay "$SB" 2>/dev/null)
echo "FT_OVERLAY_MEDIUM=$OVERLAY_MEDIUM"

# OVERLAY_FLAG (ka-0000000357, plural_fix). Derive a single dir-medium gate from the
# probed medium so the freeze-side [3a] skeleton + lowerdir-stacking blocks below run
# ONLY under the dir medium (--overlay2=root:dir, where the relocated lower is an
# intentionally-sparse upper-delta missing the read-only image base dirs). Empty under
# self/root:self ⇒ those blocks are skipped entirely ⇒ the relocation cp + .overlay-opts
# write stay byte-identical to the pre-fix script (zero blast radius on self nodes). This
# mirrors thaw's OVERLAY_FLAG gate (the [2] cwd-materialize + [6b] liveness guards) so
# both sides key off the SAME medium the snapshot self-describes. We gate on the probed
# medium directly (not the rendered "--overlay2=" string) since freeze does not carry
# RestoreOverlayFlag; root:self / self collapse to the default ⇒ empty gate.
case "$OVERLAY_MEDIUM" in
  ''|root:self|self) OVERLAY_FLAG='' ;;
  *)                 OVERLAY_FLAG="$OVERLAY_MEDIUM" ;;
esac

# enumerate ALL sub-containers of $SB (agent first, then sidecars), recording
# "<container-name>|<cid>" per line. The agent's bundle subdir is always "agent"
# (the canonical CRI container-name), so emit it as such regardless of the legacy
# fallback above. Emit FT_SUBC per entry so the controller persists the restore
# roster; len(FT_SUBC) + sandbox = FT_CONTAINER_COUNT.
SUBC_LIST="agent|$AG"
for c in $ALLC; do
  [ "$c" = "$AG" ] && continue
  s=$(RUNSC state "$c" 2>/dev/null) || continue
  sbid=$(printf '%s' "$s" | ann_field io.kubernetes.cri.sandbox-id)
  ct=$(printf '%s' "$s" | ann_field io.kubernetes.cri.container-type)
  cn=$(printf '%s' "$s" | ann_field io.kubernetes.cri.container-name)
  [ "$sbid" = "$SB" ] && [ "$ct" = "container" ] && [ -n "$cn" ] || continue
  SUBC_LIST="$SUBC_LIST
$cn|$c"
done
printf '%s\n' "$SUBC_LIST" | while IFS= read -r e; do [ -n "$e" ] && echo "FT_SUBC=$e"; done
# DSTN_LIST is the bundle subdir per container: sandbox + each sub-container name.
DSTN_LIST=$(printf 'sandbox\n%s\n' "$SUBC_LIST" | sed 's/|.*//')

# [2/8] CONSISTENT-SNAPSHOT WINDOW (ka-0000004656, decision ka-0000003069:
# fix_tmp_consistency / fix dir A): pause the sentry, take the 9p-gofer warm copies
# WHILE the guest is quiesced, checkpoint the SAME paused VFS, then resume.
#
# THE TOCTOU THIS CLOSES. The prior code took the /tmp + /work + .gofer warm copies
# AFTER a bare 'runsc checkpoint --leave-running' had already RESUMED the sentry, so
# a live Claude session kept mutating the host-side 9p gofer trees (creating then
# unlinking /tmp/claude-1000/<sess>/tasks/<id>.output once per tool call) in the gap
# between the checkpoint's VFS capture and the cp. The checkpoint then referenced a
# transient dentry the later cp no longer saw -> thaw vfs.CompleteRestore() 9p walk
# ENOENTs on it -> agent sub rc=128. A QUIESCENT canary masked the defect (no churn
# => copy==dump => false-positive rc=0); an ACTIVE-Claude canary reproduced it.
#
# THE FIX. Bracket BOTH the gofer copies AND the checkpoint save inside ONE external
# 'runsc pause'..'runsc resume' window. gVisor Kernel.Pause/Unpause are
# reference-counted (BeginExternalStop/EndExternalStop, source-verified against the
# deployed release-20260525.0): our external pause NESTS with the save path's own
# balanced k.Pause()/defer k.Unpause(), and --leave-running's post-save
# BeforeResume does NOT clear our external stop — so the guest executes ZERO
# instructions from our pause through our resume. The warm copy and the checkpoint
# dentry set are therefore byte-identical. Container.Checkpoint explicitly accepts a
# Paused input (requireStatus(Created,Running,Paused)), and runsc Kernel.Pause
# drains in-flight 9p ops (runningGoroutines/aioGoroutines Wait) before returning,
# so the host-side gofer tree is fully quiescent before we copy. Only the cheap
# gofer trees ride inside the window; the 3.0G rootfs relocation stays AFTER resume
# (step [3/8]) — it is an overlay source, not a churning 9p gofer mount, and keeping
# it out of the window avoids extending agent downtime (decision: "...before
# relocation"). bundle_dir() is defined here (was step [3/8]) because the warm-copy
# resolvers below need the agent OCI spec before the pause.
bundle_dir() { RUNSC state "$1" 2>/dev/null | python3 -c 'import sys,json;print(json.load(sys.stdin).get("bundle",""))' 2>/dev/null; }
# Init the bundle root ONCE here (host ns, ka-0000002536). Step [3/8] no longer
# wipes $BUNDLE — the gofer warm copies below land in it BEFORE the relocation, so a
# second rm -rf there would delete them.
HMNT rm -rf "$BUNDLE" && HMNT mkdir -p "$BUNDLE"
# Capture the AGENT OCI config early (before the pause): the /work, /tmp, and
# data-driven .gofer warm-copy resolvers all parse "$BUNDLE/agent/config.json" for
# their host mount sources, and they must run inside the quiescent window. Resolve
# the OCI bundle dir from runsc state, fall back to the v2 task dir; HOST-ns (HMNT)
# so it lands where thaw reads. Step [3/8] re-copies it idempotently per-container.
HMNT mkdir -p "$BUNDLE/agent"
AGCFG=""
for cand in "$(bundle_dir "$AG")" "$T/$AG"; do
  [ -n "$cand" ] || continue
  if HMNT test -f "$cand/config.json"; then AGCFG="$cand/config.json"; break; fi
done
if [ -n "$AGCFG" ]; then HMNT cp -a "$AGCFG" "$BUNDLE/agent/config.json" || log "WARN early agent config.json capture failed (cid=$AG)"; else log "WARN no agent config.json found early (cid=$AG); gofer warm copies may no-op"; fi

# Enter the quiescent window. A trap resumes the sentry on ANY exit path (checkpoint
# failure, error, or a SIGTERM from an aborted exec) — a sandbox left
# externally-paused would hang the pod. SIGKILL cannot be trapped, but that path is
# covered: with no thaw target persisted the lifecycle cold-starts and deletes Pod A
# (destroying the sandbox), so an unresumed pause is reaped, never eternal.
PAUSED=0
resume_sb() { if [ "$PAUSED" = 1 ]; then RUNSC resume "$SB" 2>/dev/null; PAUSED=0; fi; }
trap 'resume_sb' EXIT INT TERM
RUNSC pause "$SB"; PRC=$?
echo "FT_PAUSE_RC=$PRC"
if [ "$PRC" = 0 ]; then
  PAUSED=1
else
  # Pause failed: the sentry is still running normally (pause is all-or-nothing).
  # Degrade to the pre-fix non-atomic copy rather than abort — the snapshot is no
  # worse than before this fix (a churny agent keeps its old rc=128 risk; a
  # quiescent one still thaws clean), and a lost freeze is strictly worse.
  log "WARN runsc pause rc=$PRC; proceeding UNPAUSED (non-atomic gofer copy, pre-fix behavior)"
fi

# --- 9p-gofer warm copies (CONSISTENCY-CRITICAL; taken inside the pause window) ---
# preserve the GC'able warm /work + projected SA token so thaw can repoint the
# agent bundle at node-local copies (the GC-of-kubelet-bindings problem itself is
# defeated by the placeholder Pod B; here we keep A's warm data alive node-locally).
#
# COW WORKSPACE PAYLOAD (ka-0000005425). These warm copies (/work below, /tmp next,
# and the data-driven .gofer sweep further down) run INSIDE the pause window and so
# are billed against the whole-freeze FreezeHardDeadline (bare-agent default 240s =
# runscTimeout 120s + a 2-container relocation copy budget; the computed cap now
# SCALES up per always-on sidecar so multi-sidecar agents are not starved of copy
# headroom — ka-0000007927). /work is a repo checkout — the SAME codebase measured a
# single clone at ~170s (71% of the bare-agent cap), so a repo-heavy freeze can hit
# the fail-closed deadline and cold-start despite being thawable. The rootfs
# relocation already reflinks (ka-0000002239); the workspace payload did not. Add
# --reflink=auto so on a CoW node fs (overlayfs upperdir on XFS/Btrfs/bcachefs) the
# clone becomes an O(metadata) extent share instead of a full byte copy — speeding
# healthy freezes AND widening headroom under the cap. Like the relocation copy this
# is STRICTLY no-worse: --reflink=auto degrades transparently to a full byte copy on
# any fs that cannot reflink (ext4/9p/tmpfs), and a reflink is an INDEPENDENT inode
# that survives source deletion, so the GC-safety invariant is preserved. -aL already
# preserves attrs + dereferences the top-level source symlink; --reflink=auto only
# changes HOW the data blocks land.
# Read the (host-ns) agent config.json and copy /work in the host ns too.
WORKSRC=$(HMNT python3 -c 'import json;print([m["source"] for m in json.load(open("'"$BUNDLE"'/agent/config.json"))["mounts"] if m["destination"]=="/work"][0])' 2>/dev/null || true)
# FT_WORK_FSTYPE (ka-0000006167): the .work COPY DESTINATION's fs type, mirroring the
# relocation's FT_RELOC_FSTYPE_<dstn>. xfs(reflink=1)/btrfs/bcachefs support CoW clones
# so --reflink=auto shares extents; ext4/9p/tmpfs cannot and it fell back to a full byte
# copy. A reflink also requires src+dst on the SAME fs, so the destination type is the
# load-bearing signal. Best-effort/diagnostic — never gates the freeze; emitted whenever
# a /work copy was attempted so the C3 re-baseline has a per-mount CoW-capability read.
#
# FT_WORK_CP_RC (PAYLOAD-COMPLETENESS SENTINEL, ka-0000000276). The /work cp ran with
# a 2>/dev/null redirect and NO exit-status check: a mid-copy ENOSPC/EIO silently
# published an INCOMPLETE .work payload marked usable. It fails closed at THAW (the fresh
# emptyDir lacks the warm data -> cold-start), so it is an integrity/wasted-freeze issue,
# not an availability one — but pre-fleet-default-on it emitted ZERO signal. Capture the
# cp rc (the $? of the cp itself, isolated from the rm and the stat that follow) and emit
# it so the Go side can WARN into canary + fleet telemetry (see freezethaw.go workCP
# handling). This is a WARN, not a freeze-gate, DELIBERATELY: cp -aL DEREFERENCES symlinks,
# and a real /work repo checkout routinely carries dangling links (a stale node_modules/.bin
# entry, a deleted-target link) that make cp exit non-zero with NO data-integrity loss — a
# hard gate would spuriously cold-start thawable agents fleet-wide, the opposite of
# hardening. Same fail-closed-at-thaw safety and not-gating rationale the sibling
# FT_PAUSE_RC fix (ka-0000006783) landed. rc=0 clean; non-zero surfaces the incomplete copy.
if [ -n "$WORKSRC" ]; then
  HMNT rm -rf "$BUNDLE/.work"
  HMNT cp -aL --reflink=auto "$WORKSRC" "$BUNDLE/.work" 2>/dev/null; WORK_CP_RC=$?
  echo "FT_WORK_CP_RC=$WORK_CP_RC"
  # FT_WORK_CP_REASON (payload-completeness DE-NOISE, ka-0000006933). A non-zero
  # cp -aL rc is dominated by BENIGN dangling symlinks in a real /work repo
  # checkout; classify the rc so the Go side WARNs/alerts only on a GENUINE
  # truncating failure (copyfail), not on symlink noise. rc==0 short-circuits to
  # "clean" (no probe cost on healthy freezes). Own line so a truncated stream
  # never bleeds this into another sentinel; the Go side parses it exact-match
  # and any absent/partial value on an rc!=0 leg stays "incomplete" (never a
  # false-clean). Older-node back-compat: absent => Go falls back to the rc rule.
  if [ "$WORK_CP_RC" -eq 0 ]; then WORK_CP_REASON=clean; else WORK_CP_REASON=$(ftClassifyCopyRC "$WORKSRC" "$BUNDLE/.work"); fi
  echo "FT_WORK_CP_REASON=$WORK_CP_REASON"
  [ "$WORK_CP_REASON" = copyfail ] && log "WARN /work payload copy rc=$WORK_CP_RC reason=$WORK_CP_REASON (src=$WORKSRC) — .work may be INCOMPLETE; thaw will cold-start on the missing warm data"
  wfs=$(HMNT stat -f -c %T "$BUNDLE/.work" 2>/dev/null); echo "FT_WORK_FSTYPE=${wfs:-unknown}"
fi

# PRESERVE the agent /tmp gofer tree (ka-0000001085, decision ka-0000002555:
# fix_tmp_preserve). /tmp is an EmptyDir bind-mounted into the agent as a 9p gofer
# mount (NOT sandbox-internal tmpfs — confirmed live: rfdno=… directfs), so its
# dir tree NEVER rides the checkpoint image's VFS state. Files created under /tmp
# at RUNTIME — notably /tmp/claude-1000, the Claude Code per-uid session tempdir
# created after pod start — live only in Pod A's live gofer host-side tree. At
# thaw the kubelet re-provisions a FRESH empty /tmp EmptyDir for Pod B, so the
# restored sentry's vfs.CompleteRestore() 9p walk for "claude-1000" in mount
# "agent:/tmp" ENOENTs -> agent sub rc=128 (root restores clean / ROOT_RC=0
# because the pause sandbox has no live 9p /tmp tree — exactly the observed
