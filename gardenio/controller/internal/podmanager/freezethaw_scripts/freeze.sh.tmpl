# The 3.0G checkpoint image is the OTHER deletion vector: it is NOT snapshot-
# carried (too large for the fix-B base64 shape), so thaw reads it from $IMG on
# the node. Assert it is present + non-empty AT the controller-owned safe path,
# IN THE HOST NS (HMNT test -s) so the guard inspects the same /var/lib/gardenio/
# ckpt that runsc wrote and thaw reads — not a probe-ns view. Emit FT_IMAGE_OK so
# the Go post-state check refuses to persist a snapshot whose image is absent /
# empty / un-relocated. Because the snapshot is what the lifecycle's Pod-A
# DeleteAgentPod waits on, FT_IMAGE_OK=no means Pod A is NOT torn down behind an
# image thaw could never restore from.
# HMNTT-bounded (bug ka-0000004931): this is the LAST read-only image probe and
# the one that gates snapshot persistence (FT_IMAGE_OK). A wedged host-ns test -s
# here previously hung the whole freeze exec AFTER the checkpoint succeeded,
# truncating the stream so the Go side saw neither FT_IMAGE_OK nor a clean exit —
# the snapshot_persisted rung then misclassified a hang as image-absent. Bounding
# it makes a wedge fail-fast into IMAGE_OK=no, which the Go post-state check
# already fail-closes on (refuse to persist an un-thawable snapshot; Pod A stays
# live; cold-start next spawn) — the correct, classifiable outcome.
if HMNTT test -s "$IMG/checkpoint.img"; then IMAGE_OK=yes; else IMAGE_OK=no; log "IMAGE MISSING: $IMG/checkpoint.img absent or empty at controller-owned safe path"; fi
echo "FT_IMAGE_OK=$IMAGE_OK"

# [3c/8] CAPTURE the spec files into the snapshot (fix B, ka-0000000301). The host
# OCI bundle dir ($BUNDLE = BundleHostBase/<agent> = /var/lib/gardenio/bundle/<agent>;
# formerly /var/tmp/gb-bundle/<agent> pre-ka-0000003702) could be reaped before thaw
# — the original vector was Pod A's post-freeze teardown GC'ing the then-/var/tmp
# bundle dir (containerd 'runsc delete' reaps the per-container bundle dir) while the
# standalone checkpoint image survives — so thaw FetchSpec-ENOENTs (rc=128) on
# config.json even though FT_BUNDLE_OK=yes proved it existed AT FREEZE. Emit the
# small spec files (config.json + .overlay-opts for sandbox AND every
# sub-container) as repeated single-line FT_SPEC sentinels carrying
# "<bundle-rel-path>|<base64>" so the controller persists them in the snapshot
# and re-materializes the bundle at thaw start, making thaw independent of the
# host bundle dir surviving. Read in the HOST ns (HMNT) so we capture what thaw
# reads. rootfs (the large overlay) is NOT captured — thaw rebuilds it from
# .overlay-opts. The count of FT_SPEC lines scales with the container count.
emit_spec() { # $1=bundle-relative path
  local b64
  b64=$(HMNT base64 -w0 "$BUNDLE/$1" 2>/dev/null) || { log "WARN capture $1 failed"; return; }
  echo "FT_SPEC=$1|$b64"
}
for dstn in $DSTN_LIST; do
  emit_spec "$dstn/config.json"
  emit_spec "$dstn/.overlay-opts"
done

# NOTE: the 9p-gofer warm copies (.work / .tmp / .gofer) are NO LONGER taken here.
# They moved UP into step [2/8]'s pause window (ka-0000004656, decision
# ka-0000003069: fix_tmp_consistency) so they snapshot the SAME quiesced VFS the
# checkpoint captured — eliminating the live-Claude TOCTOU that ENOENT'd the thaw
# 9p walk (rc=128). Taking them post-resume here (the old location) is exactly the
# race that was fixed. Everything below this point operates on already-captured
# bundle artifacts and is unaffected by the move.
log "freeze complete: sandbox=$SB agent=$AG count=$CCOUNT image=$IMG"
