{
  "context": {
    "fileName": [
      "GEMINI.md",
      "CLAUDE.md"
    ]
  },
  "general": {
    "enableAutoUpdate": false,
    "enableAutoUpdateNotification": false
  },
  "hooks": {
    "AfterAgent": [
      {
        "hooks": [
          {
            "command": "gb hook stop-gate --format gemini",
            "type": "command"
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "hooks": [
          {
            "command": "gb hook relay 2>/dev/null || true",
            "type": "command"
          }
        ]
      }
    ],
    "BeforeTool": [
      {
        "hooks": [
          {
            "command": "gb hook relay 2>/dev/null || true",
            "type": "command"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "command": "gb hook relay 2>/dev/null || true",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "gb hook relay 2>/dev/null || true",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "gb workspace audit 2>/dev/null || true",
            "type": "command"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "docs": {
      "headers": {
        "Authorization": "Bearer docs-456",
        "X-Team": "gardenio"
      },
      "httpUrl": "https://mcp.example.com/mcp",
      "trust": true
    },
    "legacy-sse": {
      "trust": true,
      "url": "https://old.example.com/sse"
    },
    "playwright": {
      "args": [
        "--browser",
        "chromium",
        "--headless"
      ],
      "command": "playwright-mcp",
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": "/ms-playwright",
        "TOKEN": "tok-123"
      },
      "trust": true
    }
  },
  "model": {
    "maxSessionTurns": 50,
    "name": "gemini-2.5-pro"
  },
  "privacy": {
    "usageStatisticsEnabled": false
  },
  "security": {
    "auth": {
      "selectedType": "gemini-api-key"
    }
  },
  "ui": {
    "hideBanner": true
  }
}
