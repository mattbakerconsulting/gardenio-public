#!/bin/bash
# cloud-init user-data for the Gas City HQ host: drop the pins and the
# bootstrap script, then run it once. Re-runs happen via SSM (see the script).
set -uo pipefail
mkdir -p /etc/hq /var/lib/hq
cat > /etc/hq/pins.env <<'EOF'
ENV_NAME=${env_name}
GC_USER=${gc_user}
GO_VERSION=${go_version}
NODE_MAJOR=${node_major}
DOLT_VERSION=${dolt_version}
BD_VERSION=${bd_version}
GC_COMMIT=${gc_commit}
GC_REPO_URL=${gc_repo_url}
ZITI_TUNNEL_VERSION=${ziti_tunnel_version}
ZITI_IDENTITY_NAME=${ziti_identity_name}
EOF
chmod 0644 /etc/hq/pins.env
cat > /usr/local/sbin/hq-bootstrap <<'HQ_BOOTSTRAP_EOF'
${bootstrap_script}
HQ_BOOTSTRAP_EOF
chmod 0755 /usr/local/sbin/hq-bootstrap
/usr/local/sbin/hq-bootstrap all
