{
  "_metadata": {
    "major_version": 1,
    "minor_version": 7
  },
  "display_information": {
    "name": "gardenio",
    "description": "Agent control plane for gardenio — beads, decisions, spawn",
    "background_color": "#1b2733"
  },
  "features": {
    "app_home": {
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false
    },
    "bot_user": {
      "display_name": "gardenio",
      "always_online": true
    },
    "agent_view": {
      "agent_description": "Agent control plane for gardenio — spawn agents, check the roster, and resolve pending decisions right from a DM.",
      "suggested_prompts": []
    },
    "unfurl_domains": [
      "gardenio.clonk.tv"
    ],
    "slash_commands": [
      {
        "command": "/decisions",
        "description": "Show pending decisions waiting for a response",
        "usage_hint": "[agent]",
        "should_escape": false
      },
      {
        "command": "/decide",
        "description": "Alias for /decisions",
        "usage_hint": "[agent]",
        "should_escape": false
      },
      {
        "command": "/roster",
        "description": "Show the active agent roster",
        "usage_hint": "[project]",
        "should_escape": false
      },
      {
        "command": "/runner",
        "description": "Invite, revoke, or list laptop runners",
        "usage_hint": "invite @person project... | revoke <hostname> | status",
        "should_escape": true
      },
      {
        "command": "/spawn",
        "description": "Spawn a new agent (auto-named, project from channel)",
        "usage_hint": "[task] [--role <role>]",
        "should_escape": false
      },
      {
        "command": "/start",
        "description": "Start a named agent",
        "usage_hint": "<agent> [project] [task] [--role <role>]",
        "should_escape": false
      },
      {
        "command": "/kill",
        "description": "Terminate a running agent",
        "usage_hint": "<agent> [--force]",
        "should_escape": false
      },
      {
        "command": "/unreleased",
        "description": "Show unreleased changes across tracked repos",
        "usage_hint": "[repo]",
        "should_escape": false
      },
      {
        "command": "/clear-threads",
        "description": "Clear all thread-to-agent mappings",
        "should_escape": false
      },
      {
        "command": "/bouncer",
        "description": "Manage IP whitelist for Traefik middlewares",
        "usage_hint": "list | add <ip> | remove <ip>",
        "should_escape": false
      },
      {
        "command": "/autodestruct",
        "description": "Kill all agent pods (with confirmation) or check status",
        "usage_hint": "[clear | status]",
        "should_escape": false
      },
      {
        "command": "/formula",
        "description": "List, inspect, and instantiate formulas",
        "usage_hint": "list | show <id> | pour <id> [--var key=value] | wisp <id> [--var key=value]",
        "should_escape": false
      },
      {
        "command": "/schedule",
        "description": "Manage scheduler: global pause/resume, per-project enable/disable, show status",
        "usage_hint": "[on | off] [project]",
        "should_escape": false
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "chat:write",
        "assistant:write",
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "channels:manage",
        "commands",
        "groups:history",
        "groups:read",
        "groups:write",
        "im:history",
        "im:write",
        "mpim:history",
        "mpim:read",
        "mpim:write",
        "pins:read",
        "pins:write",
        "users:read",
        "users:read.email",
        "files:read",
        "files:write",
        "links:read",
        "links:write",
        "reactions:read",
        "reactions:write",
        "canvases:read",
        "canvases:write"
      ],
      "user": [
        "channels:history",
        "channels:read",
        "channels:write",
        "channels:write.invites",
        "chat:write",
        "groups:history",
        "groups:read",
        "groups:write",
        "im:history",
        "im:read",
        "im:write",
        "mpim:history",
        "mpim:read",
        "mpim:write",
        "files:read",
        "files:write",
        "search:read",
        "users:read",
        "users:read.email",
        "users.profile:read",
        "users.profile:write",
        "reactions:read",
        "reactions:write",
        "pins:read",
        "pins:write",
        "stars:read",
        "stars:write",
        "bookmarks:read",
        "bookmarks:write",
        "reminders:read",
        "reminders:write",
        "usergroups:read",
        "usergroups:write",
        "dnd:read",
        "dnd:write",
        "emoji:read",
        "team:read",
        "links:read",
        "links:write",
        "canvases:read",
        "canvases:write"
      ]
    }
  },
  "settings": {
    "socket_mode_enabled": true,
    "token_rotation_enabled": false,
    "interactivity": {
      "is_enabled": true
    },
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "app_home_opened",
        "app_context_changed",
        "message.channels",
        "message.groups",
        "message.im",
        "message.mpim",
        "member_joined_channel",
        "reaction_added",
        "link_shared"
      ]
    }
  }
}
