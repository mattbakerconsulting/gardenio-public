{
  "name": "beads-viewer-screenshots",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Playwright harness that captures canonical beads-viewer pages at pinned viewports for MR before/after review.",
  "scripts": {
    "test": "playwright test",
    "test:update": "playwright test --update-snapshots",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report test-results/beads-viewer-screenshots-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
}
