#!/usr/bin/env bash
# Pre-commit hook: run gitleaks against the staged diff.
#
# Install: `make hooks` (or `./scripts/install-hooks.sh`).
# Skip:    `SKIP_GITLEAKS=1 git commit ...` (emergency bypass only).
set -euo pipefail

if [[ "${SKIP_GITLEAKS:-}" == "1" ]]; then
  echo "pre-commit: SKIP_GITLEAKS=1 set, skipping gitleaks scan" >&2
  exit 0
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  cat >&2 <<'EOF'
pre-commit: gitleaks not found on PATH.

Install one of:
  brew install gitleaks
  go install github.com/gitleaks/gitleaks/v8@latest
  # or download a binary from https://github.com/gitleaks/gitleaks/releases

To bypass (not recommended): SKIP_GITLEAKS=1 git commit ...
EOF
  exit 1
fi

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# `protect --staged` scans only the staged diff, which is what we want for a
# pre-commit hook. --redact hides matched values from hook output.
gitleaks protect \
  --staged \
  --redact \
  --no-banner \
  --config .gitleaks.toml \
  --exit-code 1
