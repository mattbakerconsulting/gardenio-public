{
  "edge_ip_from": "auth.clonk.tv",
  "edge_hosts": ["auth.clonk.tv", "claimlayer.clonk.tv", "grafana.clonk.tv", "dashboard.clonk.tv", "gardenio.clonk.tv", "mux.clonk.tv", "api.clonk.tv", "hooks.clonk.tv", "runners.clonk.tv", "clonk.tv", "www.clonk.tv"],
  "non_http_hosts": [],
  "non_http_hosts_note": "Names on the edge EIP that are not nginx vhosts (nginx refusing their SNI on 443 is the PASS). Empty since ziti was switched off (S9c, gd-xNMLrsgajy): ziti.clonk.tv, the ziti public router, was the only one.",
  "exceptions": {
    "auth.clonk.tv": {
      "/": 404,
      "/auth/realms/gardenio/.well-known/openid-configuration": 200
    },
    "api.clonk.tv": {
      "/": 404,
      "/health": 401
    },
    "hooks.clonk.tv": {
      "/": 404,
      "/webhooks/edge-probe": 403,
      "/webhook": 403
    },
    "runners.clonk.tv": {
      "/": 404,
      "/v1/beads": 404
    },
    "clonk.tv": {
      "/": 200,
      "/lands/": 404
    },
    "www.clonk.tv": {
      "/": 301
    }
  },
  "canary_url": "https://auth.clonk.tv/__edge_canary",
  "ziti_public_router": false,
  "api_host_live": true,
  "scoped_identity_live": false,
  "scoped_identity": {
    "viewer_host": "gardenio.clonk.tv",
    "mux_host": "mux.clonk.tv",
    "auth_path": "/oauth2/auth",
    "scoped_cookie_env": "EDGE_PROBE_SCOPED_COOKIE",
    "admin_cookie_env": "EDGE_PROBE_ADMIN_COOKIE"
  }
}
