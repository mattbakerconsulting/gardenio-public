{
  "scenario": "release_deployed",
  "about": "A release is what one tag of the land's repository carries and where it runs. One deployed nowhere is cut; when the land's owner reports it running on a target it is live there, and the release that ran there before is superseded, its row on that target closed. Only pull requests are listed: a direct commit in the tag's history is not one.",
  "given": [
    "first: a release of the land, tag v2.0.0, cut on 20 October, carrying one pull request, reported running on prod (revision 7, by orchard-deploy) since 10:00 that day.",
    "second: a release of the land, tag v2.1.0, cut on 24 October, carrying two pull requests and one direct commit, running nowhere.",
    "The land declares one target, prod, of kind land."
  ],
  "steps": [
    {
      "say": "A release running nowhere is cut, and lists its two pull requests but not the direct commit.",
      "call": "GET /releases/v2.1.0",
      "status": 200,
      "schema": "Release",
      "match": "exact",
      "answer": {
        "id": "or-Rel0000002",
        "tag": "v2.1.0",
        "status": "cut",
        "sha": "4b825dc642cb6eb9a060e54bf8d69288fbee4904",
        "cut_at": "2026-10-24T09:00:00Z",
        "contents": [
          {
            "pr": 12,
            "title": "Show the autumn banner",
            "url": "https://github.com/orchard/shop/pull/12"
          },
          {
            "pr": 13,
            "title": "Fix the price label",
            "url": "https://github.com/orchard/shop/pull/13"
          }
        ],
        "deployments": []
      },
      "bind": {
        "/id": "second"
      }
    },
    {
      "say": "The land's releases list it.",
      "call": "GET /releases?limit=200",
      "status": 200,
      "schema": "Release",
      "match": "listed",
      "answer": {
        "id": "or-Rel0000002",
        "tag": "v2.1.0",
        "status": "cut",
        "sha": "4b825dc642cb6eb9a060e54bf8d69288fbee4904",
        "cut_at": "2026-10-24T09:00:00Z",
        "contents": [
          {
            "pr": 12,
            "title": "Show the autumn banner",
            "url": "https://github.com/orchard/shop/pull/12"
          },
          {
            "pr": 13,
            "title": "Fix the price label",
            "url": "https://github.com/orchard/shop/pull/13"
          }
        ],
        "deployments": []
      },
      "bind": {
        "/id": "second"
      }
    },
    {
      "say": "The release reported on prod is live there, its row open.",
      "call": "GET /releases/{first}",
      "status": 200,
      "schema": "Release",
      "match": "exact",
      "answer": {
        "id": "or-Rel0000001",
        "tag": "v2.0.0",
        "status": "live",
        "sha": "4b825dc642cb6eb9a060e54bf8d69288fbee4904",
        "cut_at": "2026-10-20T09:00:00Z",
        "contents": [
          {
            "pr": 11,
            "title": "Build the first shelf",
            "url": "https://github.com/orchard/shop/pull/11"
          }
        ],
        "deployments": [
          {
            "target": "prod",
            "kind": "land",
            "since": "2026-10-20T10:00:00Z",
            "by": "orchard-deploy",
            "revision": "7"
          }
        ]
      },
      "bind": {
        "/id": "first"
      }
    },
    {
      "say": "The land's owner reports the new release running on prod; it is live, its row open.",
      "when": "the land's owner reports second running on prod",
      "call": "GET /releases/{second}",
      "status": 200,
      "schema": "Release",
      "match": "exact",
      "answer": {
        "id": "or-Rel0000002",
        "tag": "v2.1.0",
        "status": "live",
        "sha": "4b825dc642cb6eb9a060e54bf8d69288fbee4904",
        "cut_at": "2026-10-24T09:00:00Z",
        "contents": [
          {
            "pr": 12,
            "title": "Show the autumn banner",
            "url": "https://github.com/orchard/shop/pull/12"
          },
          {
            "pr": 13,
            "title": "Fix the price label",
            "url": "https://github.com/orchard/shop/pull/13"
          }
        ],
        "deployments": [
          {
            "target": "prod",
            "kind": "land",
            "since": "2026-10-24T09:30:00Z",
            "by": "owner",
            "revision": "8"
          }
        ]
      },
      "bind": {
        "/id": "second"
      },
      "any": [
        "/deployments/0/since",
        "/deployments/0/by"
      ]
    },
    {
      "say": "The release that ran on prod before is superseded, its row there closed.",
      "call": "GET /releases/{first}",
      "status": 200,
      "schema": "Release",
      "match": "exact",
      "answer": {
        "id": "or-Rel0000001",
        "tag": "v2.0.0",
        "status": "superseded",
        "sha": "4b825dc642cb6eb9a060e54bf8d69288fbee4904",
        "cut_at": "2026-10-20T09:00:00Z",
        "contents": [
          {
            "pr": 11,
            "title": "Build the first shelf",
            "url": "https://github.com/orchard/shop/pull/11"
          }
        ],
        "deployments": [
          {
            "target": "prod",
            "kind": "land",
            "since": "2026-10-20T10:00:00Z",
            "by": "orchard-deploy",
            "revision": "7",
            "until": "2026-10-24T09:30:00Z"
          }
        ]
      },
      "bind": {
        "/id": "first"
      },
      "any": [
        "/deployments/0/until"
      ]
    }
  ]
}
