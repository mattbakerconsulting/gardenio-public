{
  "scenario": "crew_after_rename",
  "about": "The crew list is the land's people, never empty with a 200. A person keeps their member id when they are renamed or their role in the land changes, the list shows the new name, and signing in again does not undo it.",
  "given": [
    "member: the land's member, who signs in to the land with the land's members group.",
    "sam: a second person, sam@<land>.example, who has not signed in yet."
  ],
  "steps": [
    {
      "say": "The land's member is on its crew.",
      "call": "GET /crew?limit=200",
      "status": 200,
      "schema": "Member",
      "match": "listed",
      "answer": {
        "id": "or-Mbr0000001",
        "name": "member",
        "role": "member",
        "status": "active"
      },
      "bind": {
        "/id": "member"
      }
    },
    {
      "say": "Sam signs in through the land's owners group and joins the crew as an owner, named for their address.",
      "when": "sam signs in as an owner",
      "call": "GET /crew?limit=200",
      "status": 200,
      "schema": "Member",
      "match": "listed",
      "answer": {
        "id": "or-Mbr0000002",
        "name": "sam",
        "role": "owner",
        "status": "active"
      },
      "bind": {
        "/id": "sam"
      }
    },
    {
      "say": "Sam is renamed. The crew shows the new name under the same id and role.",
      "when": "sam is renamed Sam Rowan",
      "call": "GET /crew/{sam}",
      "status": 200,
      "schema": "Member",
      "match": "exact",
      "answer": {
        "id": "or-Mbr0000002",
        "name": "Sam Rowan",
        "role": "owner",
        "status": "active"
      },
      "bind": {
        "/id": "sam"
      }
    },
    {
      "say": "The list agrees.",
      "call": "GET /crew?limit=200",
      "status": 200,
      "schema": "Member",
      "match": "listed",
      "answer": {
        "id": "or-Mbr0000002",
        "name": "Sam Rowan",
        "role": "owner",
        "status": "active"
      },
      "bind": {
        "/id": "sam"
      }
    },
    {
      "say": "Sam signs in again through the members group: the role follows, the name stays, the id holds.",
      "when": "sam signs in as a member",
      "call": "GET /crew/{sam}",
      "status": 200,
      "schema": "Member",
      "match": "exact",
      "answer": {
        "id": "or-Mbr0000002",
        "name": "Sam Rowan",
        "role": "member",
        "status": "active"
      },
      "bind": {
        "/id": "sam"
      }
    },
    {
      "say": "The land's member is still there, unchanged.",
      "call": "GET /crew/{member}",
      "status": 200,
      "schema": "Member",
      "match": "exact",
      "answer": {
        "id": "or-Mbr0000001",
        "name": "member",
        "role": "member",
        "status": "active"
      },
      "bind": {
        "/id": "member"
      }
    }
  ]
}
