{
  "_comment": "Shared table for kbeads (internal/server/role_list_test.go) and the controller (cmd/controller/rolelist_test.go): an agent's `role` string parses to the same ordered element list on both sides. Split on commas, trim whitespace, drop empty elements.",
  "cases": [
    {"role": "",                   "want": []},
    {"role": "   ",                "want": []},
    {"role": "crew",               "want": ["crew"]},
    {"role": "crew,reviewer",      "want": ["crew", "reviewer"]},
    {"role": "crew, reviewer",     "want": ["crew", "reviewer"]},
    {"role": " infra",             "want": ["infra"]},
    {"role": "infra ",             "want": ["infra"]},
    {"role": "x,infra",            "want": ["x", "infra"]},
    {"role": "crew,infra",         "want": ["crew", "infra"]},
    {"role": " crew , infra ",     "want": ["crew", "infra"]},
    {"role": "crew,,infra",        "want": ["crew", "infra"]},
    {"role": ",infra,",            "want": ["infra"]},
    {"role": "infra,infra",        "want": ["infra", "infra"]},
    {"role": "Infra",              "want": ["Infra"]},
    {"role": "crew\t,\tinfra\n",   "want": ["crew", "infra"]},
    {"role": "\u00a0infra",        "want": ["infra"]},
    {"role": "infra\u2003",        "want": ["infra"]},
    {"role": "\u0085infra\u3000", "want": ["infra"]},
    {"role": "\u200binfra",        "want": ["\u200binfra"]},
    {"role": "infra\u200b",        "want": ["infra\u200b"]},
    {"role": "crew,\ufeffinfra",   "want": ["crew", "\ufeffinfra"]},
    {"role": "crew\uff0cinfra",    "want": ["crew\uff0cinfra"]},
    {"role": "\u0456nfra",         "want": ["\u0456nfra"]}
  ]
}
