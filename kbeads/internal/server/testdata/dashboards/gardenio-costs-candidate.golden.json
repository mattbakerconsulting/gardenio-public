      "targets": [
        {
          "expr": "topk(8, sum by(agent)(last_over_time((max by (agent, project, role, model, account) (gardenio_agent_spend_logs_usd{}))[15m:5m])))",
          "legendFormat": "{{ agent }}",
          "refId": "A"
