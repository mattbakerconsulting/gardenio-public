    {
      "id": 3,
      "type": "timeseries",
      "title": "Per-agent cost over time",
      "description": "cumulative real-bill USD, top 8 agents",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "axisPlacement": "left",
            "axisLabel": "USD",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": null
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
