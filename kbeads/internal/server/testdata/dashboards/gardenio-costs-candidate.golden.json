{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Cost per agent-hour",
      "description": "USD per hour per producing agent, 1h + 24h rolling",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "axisPlacement": "left",
            "axisLabel": "USD / agent-hour"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "agents (1h avg)"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "custom.axisLabel",
                "value": "agents"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum(increase((max by (account, env) (gardenio_account_cost_usd{account!~\"(?i:e2e-.*|probe-acct-.*)\"}))[1h:5m])) / 1 / (avg_over_time(sum(max by (project, role, state)(gardenio_agents_active{state!~\"prewarmed|idle|assigning|done|failed|exited|stopped\"}))[1h:5m]) > 0)",
          "legendFormat": "$/agent-hour (1h)",
          "refId": "A"
        },
        {
          "expr": "sum(increase((max by (account, env) (gardenio_account_cost_usd{account!~\"(?i:e2e-.*|probe-acct-.*)\"}))[24h:5m])) / 24 / (avg_over_time(sum(max by (project, role, state)(gardenio_agents_active{state!~\"prewarmed|idle|assigning|done|failed|exited|stopped\"}))[24h:5m]) > 0)",
          "legendFormat": "$/agent-hour (24h)",
          "refId": "B"
        },
        {
          "expr": "avg_over_time(sum(max by (project, role, state)(gardenio_agents_active{state!~\"prewarmed|idle|assigning|done|failed|exited|stopped\"}))[1h:5m])",
          "legendFormat": "agents (1h avg)",
          "refId": "C"
        }
      ]
    },
    {
