        {
          "expr": "sum(increase((max by (account, env) (gardenio_account_cost_usd{account!~\"(?i:e2e-.*|probe-acct-.*)\"}))[1h:5m])) / 1",
          "legendFormat": "spend (1h)",
          "refId": "B"
        },
        {
          "expr": "sum(increase((max by (account, env) (gardenio_account_cost_usd{account!~\"(?i:e2e-.*|probe-acct-.*)\"}))[1d:5m])) / 24 / (avg_over_time(sum(max by (project, role, state)(gardenio_agents_active{state!~\"prewarmed|idle|assigning|done|failed|exited|stopped\"}))[1d:5m]) > 0)",
          "legendFormat": "cost per agent",
          "refId": "C"
        },
        {
          "expr": "sum(increase((max by (account, env) (gardenio_account_cost_usd{account!~\"(?i:e2e-.*|probe-acct-.*)\"}))[1h:5m])) / 1 / (avg_over_time(sum(max by (project, role, state)(gardenio_agents_active{state!~\"prewarmed|idle|assigning|done|failed|exited|stopped\"}))[1h:5m]) > 0)",
          "legendFormat": "cost per agent (1h)",
          "refId": "D"
        },
        {
          "expr": "last_over_time(sum(gardenio_agents_active{state!~\"prewarmed|idle|assigning|done|failed|exited|stopped\"})[2m:30s])",
          "legendFormat": "active agents",
          "refId": "E"
        },
        {
          "expr": "avg_over_time(sum(max by (project, role, state)(gardenio_agents_active{state!~\"prewarmed|idle|assigning|done|failed|exited|stopped\"}))[1h:5m])",
          "legendFormat": "agents (1h avg)",
          "refId": "F"
        },
        {
          "expr": "avg_over_time(sum(max by (project, role, state)(gardenio_agents_active{state!~\"prewarmed|idle|assigning|done|failed|exited|stopped\"}))[24h:5m])",
          "legendFormat": "agents (24h avg)",
          "refId": "G"
        }
