    {
      "id": 1,
      "type": "timeseries",
      "title": "service request rate (perf, span-derived)",
      "description": "server spans/sec by service, $__interval buckets",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "axisPlacement": "left",
            "axisLabel": "server spans/sec"
          }
        },
        "overrides": null
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by(service_name)(rate(span_calls_total{source=\"perf\",span_kind=\"SPAN_KIND_SERVER\"}[$__interval]))",
          "legendFormat": "{{ service }}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "service error ratio (perf, span-derived)",
      "description": "STATUS_CODE_ERROR as fraction of server spans, $__interval buckets",
