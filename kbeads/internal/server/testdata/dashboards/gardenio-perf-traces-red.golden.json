        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by(service_name)(rate(span_calls_total{source=\"perf\",span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\"}[$__interval])) / (sum by(service_name)(rate(span_calls_total{source=\"perf\",span_kind=\"SPAN_KIND_SERVER\"}[$__interval])) > 0)",
          "legendFormat": "{{ service }}",
          "refId": "A"
